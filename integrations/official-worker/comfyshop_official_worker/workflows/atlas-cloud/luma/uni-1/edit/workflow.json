{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-luma-uni1-edit",
  "name": "Luma Uni 1 图片编辑",
  "description": "根据提示词修改一张图片，并设置成品宽高比和格式。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "Make the lighting warm and cinematic, add soft morning haze."
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "choices": ["1:1", "3:4", "4:3", "9:16", "16:9", "9:21", "21:9"],
      "optional": true,
      "default": "16:9"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "choices": ["jpeg", "png"],
      "optional": true,
      "default": "jpeg"
    },
    {
      "name": "input_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "input_image_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "input_image",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "input_image_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "luma/uni-1/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "aspect_ratio": "aspect_ratio",
        "output_format": "output_format"
      },
      "required_text": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["input_image"],
          "external_sources_field": "input_image_source",
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png", "image/webp", "image/gif"],
          "allow_raw_base64": true,
          "allow_asset_references": true
        }
      }
    }
  },
  "translations": {
