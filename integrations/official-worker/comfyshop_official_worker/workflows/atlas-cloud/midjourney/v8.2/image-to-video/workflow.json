{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-mj82-i2v",
  "name": "Midjourney V8.2 图生视频",
  "description": "把一张首帧图片生成 4 段 5 秒视频，保留原图宽高比。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "optional": true,
      "default": "gentle camera push in, cinematic"
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": ["480p", "720p"],
      "optional": true,
      "default": "480p"
    },
    {
      "name": "motion",
      "kind": "choice",
      "choices": ["low", "high"],
      "optional": true,
      "default": "low"
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "motion",
      "section": "default"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "midjourney/v8.2/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "motion": "motion",
        "enable_base64_output": "enable_base64_output"
      },
      "omit_blank_parameters": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "external_urls_only": true,
          "external_https_only": true
        }
      }
    }
  },
  "translations": {
