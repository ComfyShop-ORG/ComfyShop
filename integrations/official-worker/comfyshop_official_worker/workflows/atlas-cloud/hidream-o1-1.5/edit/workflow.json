{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-hidream-edit",
  "name": "HiDream O1 1.5 图片编辑",
  "description": "根据提示词编辑至少一张参考图，也可用多张图保持主体一致。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 2500
    },
    {
      "name": "size_preset",
      "kind": "choice",
      "choices": [
        "square_hd",
        "square",
        "portrait_4_3",
        "portrait_16_9",
        "landscape_4_3",
        "landscape_16_9"
      ],
      "optional": true,
      "default": "landscape_4_3"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "png",
      "choices": ["png", "jpeg", "webp"]
    },
    {
      "name": "num_inference_steps",
      "kind": "integer",
      "minimum": "1",
      "maximum": "50",
      "optional": true,
      "default": 50
    },
    {
      "name": "guidance_scale",
      "kind": "number",
      "minimum": "1",
      "maximum": "20",
      "optional": true,
      "default": 5
    },
    {
      "kind": "image",
      "name": "reference_image_1",
      "optional": true
    },
    {
      "kind": "image",
      "name": "reference_image_2",
      "optional": true
    },
    {
      "kind": "image",
      "name": "reference_image_3",
      "optional": true
    },
    {
      "kind": "image",
      "name": "reference_image_4",
      "optional": true
    },
    {
      "name": "image_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "reference_image_1",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size_preset",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "num_inference_steps",
      "section": "advanced"
    },
    {
      "fieldId": "guidance_scale",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_3",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_4",
      "section": "advanced"
    },
    {
      "fieldId": "image_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "hidream-o1-1.5/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "image_size": "size_preset",
        "output_format": "output_format",
        "num_inference_steps": "num_inference_steps",
        "guidance_scale": "guidance_scale"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 2500
      },
      "media": {
        "reference_image_urls": {
          "kind": "image",
          "fields": [
            "reference_image_1",
            "reference_image_2",
            "reference_image_3",
            "reference_image_4"
          ],
          "array": true,
          "external_sources_field": "image_sources",
          "allow_additional_sources": true,
          "external_urls_only": true,
          "min_items": 1
        }
      }
    }
  },
