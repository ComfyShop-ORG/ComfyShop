      "parameterLayout": {
        "prompt": {
          "help": "Describe the subject, scene, composition, and style. Put any exact text to render in quotation marks."
        },
        "aspect_ratio": {
          "help": "Auto generates a square image. Ultra-wide and ultra-tall ratios are also available."
        },
        "resolution": {
          "help": "Choose 1K, 2K, or 4K."
        },
        "thinking_level": {
          "help": "Higher levels give the model more time to reason about complex composition and text. The model defaults to medium."
        },
        "enable_web_search": {
          "help": "Use Google web search to provide up-to-date information for generation."
        },
        "enable_image_search": {
          "help": "Use Google Image Search as visual context. It can be enabled on its own."
        },
        "top_p": {
          "help": "The cumulative sampling probability threshold, from 0 to 1."
        },
        "temperature": {
          "help": "Controls sampling variation, from 0 to 1. The default is 1."
        },
        "seed": {
          "help": "Use -1 for a random seed. Set an integer for more repeatable results."
        },
        "enable_sync_mode": {
          "help": "Wait for Atlas to return a finished result in the submit response."
        },
        "enable_base64_output": {
          "help": "Request a Base64 response. The work machine decodes it and stores the original image."
        }
      }
    },
