      "parameterLayout": {
        "image": {
          "help": "上传一张图片，最多 30 MB。总像素为 512×512 至 6000×6000，宽高比为 1:16 至 16:1。"
        },
        "image_source": {
          "help": "填一个公开 HTTP(S) 图片地址或 Base64 data URL。使用此项时，请留空上传槽位。TIFF 可通过此方式提供。"
