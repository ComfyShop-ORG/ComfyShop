{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-alibaba-wan-2-7-pro-text-to-image",
  "name": "Wan 2.7 Pro 文生图",
  "description": "用提示词生成图片，可指定尺寸、张数与调色板。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 5000
    },
    {
      "name": "size",
      "kind": "choice",
      "default": "2K",
      "choices": ["1K", "2K", "4K"],
      "optional": true
    },
    {
      "name": "n",
      "kind": "integer",
      "default": 1,
      "minimum": "1",
      "maximum": "4",
      "optional": true
    },
    {
      "name": "custom_size",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "color_palette",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": true
    },
    {
      "name": "thinking_mode",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "minimum": "-1",
      "maximum": "2147483647",
      "optional": true
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "n",
      "section": "default"
    },
    {
      "fieldId": "custom_size",
      "section": "advanced"
    },
    {
      "fieldId": "color_palette",
      "section": "advanced"
    },
    {
      "fieldId": "thinking_mode",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "alibaba/wan-2.7-pro/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "n": "n",
        "thinking_mode": "thinking_mode",
        "seed": "seed",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"],
      "parameter_overrides": {
        "size": "custom_size"
      },
      "image_size_limits": {
        "min_side": 1,
        "min_pixels": 589824,
        "max_pixels": 16777216,
        "max_aspect_ratio": 8,
        "allow_auto": false,
        "preset_sizes": ["1K", "2K", "4K"]
      },
      "color_palette_field": "color_palette"
    }
  },
  "translations": {
    "zh": {
      "name": "Wan 2.7 Pro 文生图",
      "description": "用提示词生成图片，可指定尺寸、张数与调色板。",
      "fields": {
        "prompt": {
          "label": "提示词"
        },
        "size": {
          "label": "尺寸"
        },
        "n": {
          "label": "张数"
        },
        "custom_size": {
          "label": "自定义尺寸"
        },
        "color_palette": {
          "label": "调色板"
        },
        "thinking_mode": {
          "label": "思考模式"
        },
        "seed": {
          "label": "随机种子"
        },
        "enable_sync_mode": {
          "label": "等待成品"
        },
        "enable_base64_output": {
          "label": "Base64 输出"
        }
      },
      "parameterLayout": {
        "prompt": {
          "help": "描述主体、构图、光线和风格。最多 5,000 字符。"
        },
        "size": {
          "help": "选择 1K、2K 或 4K。默认 2K，可在高级区填写自定义尺寸。"
        },
        "n": {
          "help": "选择 1 至 4 张。默认 1 张。"
        },
        "custom_size": {
          "help": "填写宽*高，例如 4096*4096。总像素为 589,824 至 16,777,216，长短边比例最多 8:1。"
        },
        "color_palette": {
          "help": "填写含 3 至 10 项的 JSON 数组。每项含 hex（如 #274A67）与 ratio（如 50.00%），百分比合计 100.00%。"
        },
        "thinking_mode": {
          "help": "开启后让模型进一步理解构图与画面。默认开启。"
        },
        "seed": {
          "help": "输入 -1 使用随机种子，或指定 0 至 2147483647 的整数。"
        },
        "enable_sync_mode": {
          "help": "开启后等待生成完成并直接返回结果。"
        },
        "enable_base64_output": {
          "help": "以 Base64 返回图片，工作机解码后保存。"
        }
      }
    },
