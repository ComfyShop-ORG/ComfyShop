{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-vidu-2-image-to-video",
  "name": "Vidu 2.0 图生视频",
  "description": "从一张起始图生成 4 或 8 秒的视频，可控制主体动作幅度。",
  "category": "video",
  "fields": [
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "Two colorful clowns dancing wildly in a busy street market, their exaggerated gestures and big smiles drawing attention. Vibrant stalls in the background, chaotic and joyful atmosphere, fast-paced movement, playful energy",
      "multiline": true,
      "maxLength": 1500
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 4,
      "choices": [4, 8],
      "optional": true
    },
    {
      "name": "movement_amplitude",
      "kind": "choice",
      "default": "auto",
      "choices": ["auto", "small", "medium", "large"],
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": 0,
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "default": "",
      "optional": true,
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "movement_amplitude",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "vidu/image-to-video-2.0",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "movement_amplitude": "movement_amplitude",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 1500
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "max_bytes": 50000000,
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "image_bounds": {
            "max_aspect_ratio_exclusive": 4
          }
        }
      }
    }
  },
  "translations": {
    "zh": {
