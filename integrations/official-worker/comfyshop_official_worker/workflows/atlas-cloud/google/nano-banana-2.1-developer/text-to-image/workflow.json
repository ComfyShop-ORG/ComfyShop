        "temperature": {
          "help": "サンプリングの変化を 0～1 の範囲で指定します。既定値は 1 です。"
        },
        "seed": {
          "help": "-1 でランダムなシードを使います。再現性を高める場合は整数を指定します。"
        },
        "enable_sync_mode": {
          "help": "Atlas の完了を待ち、送信時の応答で結果を取得します。"
        },
        "enable_base64_output": {
          "help": "Atlas に Base64 での返却を求めます。ワーカーが復号して元の画像を保存します。"
        }
