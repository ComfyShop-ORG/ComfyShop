{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-alibaba-wan-2-5-text-to-image",
  "name": "Wan 2.5 文生图",
  "description": "根据提示词生成图片，可选择尺寸与提示词扩写。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 2000
    },
    {
      "name": "size",
      "kind": "choice",
      "default": "1280*1280",
      "choices": [
        "576*1344",
        "720*1280",
        "720*1680",
        "768*1024",
        "800*1200",
        "936*2184",
        "960*1280",
        "960*1440",
        "1024*768",
        "1024*1024",
        "1080*1920",
        "1168*1752",
        "1200*800",
        "1200*1600",
        "1224*1632",
        "1280*720",
        "1280*960",
        "1280*1280",
        "1344*576",
        "1440*960",
        "1440*1440",
        "1600*1200",
        "1632*1224",
        "1680*720",
        "1752*1168",
        "1920*1080",
        "2184*936"
      ],
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    },
    {
      "name": "negative_prompt",
      "optional": true,
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 500
    },
    {
      "name": "enable_prompt_expansion",
      "optional": true,
      "kind": "boolean",
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "enable_prompt_expansion",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "alibaba/wan-2.5/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "seed": "seed",
        "negative_prompt": "negative_prompt",
        "enable_prompt_expansion": "enable_prompt_expansion"
