      "parameterLayout": {
        "text": {
          "help": "Describe narration, sound effects, and ambience in up to 3000 characters. Use @Audio1, @Audio2, or @Audio3 to refer to voices or recordings in submission order."
        },
        "format": {
          "help": "The default is MP3. PCM returns a downloadable raw audio file."
        },
        "sample_rate": {
          "help": "Select the output sample rate. The default is 24000 Hz."
        },
        "pitch": {
          "help": "Adjust from -12 to 12. The default is 0."
        },
        "speech_rate": {
          "help": "Adjust from -50 to 100. -50 is half speed and 100 is double speed. The default is 0."
        },
        "loudness": {
          "help": "Adjust from -50 to 100. -50 is half loudness and 100 is double loudness. The default is 0."
        },
        "speaker_1": {
          "help": "Select an official voice. Choose one source for reference 1."
        },
        "voice_id_1": {
          "help": "Enter a voice ID registered with the provider. Leave the other sources for this reference blank."
        },
        "audio_1": {
          "help": "Supports MP3, WAV, PCM, or OGG Opus up to 30 seconds and 10 MB per recording."
        },
        "inline_1": {
          "help": "Send the uploaded reference as inline Base64. Off by default, which uses an uploaded URL."
        },
        "speaker_2": {
          "help": "Select an official voice. Choose one source for reference 2."
        },
        "voice_id_2": {
          "help": "Enter a voice ID registered with the provider. Leave the other sources for this reference blank."
        },
        "audio_2": {
          "help": "Supports MP3, WAV, PCM, or OGG Opus up to 30 seconds and 10 MB per recording."
        },
        "inline_2": {
          "help": "Send the uploaded reference as inline Base64. Off by default, which uses an uploaded URL."
        },
        "speaker_3": {
          "help": "Select an official voice. Choose one source for reference 3."
        },
        "voice_id_3": {
          "help": "Enter a voice ID registered with the provider. Leave the other sources for this reference blank."
        },
        "audio_3": {
          "help": "Supports MP3, WAV, PCM, or OGG Opus up to 30 seconds and 10 MB per recording."
        },
        "inline_3": {
          "help": "Send the uploaded reference as inline Base64. Off by default, which uses an uploaded URL."
        },
        "reference_image": {
          "help": "Use one JPEG, PNG, or WebP image up to 10 MB. An image reference must be used on its own."
        },
        "inline_image": {
          "help": "Send the image as inline Base64. Off by default, which uses an uploaded URL."
