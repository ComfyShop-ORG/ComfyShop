{
  "format": "service",
  "workerKind": "official",
  "key": "seedream-v50-lite",
  "name": "Seedream v5.0 Lite 文生图",
  "description": "根据提示词生成单张图片，可选择 2K 或 3K 预设，适合海报、排版与视觉创作。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "choices": [
        "2048*2048",
        "2304*1728",
        "1728*2304",
        "2848*1600",
        "1600*2848",
        "2496*1664",
        "1664*2496",
        "3136*1344",
        "3072*3072",
        "3456*2592",
        "2592*3456",
        "4096*2304",
        "2304*4096",
        "2496*3744",
        "3744*2496",
        "4704*2016"
      ],
      "default": "2048*2048"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "choices": ["jpeg", "png"],
      "default": "jpeg"
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "bytedance/seedream-v5.0-lite",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "output_format": "output_format",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"]
    }
  },
