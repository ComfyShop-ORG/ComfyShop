      "parameterLayout": {
        "reference_image": {
          "help": "上传清晰展示物体的图片。"
        },
        "texture": {
          "help": "为网格生成纹理。"
        },
        "pbr": {
          "help": "生成基于物理的渲染材质。"
        },
        "texture_quality": {
          "help": "选择标准或精细纹理。"
        },
        "geometry_quality": {
          "help": "选择标准或精细几何结构。"
        },
        "texture_alignment": {
          "help": "按原图或网格几何对齐纹理。"
        },
        "orientation": {
          "help": "使用默认朝向或与参考图片对齐。"
        },
        "face_limit": {
          "help": "输入 1000 至 2000000 个面。初始为空，由模型自适应决定。"
