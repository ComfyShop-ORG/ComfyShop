{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-omnihuman-15",
  "name": "OmniHuman 1.5 音频驱动人像",
  "description": "用一张人像和一段音频生成口型同步的视频，视频长度跟随音频。",
  "category": "video",
  "fields": [
    {
      "name": "portrait",
      "kind": "image",
      "optional": true
    },
    {
      "name": "driving_audio",
      "kind": "audio",
      "optional": true
    },
    {
      "name": "output_resolution",
      "kind": "choice",
      "default": 1080,
      "choices": [720, 1080],
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 2000,
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    },
    {
      "name": "portrait_url",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "audio_url",
      "kind": "string",
      "default": "",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "portrait",
      "section": "default"
    },
    {
      "fieldId": "driving_audio",
      "section": "default"
    },
    {
      "fieldId": "output_resolution",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "portrait_url",
      "section": "advanced"
    },
    {
      "fieldId": "audio_url",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "bytedance/avatar-omni-human-v1.5",
      "operation": "video",
      "parameters": {
        "output_resolution": "output_resolution",
        "prompt": "prompt",
        "seed": "seed"
      },
      "omit_blank_parameters": ["prompt"],
      "text_max_lengths": {
        "prompt": 2000
      },
      "prediction_endpoint": "result",
      "media": {
        "image_url": {
          "kind": "image",
          "fields": ["portrait"],
          "external_sources_field": "portrait_url",
          "external_urls_only": true,
          "min_items": 1
        },
        "audio_url": {
          "kind": "audio",
          "fields": ["driving_audio"],
          "external_sources_field": "audio_url",
          "external_urls_only": true,
          "min_items": 1,
          "content_types": ["audio/mpeg", "audio/mp3", "audio/wav", "audio/wave", "audio/x-wav"],
          "max_duration_ms": 60000
        }
      }
    }
  },
  "translations": {
