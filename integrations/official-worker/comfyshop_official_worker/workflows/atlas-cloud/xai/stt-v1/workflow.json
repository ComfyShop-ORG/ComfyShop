      },
      "parameterLayout": {
        "source_audio": {
          "help": "上傳含音軌的音訊或影片。支援 MP3、WAV、M4A、FLAC、OGG、Opus、AAC、MP4 和 MKV，也可上傳裸音訊。"
        },
        "normalize_numbers": {
          "help": "將口述數字、貨幣與單位轉為常用書寫方式。開啟後需選擇語言。"
        },
        "language": {
          "help": "留空自動辨識。啟用數字與單位正規化時，由所選語言決定書寫規則。"
        },
        "key_terms": {
          "help": "每行填寫一個詞組，最多 100 個，每個最多 50 個字元。略過空行。"
        },
        "diarize": {
          "help": "標記轉錄詞語的說話者。預設關閉。"
        },
        "keep_fillers": {
          "help": "啟用後保留停頓詞與語氣詞。預設移除。"
        },
        "audio_format": {
          "help": "容器檔案使用 auto。裸音訊選擇 PCM、G.711 μ-law 或 G.711 A-law。使用對應的 .raw 或 .pcm、.mulaw 或 .ulaw、.alaw 副檔名。"
        },
        "sample_rate": {
          "help": "裸音訊必填。依原始檔填寫取樣率，單位為 Hz。"
        },
        "multichannel": {
          "help": "分別轉錄各聲道，最多 8 聲道。預設關閉。"
        },
        "channels": {
          "help": "分聲道轉錄裸音訊時填寫 2 至 8。容器檔案會自動辨識。"
        },
        "sync_mode": {
          "help": "啟用後優先從提交回應讀取結果。預設關閉。"
        }
      }
    },
    "en": {
      "name": "xAI STT v1 Speech to Text",
      "description": "Transcribe audio or video with word-level timestamps, speaker labels, and separate channel results.",
      "fields": {
        "source_audio": {
          "label": "Audio or video"
        },
        "normalize_numbers": {
          "label": "Normalize numbers and units"
        },
        "language": {
          "label": "Recognition language"
        },
        "key_terms": {
          "label": "Key terms"
        },
        "diarize": {
          "label": "Identify speakers"
        },
        "keep_fillers": {
          "label": "Keep filler words"
        },
        "audio_format": {
          "label": "Raw audio encoding"
        },
        "sample_rate": {
          "label": "Sample rate"
        },
        "multichannel": {
          "label": "Transcribe by channel"
        },
        "channels": {
          "label": "Audio channels"
        },
        "sync_mode": {
          "label": "Return synchronously"
        }
      },
      "parameterLayout": {
        "source_audio": {
          "help": "Upload audio or video with an audio track. Supports MP3, WAV, M4A, FLAC, OGG, Opus, AAC, MP4, MKV, and raw audio."
        },
        "normalize_numbers": {
          "help": "Format spoken numbers, currencies, and units in their written forms. Select a language when enabled."
        },
        "language": {
          "help": "Leave blank for automatic detection. The selected language determines the writing rules when normalization is enabled."
        },
        "key_terms": {
          "help": "Enter one term per line, up to 100 terms and 50 characters per term. Blank lines are skipped."
        },
        "diarize": {
          "help": "Label words by speaker. Off by default."
        },
        "keep_fillers": {
          "help": "Keep hesitations and filler words. They are removed by default."
        },
        "audio_format": {
          "help": "Use auto for container files. For raw audio, choose PCM, G.711 μ-law, or G.711 A-law with a matching .raw or .pcm, .mulaw or .ulaw, or .alaw extension."
        },
        "sample_rate": {
          "help": "Required for raw audio. Select the original sample rate in Hz."
        },
        "multichannel": {
          "help": "Transcribe up to eight channels independently. Off by default."
        },
        "channels": {
          "help": "Set 2 through 8 when transcribing raw audio by channel. Channels are detected from container files."
        },
        "sync_mode": {
          "help": "Read the result from the submission response when available. Off by default."
        }
      }
    },
    "ja": {
      "name": "xAI STT v1 音声からテキスト",
      "description": "音声や動画を単語単位のタイムスタンプ付きで文字起こしします。話者識別とチャンネル別の文字起こしに対応します。",
      "fields": {
