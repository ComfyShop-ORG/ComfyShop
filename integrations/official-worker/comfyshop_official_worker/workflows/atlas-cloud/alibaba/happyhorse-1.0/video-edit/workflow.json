{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-alibaba-happyhorse-1-0-video-edit",
  "name": "HappyHorse 1.0 视频编辑",
  "description": "按提示词编辑视频，可保存原音轨或由模型处理音频。",
  "category": "video_tool",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 2500
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1080p",
      "optional": true,
      "choices": ["720p", "1080p"]
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true,
      "minimum": "-1",
      "maximum": "2147483647"
    },
    {
      "name": "reference_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_4",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_5",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "video",
      "kind": "video",
      "optional": true
    },
    {
      "name": "video_source",
      "kind": "string",
      "optional": true,
      "default": ""
    },
    {
      "name": "audio_setting",
      "kind": "choice",
      "choices": ["auto", "origin"],
      "default": "auto",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "video",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "reference_1",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "reference_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_3",
      "section": "advanced"
    },
    {
      "fieldId": "reference_4",
      "section": "advanced"
    },
    {
      "fieldId": "reference_5",
      "section": "advanced"
    },
    {
      "fieldId": "reference_sources",
      "section": "advanced"
    },
    {
      "fieldId": "video_source",
      "section": "advanced"
    },
    {
      "fieldId": "audio_setting",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "alibaba/happyhorse-1.0/video-edit",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "seed": "seed",
        "audio_setting": "audio_setting"
      },
      "required_text": ["prompt"],
      "media": {
        "images": {
          "kind": "image",
          "fields": ["reference_1", "reference_2", "reference_3", "reference_4", "reference_5"],
          "array": true,
          "content_types": ["image/jpeg", "image/png", "image/bmp", "image/webp"],
          "external_sources_field": "reference_sources",
          "max_bytes": 10000000,
          "image_bounds": {
            "max_aspect_ratio": 2.5
          },
          "external_urls_only": true
        },
        "video": {
          "kind": "video",
          "fields": ["video"],
          "min_items": 1,
          "external_urls_only": true,
          "external_sources_field": "video_source",
          "content_types": ["video/mp4", "video/quicktime"],
          "max_bytes": 100000000,
          "min_duration_ms": 3000,
          "max_duration_ms": 60000
        }
      }
    }
  },
