      "parameterLayout": {
        "image": {
          "help": "上传 JPEG 或 PNG 图片。"
        },
        "type": {
          "help": "标准模式适合通用图片，AIGC 适合生成图片，细节增强侧重纹理，高保真适合商品图。"
        },
        "mode": {
          "help": "可选择按倍数、等比适配或固定尺寸。"
        },
        "percent": {
          "help": "按倍数模式使用。1 至 10 倍，默认 2，步长 0.1。"
        },
        "width": {
          "help": "等比适配或固定尺寸使用，单位像素。"
        },
        "height": {
          "help": "等比适配或固定尺寸使用，单位像素。"
        },
        "long_side": {
          "help": "等比适配或固定尺寸使用，可用长短边指定尺寸，单位像素。"
        },
        "short_side": {
          "help": "等比适配或固定尺寸使用，可用长短边指定尺寸，单位像素。"
        },
        "encode_format": {
          "help": "选择 JPEG、PNG、WebP 或 BMP。"
        },
        "encode_quality": {
          "help": "有损格式使用，1 至 100，默认 80。"
        },
        "output_dir": {
          "help": "填写腾讯云 COS 输出目录。留空自动分配。"
        }
      }
    },
