    {
      "name": "count",
      "kind": "choice",
      "default": 1,
      "choices": [1, 2],
      "optional": true
    },
    {
      "name": "product_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "ratio",
      "kind": "choice",
      "default": "16:9",
      "choices": ["16:9", "9:16", "1:1", "3:4", "4:3"],
      "optional": true
    },
    {
      "name": "generate_audio",
      "kind": "choice",
      "default": "yes",
      "choices": ["yes", "no"],
      "optional": true
    },
    {
      "name": "model_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "video_source",
      "kind": "string",
      "default": "",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "reference_video",
      "section": "default"
    },
    {
      "fieldId": "product_image",
      "section": "default"
    },
    {
      "fieldId": "model_image",
      "section": "default"
    },
    {
      "fieldId": "user_prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "ratio",
      "section": "default"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "count",
      "section": "advanced"
    },
    {
      "fieldId": "product_source",
      "section": "advanced"
    },
    {
      "fieldId": "model_source",
      "section": "advanced"
    },
    {
      "fieldId": "video_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "atlascloud/studio/trend-remix",
      "operation": "video",
      "parameters": {
        "user_prompt": "user_prompt",
        "resolution": "resolution",
        "duration": "duration",
        "count": "count",
        "ratio": "ratio",
        "generate_audio": "generate_audio"
      },
      "media": {
        "product_image": {
          "kind": "image",
          "fields": ["product_image"],
          "external_sources_field": "product_source",
          "external_urls_only": true,
          "min_items": 1,
          "array": true,
          "max_bytes": 10000000
        },
        "model_image": {
          "kind": "image",
          "fields": ["model_image"],
          "external_sources_field": "model_source",
          "external_urls_only": true,
          "array": true,
          "max_bytes": 10000000
        },
        "reference_video": {
          "kind": "video",
          "fields": ["reference_video"],
          "external_sources_field": "video_source",
          "external_urls_only": true,
          "min_items": 1,
          "content_types": ["video/mp4", "video/quicktime"],
          "min_duration_ms": 4000,
          "max_duration_ms": 20000,
          "array": true,
          "max_bytes": 20000000
        }
      },
      "required_text": ["user_prompt"],
      "omit_blank_parameters": ["duration"]
    }
  },
