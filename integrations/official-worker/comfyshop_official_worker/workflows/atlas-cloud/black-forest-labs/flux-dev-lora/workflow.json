      "parameterLayout": {
        "prompt": {
          "help": "Describe the subject, scene, composition, and style."
        },
        "loras": {
          "help": "Enter a JSON array of up to five entries. Each needs a weights path or URL. Scale ranges from 0 to 4 and defaults to 1."
        },
        "size": {
          "help": "Enter width*height in pixels, such as 1024*1024."
        },
        "num_images": {
          "help": "Choose one to four images."
        },
        "source_image": {
          "help": "Optionally upload an image for image-to-image generation or masked editing."
        },
        "mask": {
          "help": "Mark areas to regenerate in white and areas to preserve in black. Supply a source image with the mask."
        },
        "strength": {
          "help": "Choose 0 to 1. Higher values change the source image more."
        },
        "num_inference_steps": {
          "help": "Choose 1 to 50 steps. The default is 28."
        },
        "guidance_scale": {
          "help": "Choose 0 to 20. Higher values follow the prompt more closely. The default is 2.5."
        },
        "seed": {
          "help": "Enter an integer to reuse a seed. The default of −1 selects a random seed."
        },
        "source_image_url": {
          "help": "Enter a public image URL as an alternative to uploading."
        },
        "mask_url": {
          "help": "Enter a public mask image URL as an alternative to uploading."
        },
        "cfg_scale": {
          "help": "Choose 0 to 20. A negative prompt requires a value greater than 1."
        },
        "negative_prompt": {
          "help": "Describe content to avoid. Set CFG scale above 1 when using this field."
        }
      }
    },
