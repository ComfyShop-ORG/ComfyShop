        },
        "speed": {
          "help": "1 为正常速度，可设置 0.7 至 1.5。"
        },
        "text_normalization": {
          "help": "先把数字、缩写和符号转换成便于朗读的形式。"
        },
        "optimize_streaming_latency": {
          "help": "优化首段音频的延迟，等级越高，分段衔接处可能越明显。 0 最佳音质 · 1 降低延迟 · 2 最低延迟"
