            "reference_7",
            "reference_8",
            "reference_9",
            "reference_10",
            "reference_11",
            "reference_12",
            "reference_13",
            "reference_14"
          ],
          "array": true,
          "content_types": ["image/png", "image/jpeg", "image/webp", "image/heic", "image/heif"],
          "external_sources_field": "reference_sources",
          "max_bytes": 7000000
        },
        "video_clips": {
          "kind": "video",
          "fields": ["video"],
          "array": true,
          "min_items": 1,
          "max_duration_ms": 1500000,
          "external_sources_field": "video_source",
          "video_clip": {
            "start": "video_start",
            "ends": "video_end",
            "fps": "video_fps"
          }
        }
      }
    }
