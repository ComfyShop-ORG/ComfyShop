{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-flux2-flex-edit",
  "name": "FLUX.2 Flex 图像编辑",
  "description": "根据提示词编辑 1 至 8 张源图，可选 JPEG 或 PNG 成品。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "jpeg",
      "choices": ["jpeg", "png"]
    },
    {
      "optional": true,
      "name": "seed",
      "kind": "integer",
      "default": -1
    },
    {
      "optional": true,
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "size",
      "kind": "string",
      "default": "1024*1024",
      "optional": true
    },
    {
      "name": "safety_tolerance",
      "kind": "integer",
      "default": 2,
      "minimum": "0",
      "maximum": "5",
      "optional": true
    },
    {
      "name": "source_image_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "source_image_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "source_image_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "source_image_4",
      "kind": "image",
      "optional": true
    },
    {
      "name": "source_image_5",
      "kind": "image",
      "optional": true
    },
    {
      "name": "source_image_6",
      "kind": "image",
      "optional": true
    },
    {
      "name": "source_image_7",
      "kind": "image",
      "optional": true
    },
    {
      "name": "source_image_8",
      "kind": "image",
      "optional": true
    },
    {
      "name": "image_sources",
      "kind": "string",
      "default": "",
      "optional": true,
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "enable_prompt_expansion",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "optional": true,
      "name": "guidance_scale",
      "kind": "number",
      "default": 5,
      "minimum": "1.5",
      "maximum": "10"
    },
    {
      "optional": true,
      "name": "num_inference_steps",
      "kind": "integer",
      "default": 50,
      "minimum": "1",
      "maximum": "50"
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "source_image_1",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "enable_prompt_expansion",
      "section": "advanced"
    },
    {
      "fieldId": "guidance_scale",
      "section": "advanced"
    },
    {
      "fieldId": "num_inference_steps",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "safety_tolerance",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "size",
      "section": "hidden"
    },
    {
      "fieldId": "source_image_2",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_3",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_4",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_5",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_6",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_7",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_8",
      "section": "advanced"
    },
    {
      "fieldId": "image_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "black-forest-labs/flux-2-flex/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "output_format": "output_format",
        "seed": "seed",
        "enable_base64_output": "enable_base64_output",
        "enable_sync_mode": "enable_sync_mode",
        "size": "size",
        "safety_tolerance": "safety_tolerance",
        "enable_prompt_expansion": "enable_prompt_expansion",
        "guidance_scale": "guidance_scale",
        "num_inference_steps": "num_inference_steps"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["size"],
      "image_size_limits": {
        "allow_auto": false,
        "min_side": 256,
        "max_side": 2048
      },
      "media": {
        "images": {
          "kind": "image",
          "array": true,
          "fields": [
            "source_image_1",
            "source_image_2",
            "source_image_3",
            "source_image_4",
            "source_image_5",
            "source_image_6",
            "source_image_7",
            "source_image_8"
          ],
          "external_sources_field": "image_sources",
          "min_items": 1,
          "content_types": ["image/png", "image/jpeg", "image/webp"],
          "allow_raw_base64": true
        }
      }
    }
  },
