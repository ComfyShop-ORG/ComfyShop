{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-atlascloud-studio-product-visuals",
  "name": "Atlas Cloud Studio 商品视觉广告",
  "description": "用商品照片生成主图、详情页或宣传海报，可指定模特照片。",
  "category": "image_tool",
  "fields": [
    {
      "name": "product_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "model_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "user_prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": false
    },
    {
      "name": "visual_type",
      "kind": "choice",
      "default": "product_hero",
      "choices": ["product_hero", "product_detail", "promo_poster", ""],
      "optional": true
    },
    {
      "name": "ratio",
      "kind": "choice",
      "default": "9:16",
      "choices": ["1:1", "3:4", "4:3", "16:9", "9:16"],
      "optional": true
    },
    {
      "name": "product_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "model_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "count",
      "kind": "choice",
      "default": 1,
      "choices": [1, 2, 3, 4],
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "2k",
      "choices": ["1k", "2k", "4k"],
      "optional": true
    },
    {
      "name": "format",
      "kind": "choice",
      "default": "png",
      "choices": ["png", "jpeg"],
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "product_image",
      "section": "default"
    },
    {
      "fieldId": "model_image",
      "section": "default"
    },
    {
      "fieldId": "user_prompt",
      "section": "default"
    },
    {
      "fieldId": "visual_type",
      "section": "default"
    },
    {
      "fieldId": "ratio",
      "section": "default"
    },
    {
      "fieldId": "product_source",
      "section": "advanced"
    },
    {
      "fieldId": "model_source",
      "section": "advanced"
    },
    {
      "fieldId": "count",
      "section": "advanced"
    },
    {
      "fieldId": "resolution",
      "section": "advanced"
    },
    {
      "fieldId": "format",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "atlascloud/studio/product-visuals",
      "operation": "image",
      "parameters": {
        "user_prompt": "user_prompt",
        "visual_type": "visual_type",
        "ratio": "ratio",
        "count": "count",
        "resolution": "resolution",
        "format": "format"
      },
      "media": {
        "product_image": {
          "kind": "image",
          "fields": ["product_image"],
          "external_sources_field": "product_source",
          "external_urls_only": true,
          "min_items": 1,
          "max_bytes": 10000000
        },
        "model_image": {
          "kind": "image",
          "fields": ["model_image"],
          "external_sources_field": "model_source",
          "external_urls_only": true,
          "max_bytes": 10000000
        }
      },
      "omit_blank_parameters": ["visual_type"],
      "required_text": ["user_prompt"]
    }
  },
  "translations": {
    "zh": {
