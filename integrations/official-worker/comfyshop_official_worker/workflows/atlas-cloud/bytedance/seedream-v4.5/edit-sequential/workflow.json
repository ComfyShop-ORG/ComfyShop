    {
      "name": "reference_7",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_8",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_9",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_10",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
