      "parameterLayout": {
        "prompt": {
          "help": "Describe what to generate. For a GIF, include the motion and how it loops. Up to 32,000 characters."
        },
        "quality": {
          "help": "Choose the rendering quality. Time and cost can vary by tier."
        },
        "complexity": {
          "help": "Controls how much planning happens before rendering. Use high for dense text or complex layouts."
        },
        "size": {
          "help": "Still images default to 1024 × 1024 and GIFs default to auto. GIF dimensions apply to each frame."
        },
        "custom_size": {
          "help": "Override the preset with widthxheight, such as 512x512. Each side must be 256 to 3840 and divisible by 16. Maximum area is 8,294,400 pixels, with a 1:3 to 3:1 aspect ratio."
        },
        "background": {
          "help": "Transparent backgrounds work with PNG, WebP, or SVG."
        },
        "output_format": {
          "help": "GIF produces animation. SVG can be viewed as source code and downloaded as an editable vector file."
        },
        "frame_count": {
          "help": "GIF only. Enter 2 to 64. Atlas bills in groups of up to 8 frames."
        },
        "frame_duration_ms": {
          "help": "GIF only. Enter 20 to 2,000 milliseconds. Atlas rounds to the nearest 10 milliseconds."
        },
        "svg_model": {
          "help": "SVG only. The selected model draws the reference image as vectors."
        },
        "moderation": {
          "help": "Choose automatic or low content moderation on Atlas."
        },
        "n": {
          "help": "Enter 1 to 10. SVG output requires 1."
        }
      }
    },
