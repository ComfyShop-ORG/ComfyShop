{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-veed-fab",
  "name": "VEED Fabric 1.0 图生视频",
  "description": "用一张图片和一段音频生成视频，支持 480p 和 720p。",
  "category": "video",
  "fields": [
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "driving_audio",
      "kind": "audio",
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": ["480p", "720p"],
      "default": "720p"
    },
    {
      "name": "image_source",
      "kind": "string",
      "multiline": true,
      "maxLength": 4194304,
      "optional": true,
      "default": ""
    },
    {
      "name": "audio_source",
      "kind": "string",
      "optional": true,
      "default": ""
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "driving_audio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "image_source",
      "section": "advanced"
    },
    {
      "fieldId": "audio_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "veed/fabric-1.0/image-to-video",
      "operation": "video",
      "parameters": {
        "resolution": "resolution"
      },
      "prediction_endpoint": "result",
      "request_max_bytes": 20000000,
      "media": {
        "image_url": {
          "kind": "image",
          "fields": ["first_frame"],
          "min_items": 1,
          "external_sources_field": "image_source",
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true
        },
        "audio_url": {
          "kind": "audio",
          "fields": ["driving_audio"],
          "min_items": 1,
          "external_sources_field": "audio_source",
          "external_urls_only": true,
          "min_duration_ms": 1000,
          "max_duration_ms": 300000
        }
      }
    }
  },
  "translations": {
    "zh": {
