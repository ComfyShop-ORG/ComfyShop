{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-kwaivgi-kling-video-o1-image-to-video",
  "name": "可灵 O1 图生视频",
  "description": "用起始图生成 5 或 10 秒的 1080p 视频，可指定结束帧。",
  "category": "video",
  "fields": [
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "last_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": false
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 5,
      "optional": true,
      "choices": [5, 10]
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "last_frame_source",
      "kind": "string",
      "default": "",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "last_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "last_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "kwaivgi/kling-video-o1/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration"
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "external_urls_only": true,
          "min_items": 1
        },
        "last_image": {
          "kind": "image",
          "fields": ["last_frame"],
          "external_sources_field": "last_frame_source",
          "external_urls_only": true
        }
      },
      "required_text": ["prompt"]
    }
  },
