      "parameterLayout": {
        "prompt": {
          "help": "描述主体、场景、构图和风格。"
        },
        "size": {
          "help": "按宽*高填写像素，每边最多 1,536 像素。可留空使用接口设置。"
        },
        "loras": {
          "help": "填写 JSON 数组，最多三项。每项填写权重路径或 URL，系数 0 至 4，默认 1。"
        },
        "num_images": {
          "help": "选择 1 至 4 张。"
        },
        "output_format": {
          "help": "选择 JPEG、PNG 或 WebP。"
        },
        "source_image": {
          "help": "上传要编辑的源图。也可在高级参数中填写公开图片地址。"
        },
        "num_inference_steps": {
          "help": "选择 1 至 50 步，默认 28 步。"
        },
        "guidance_scale": {
          "help": "选择 0 至 20，数值越高越贴近提示词。默认 2.5。"
        },
        "seed": {
          "help": "输入整数以重用种子，默认 -1 表示随机。"
        },
        "enable_base64_output": {
          "help": "返回 Base64 图像数据，工作机解码后保存成品。"
        },
        "source_image_url": {
          "help": "填写一个公开图片地址，与上传二选一。"
        },
        "enable_sync_mode": {
          "help": "让 Atlas 等待图片生成后在提交响应中直接返回成品。"
        }
      }
    },
