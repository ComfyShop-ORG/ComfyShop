{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-qwen3p-text",
  "name": "Qwen Image 3.0 Pro 文生图",
  "description": "根据提示词生成 1 至 4 张图片，可设置尺寸和提示词改写策略。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "size",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "image_count",
      "kind": "integer",
      "minimum": "1",
      "maximum": "4",
      "optional": true,
      "default": 1
    },
    {
      "name": "negative_prompt",
      "kind": "string",
      "multiline": true,
      "default": "",
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "minimum": "0",
      "maximum": "2147483647",
      "optional": true
    },
    {
      "name": "prompt_extend",
      "kind": "boolean",
      "optional": true,
      "default": true
    },
    {
      "name": "prompt_extend_mode",
      "kind": "choice",
      "choices": ["direct", "agent"],
      "optional": true,
      "default": "direct"
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "image_count",
      "section": "default"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "prompt_extend",
      "section": "advanced"
    },
    {
      "fieldId": "prompt_extend_mode",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "qwen-image-3.0-pro/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "n": "image_count",
        "negative_prompt": "negative_prompt",
        "seed": "seed",
        "prompt_extend": "prompt_extend",
        "prompt_extend_mode": "prompt_extend_mode"
      },
      "required_text": ["prompt"],
      "image_size_limits": {
        "min_side": 512,
        "max_side": 2048,
        "allow_auto": false
      },
      "omit_blank_parameters": ["size", "negative_prompt"],
      "enabled_by": {
        "prompt_extend_mode": "prompt_extend"
      }
    }
  },
  "translations": {
    "zh": {
