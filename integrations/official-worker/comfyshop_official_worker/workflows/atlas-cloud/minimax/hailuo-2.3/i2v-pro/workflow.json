{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-hailuo23-pro-image",
  "name": "Hailuo 2.3 Pro 图生视频",
  "description": "从首帧图片生成固定时长的视频，可补充动作描述。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "",
      "maxLength": 2000,
      "optional": true
    },
    {
      "name": "expand_prompt",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "expand_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "minimax/hailuo-2.3/i2v-pro",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "enable_prompt_expansion": "expand_prompt"
      },
      "text_max_lengths": {
        "prompt": 2000
      },
      "prediction_endpoint": "result",
      "omit_blank_parameters": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "max_bytes": 20000000,
          "content_types": ["image/jpeg", "image/png"],
          "image_bounds": {
            "min_side": 301,
            "max_aspect_ratio_exclusive": 2.5
          }
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Hailuo 2.3 Pro 图生视频",
      "description": "从首帧图片生成固定时长的视频，可补充动作描述。",
      "fields": {
        "prompt": {
          "label": "提示词"
        },
        "expand_prompt": {
          "label": "扩写提示词"
        },
        "first_frame": {
          "label": "首帧图片"
        },
        "first_frame_source": {
          "label": "首帧来源"
        }
      },
      "parameterLayout": {
        "first_frame": {
          "help": "上传 JPEG、PNG。宽高比须大于 2:5 且小于 5:2，短边大于 300 像素，文件不超过 20 MB。"
        },
        "prompt": {
          "help": "可描述动作或场景，最多 2,000 字符。"
        },
        "expand_prompt": {
          "help": "开启后由模型在生成前优化提示词。"
        },
        "first_frame_source": {
          "help": "填写公开图片 URL 或 Base64 Data URI，与上传二选一。"
        }
      }
    },
    "zh-tw": {
      "name": "Hailuo 2.3 Pro 圖生影片",
