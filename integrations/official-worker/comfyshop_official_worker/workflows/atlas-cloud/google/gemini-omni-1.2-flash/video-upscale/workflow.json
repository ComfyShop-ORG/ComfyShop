{
  "format": "service",
  "workerKind": "official",
  "key": "google-gemini-omni-12-flash-video-upscale",
  "name": "Gemini Omni 1.2 Flash 视频超分",
  "description": "把短片放大到更高分辨率，保留原来的运动、构图和时间节奏。",
  "category": "video_tool",
  "fields": [
    {
      "name": "video",
      "kind": "video"
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1080p",
      "choices": ["720p", "1080p", "4k"]
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true,
      "default": -1
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "video",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "operation": "video",
      "model": "google/gemini-omni-1.2-flash/video-upscale",
      "parameters": {
        "resolution": "resolution",
        "seed": "seed"
      },
      "media": {
        "video": {
          "kind": "video",
          "fields": ["video"],
          "min_items": 1,
          "content_types": ["video/mp4"],
          "max_duration_ms": 15000
        }
      }
    }
  },
  "translations": {
