      "parameterLayout": {
        "prompt": {
          "help": "Describe the subject, composition, lighting, and style. Use up to 5,000 characters."
        },
        "size": {
          "help": "Choose 1K, 2K, or 4K. The default is 2K. Set a custom size under Advanced to override it."
        },
        "n": {
          "help": "Choose one to four images. The default is one."
        },
        "custom_size": {
          "help": "Enter width*height, such as 4096*4096. Use 589,824 to 16,777,216 total pixels and a maximum long-to-short side ratio of 8:1."
        },
        "color_palette": {
          "help": "Enter a JSON array of 3 to 10 colors. Give each a hex value like #274A67 and a ratio like 50.00%. The percentages must add to 100.00%."
        },
        "thinking_mode": {
          "help": "Let the model reason further about the composition and scene. On by default."
        },
        "seed": {
          "help": "Enter -1 for a random seed or use an integer from 0 to 2147483647."
        },
        "enable_sync_mode": {
          "help": "Wait for generation to finish and return the result in the submission response."
        },
        "enable_base64_output": {
          "help": "Request Base64 images. The work machine decodes and stores them."
        }
      }
    },
