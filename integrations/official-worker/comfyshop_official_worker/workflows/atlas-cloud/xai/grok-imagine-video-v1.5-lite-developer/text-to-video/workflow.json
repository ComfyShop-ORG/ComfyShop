{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-grok-video15-lite-dev-text-to-video",
  "name": "Grok Imagine Video v1.5 Lite Developer 文生视频",
  "description": "用提示词生成 1 至 15 秒的视频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "A paper boat drifts down a rain-soaked street at dusk, neon reflections rippling on the water, soft rain ambience.",
      "multiline": true
    },
    {
      "name": "duration_seconds",
      "kind": "integer",
      "default": 8,
      "minimum": "1",
      "maximum": "15",
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "choices": ["480p", "720p", "1080p"],
      "optional": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "choices": ["16:9", "9:16", "1:1", "4:3", "3:4", "3:2", "2:3"],
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration_seconds",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "xai/grok-imagine-video-v1.5-lite-developer/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "resolution": "resolution",
        "aspect_ratio": "aspect_ratio"
      },
      "required_text": ["prompt"]
    }
  },
