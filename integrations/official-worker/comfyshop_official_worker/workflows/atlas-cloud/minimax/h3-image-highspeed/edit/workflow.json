      "parameterLayout": {
        "prompt": {
          "help": "Describe what to edit and preserve. Refer to the submitted images in slot order, skipping empty slots. Enter up to 32,000 characters. The model expands the prompt automatically."
        },
        "reference_1": {
          "help": "Upload PNG, JPEG, or WebP up to 64 MB each. Use 128–8192 pixels per side and a long-to-short side ratio of at most 4:1."
        },
        "reference_2": {
          "help": "Uploaded references are used in slot order."
        },
        "image_size": {
          "help": "Enter auto or width*height, such as 2048*2048. Each side must be 468–7745 pixels, area 655,360–20,000,000 pixels, and aspect ratio 1:3–3:1. Auto uses the references and prompt."
        },
        "image_count": {
          "help": "Generate 1 to 10 variations from the same prompt."
        },
