{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-hailuo-pro",
  "name": "Hailuo 02 Pro 视频生成",
  "description": "根据提示词生成固定 6 秒的视频，可上传一张图片作为首帧。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "astronaut in a yellow suit slowly walks through a futuristic airlock door, heading into deep space. Cinematic sci-fi atmosphere, smooth slow motion",
      "maxLength": 2000
    },
    {
      "name": "duration_seconds",
      "kind": "choice",
      "choices": [6],
      "default": 6,
      "optional": true
    },
    {
      "name": "expand_prompt",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration_seconds",
      "section": "hidden"
    },
    {
      "fieldId": "expand_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "minimax/hailuo-02/pro",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "enable_prompt_expansion": "expand_prompt"
      },
      "text_max_lengths": {
        "prompt": 2000
      },
      "prediction_endpoint": "result",
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "max_bytes": 20000000,
          "content_types": ["image/jpeg", "image/png"],
          "image_bounds": {
            "min_side": 301,
            "max_aspect_ratio_exclusive": 2.5
          }
        }
      },
      "required_text": ["prompt"]
    }
  },
  "translations": {
