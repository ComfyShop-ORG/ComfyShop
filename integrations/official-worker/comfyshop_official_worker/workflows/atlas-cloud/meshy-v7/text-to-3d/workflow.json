{
  "format": "service",
  "workerKind": "official",
  "key": "meshy-v7-text-to-3d",
  "name": "Meshy v7 文生 3D",
  "description": "从文字生成 3D 网格，可选择完整纹理或网格预览。",
  "category": "3d",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "generation_mode",
      "kind": "choice",
      "choices": ["full", "preview"],
      "default": "full",
      "optional": true
    },
    {
      "name": "detailed_geometry",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "pbr",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "texture_resolution",
      "kind": "choice",
      "choices": ["2k", "4k", "8k"],
      "default": "2k",
      "optional": true
    },
    {
      "name": "texture_prompt",
      "kind": "string",
      "multiline": true,
      "optional": true
    },
    {
      "name": "remesh",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "topology",
      "kind": "choice",
      "choices": ["triangle", "quad"],
      "default": "triangle",
      "optional": true
    },
    {
      "name": "face_target",
      "kind": "integer",
      "minimum": "100",
      "maximum": "300000",
      "step": "1",
      "default": 30000,
      "optional": true
    },
    {
      "name": "decimation_level",
      "kind": "choice",
      "choices": [1, 2, 3, 4],
      "optional": true
    },
    {
      "name": "pose",
      "kind": "choice",
      "choices": ["", "a-pose", "t-pose"],
      "default": "",
      "optional": true
    },
    {
      "name": "real_world_scale",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "origin",
      "kind": "choice",
      "choices": ["bottom", "center"],
      "default": "bottom",
      "optional": true
    },
    {
      "name": "transparent_preview",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "moderation",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "texture_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "export_glb",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "export_obj",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "export_fbx",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "export_stl",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "export_usdz",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "export_3mf",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "generation_mode",
      "section": "default"
    },
    {
      "fieldId": "detailed_geometry",
      "section": "advanced"
    },
    {
      "fieldId": "pbr",
      "section": "advanced"
    },
    {
      "fieldId": "texture_resolution",
      "section": "advanced"
    },
    {
      "fieldId": "texture_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "remesh",
      "section": "advanced"
    },
    {
      "fieldId": "topology",
      "section": "advanced"
    },
    {
      "fieldId": "face_target",
      "section": "advanced"
    },
    {
      "fieldId": "decimation_level",
      "section": "advanced"
    },
    {
      "fieldId": "pose",
      "section": "advanced"
    },
    {
      "fieldId": "real_world_scale",
      "section": "advanced"
    },
    {
      "fieldId": "origin",
      "section": "advanced"
    },
    {
      "fieldId": "transparent_preview",
      "section": "advanced"
    },
    {
      "fieldId": "moderation",
      "section": "advanced"
    },
    {
      "fieldId": "texture_image",
      "section": "advanced"
    },
    {
      "fieldId": "export_glb",
      "section": "advanced"
    },
    {
      "fieldId": "export_obj",
      "section": "advanced"
    },
    {
      "fieldId": "export_fbx",
      "section": "advanced"
    },
    {
      "fieldId": "export_stl",
      "section": "advanced"
    },
    {
      "fieldId": "export_usdz",
      "section": "advanced"
    },
    {
      "fieldId": "export_3mf",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "3d",
    "additionalOutputKinds": ["image"],
    "config": {
      "operation": "image",
      "model": "meshy-v7/text-to-3d",
      "parameters": {
        "prompt": "prompt",
        "mode": "generation_mode",
        "ultra_mode": "detailed_geometry",
        "enable_pbr": "pbr",
        "texture_resolution": "texture_resolution",
        "texture_prompt": "texture_prompt",
        "should_remesh": "remesh",
        "topology": "topology",
        "target_polycount": "face_target",
        "decimation_mode": "decimation_level",
        "pose_mode": "pose",
        "auto_size": "real_world_scale",
        "origin_at": "origin",
        "alpha_thumbnail": "transparent_preview",
        "moderation": "moderation"
      },
      "text_max_lengths": {
        "texture_prompt": 800,
        "prompt": 800
      },
      "media": {
        "texture_image": {
          "kind": "image",
          "fields": ["texture_image"],
          "content_types": ["image/png", "image/jpeg"]
        }
      },
      "choice_arrays": {
        "target_formats": {
          "min_items": 1,
          "options": [
            {
              "value": "glb",
              "field": "export_glb"
            },
            {
              "value": "obj",
              "field": "export_obj"
            },
            {
              "value": "fbx",
              "field": "export_fbx"
            },
            {
              "value": "stl",
              "field": "export_stl"
            },
            {
              "value": "usdz",
              "field": "export_usdz"
            },
            {
              "value": "3mf",
              "field": "export_3mf"
            }
          ]
        }
      },
      "enabled_by": {
        "enable_pbr": {
          "parameter": "mode",
          "equals": "full"
        },
        "texture_resolution": {
          "parameter": "mode",
          "equals": "full"
        },
        "texture_prompt": {
          "parameter": "mode",
          "equals": "full"
        },
        "texture_image": {
          "parameter": "mode",
          "equals": "full"
        },
        "topology": "should_remesh",
        "target_polycount": "should_remesh",
        "decimation_mode": "should_remesh",
        "origin_at": "auto_size"
      },
      "required_text": ["prompt"]
    }
  },
