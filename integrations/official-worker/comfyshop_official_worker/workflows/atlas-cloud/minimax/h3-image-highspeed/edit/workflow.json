  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "minimax/h3-image-highspeed/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "image_size",
        "num_images": "image_count",
        "output_format": "output_format",
        "output_compression": "compression_quality",
        "enable_sync_mode": "synchronous_response",
        "enable_base64_output": "base64_output"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 32000
      },
      "image_size_limits": {
        "min_side": 468,
        "max_side": 7745,
        "min_pixels": 655360,
        "max_pixels": 20000000,
        "max_aspect_ratio": 3
      },
      "media": {
        "reference_images": {
          "kind": "image",
          "array": true,
          "min_items": 1,
          "fields": [
            "reference_1",
            "reference_2",
            "reference_3",
            "reference_4",
            "reference_5",
            "reference_6",
            "reference_7",
            "reference_8",
