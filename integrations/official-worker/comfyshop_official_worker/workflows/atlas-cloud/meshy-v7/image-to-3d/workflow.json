    "en": {
      "name": "Meshy v7 Image-to-3D",
      "description": "Reconstruct a 3D model from one image with controls for texturing, remeshing, and export.",
      "fields": {
        "reference_image": {
          "label": "Reference image"
        },
        "textured": {
          "label": "Generate textures"
        },
        "detailed_geometry": {
          "label": "Detailed geometry"
        },
