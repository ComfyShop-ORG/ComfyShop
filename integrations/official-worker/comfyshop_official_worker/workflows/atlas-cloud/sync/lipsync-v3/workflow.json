{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-sync-lips",
  "name": "Sync Lipsync v3 视频对口型",
  "description": "用新音频重做原视频的口型，可选择音视频时长不同时的处理方式。",
  "category": "video_tool",
  "fields": [
    {
      "name": "source_video",
      "kind": "video",
      "optional": true
    },
    {
      "name": "driving_audio",
      "kind": "audio",
      "optional": true
    },
    {
      "name": "sync_mode",
      "kind": "choice",
      "default": "cut_off",
      "choices": ["cut_off", "loop", "bounce", "silence", "remap"]
    },
    {
      "name": "video_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "audio_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "source_video",
      "section": "default"
    },
    {
      "fieldId": "driving_audio",
      "section": "default"
    },
    {
      "fieldId": "sync_mode",
      "section": "default"
    },
    {
      "fieldId": "video_source",
      "section": "advanced"
    },
    {
      "fieldId": "audio_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "sync/lipsync-v3",
      "operation": "video",
      "parameters": {
        "sync_mode": "sync_mode"
      },
      "prediction_endpoint": "result",
      "media": {
        "video_url": {
          "kind": "video",
          "fields": ["source_video"],
          "min_items": 1,
          "external_sources_field": "video_source",
          "allow_raw_base64": true,
          "content_types": ["video/mp4", "video/quicktime", "video/webm"]
        },
        "audio_url": {
          "kind": "audio",
          "fields": ["driving_audio"],
          "min_items": 1,
          "external_sources_field": "audio_source",
          "allow_raw_base64": true,
          "content_types": [
            "audio/wav",
            "audio/wave",
            "audio/x-wav",
            "audio/mpeg",
            "audio/mp3",
            "audio/mp4"
          ]
        }
      }
    }
  },
