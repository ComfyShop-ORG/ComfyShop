        "seed": {
          "help": "填 -1 时随机，也可填整数帮助复现。"
        },
        "enable_sync_mode": {
          "help": "等待 Atlas 完成后在提交响应中取结果。"
        },
        "enable_base64_output": {
          "help": "要求 Atlas 以 Base64 返回图片。工作机解码后保存图片原件。"
        }
      }
