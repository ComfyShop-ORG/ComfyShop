            "reference_10",
            "reference_11",
            "reference_12",
            "reference_13",
            "reference_14",
            "reference_15",
            "reference_16"
          ],
          "content_types": ["image/png", "image/jpeg", "image/webp"],
          "max_bytes": 67108864,
          "image_bounds": {
            "min_side": 128,
            "max_side": 8192,
            "max_aspect_ratio": 4
          }
        }
      }
    }
  },
