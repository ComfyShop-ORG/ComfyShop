{
  "format": "service",
  "workerKind": "official",
  "key": "seedream-v55-text",
  "name": "Seedream v5.5 文生图",
  "description": "按提示词生成一张图片，可选择 1K、1.5K 或 2K 尺寸，并支持原生透明 PNG。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "choices": [
        "2048*2048",
        "2368*1776",
        "1776*2368",
        "2816*1584",
        "1584*2816",
        "2496*1664",
        "1664*2496",
        "3136*1344",
        "1536*1536",
        "1792*1344",
        "1344*1792",
        "2048*1152",
        "1152*2048",
        "1872*1248",
        "1248*1872",
        "2352*1008",
        "1024*1024",
        "1152*864",
        "864*1152",
        "1424*800",
        "800*1424",
        "1248*832",
        "832*1248",
        "1568*672"
      ],
      "default": "2048*2048"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "choices": ["png", "jpeg"],
      "default": "png"
    },
    {
      "name": "background",
      "kind": "choice",
      "optional": true,
      "default": "auto",
      "choices": ["auto", "transparent", "opaque"]
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "advanced"
    },
    {
      "fieldId": "background",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "bytedance/seedream-v5.5/text-to-image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "output_format": "output_format",
        "enable_base64_output": "enable_base64_output",
        "background": "background",
        "enable_sync_mode": "enable_sync_mode"
      },
      "required_text": ["prompt"],
      "choice_constraints": {
        "output_format": {
          "parameter": "background",
          "values": {
            "transparent": "png"
          }
        }
      },
      "required_when": {
        "output_format": {
          "background": ["transparent"]
        }
      }
    },
    "additionalOutputKinds": ["text"]
  },
