        "seed": {
          "help": "-1 为随机。指定整数可重用种子。"
        },
        "enable_sync_mode": {
          "help": "等待成品上传后由提交请求直接返回结果。"
        },
        "enable_base64_output": {
          "help": "以 Base64 返回图片，工作机解码后保存。"
        }
      }
    },
