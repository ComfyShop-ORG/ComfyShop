{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-atlascloud-infinitetalk",
  "name": "Atlas Cloud InfiniteTalk 语音驱动视频",
  "description": "用一张人物图片和一段语音生成口型同步视频，可描述表情与姿势。",
  "category": "video",
  "fields": [
    {
      "name": "portrait",
      "kind": "image",
      "optional": true
    },
    {
      "name": "voice",
      "kind": "audio",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "optional": true,
      "multiline": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "480p",
      "choices": ["480p", "720p"],
      "optional": true
    },
    {
      "name": "portrait_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "voice_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "portrait",
      "section": "default"
    },
    {
      "fieldId": "voice",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "portrait_source",
      "section": "advanced"
    },
    {
      "fieldId": "voice_source",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "atlascloud/infinitetalk",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "seed": "seed"
      },
      "omit_blank_parameters": ["prompt"],
      "prediction_timeout_seconds": 21600,
      "media": {
        "image": {
          "kind": "image",
          "fields": ["portrait"],
          "external_sources_field": "portrait_source",
          "external_urls_only": true,
          "min_items": 1
        },
        "audio": {
          "kind": "audio",
          "fields": ["voice"],
          "external_sources_field": "voice_source",
          "external_urls_only": true,
          "min_items": 1,
          "content_types": ["audio/wav", "audio/mpeg"],
          "max_duration_ms": 600000
        }
      }
    }
  },
  "translations": {
