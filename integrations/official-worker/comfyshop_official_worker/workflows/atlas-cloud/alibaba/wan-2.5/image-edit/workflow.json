    {
      "name": "negative_prompt",
      "optional": true,
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 500
    },
    {
      "name": "enable_prompt_expansion",
      "optional": true,
      "kind": "boolean",
      "default": true
    },
    {
      "name": "reference_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "reference_1",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "custom_size",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "enable_prompt_expansion",
      "section": "advanced"
    },
    {
      "fieldId": "reference_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_3",
      "section": "advanced"
    },
    {
      "fieldId": "reference_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "alibaba/wan-2.5/image-edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "seed": "seed",
        "negative_prompt": "negative_prompt",
        "enable_prompt_expansion": "enable_prompt_expansion"
      },
      "required_text": ["prompt"],
      "parameter_overrides": {
        "size": "custom_size"
      },
      "image_size_limits": {
        "allow_auto": false,
        "min_side": 1,
        "min_pixels": 589824,
        "max_pixels": 1638400,
        "max_aspect_ratio": 4,
        "preset_sizes": [
          "576*1344",
          "720*1280",
          "720*1680",
          "768*1024",
          "800*1200",
          "816*1904",
          "936*1664",
          "960*1280",
          "960*1440",
          "1024*768",
          "1024*1024",
          "1040*1560",
          "1104*1472",
          "1200*800",
          "1280*720",
          "1280*960",
          "1280*1280",
          "1344*576",
          "1440*960",
          "1472*1104",
          "1560*1040",
          "1664*936",
          "1680*720",
          "1904*816"
        ]
      },
      "omit_blank_parameters": ["negative_prompt"],
      "media": {
        "images": {
          "kind": "image",
          "fields": ["reference_1", "reference_2", "reference_3"],
          "array": true,
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png", "image/bmp", "image/webp"],
          "external_sources_field": "reference_sources",
          "max_bytes": 10000000,
          "image_bounds": {
            "min_side": 384,
            "max_side": 5000
          },
          "reject_png_alpha": true,
          "external_urls_only": true
        }
      }
    }
  },
