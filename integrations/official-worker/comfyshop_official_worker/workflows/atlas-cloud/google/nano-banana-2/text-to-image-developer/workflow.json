{
  "format": "service",
  "workerKind": "official",
  "key": "nano-banana-2-text-developer",
  "name": "Nano Banana 2 Developer 文生图",
  "description": "用提示词生成 1K、2K 或 4K 图片，可调思考档位、采样和网页搜索。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "optional": true,
      "default": "",
      "choices": ["", "1:1", "3:2", "2:3", "3:4", "4:3", "4:5", "5:4", "9:16", "16:9", "21:9"]
    },
    {
      "name": "resolution",
      "kind": "choice",
      "optional": true,
      "default": "1k",
      "choices": ["1k", "2k", "4k"]
    },
    {
      "name": "thinking_level",
      "kind": "choice",
      "optional": true,
      "default": "default",
      "choices": ["default", "high", "minimal"]
    },
    {
      "name": "enable_web_search",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "top_p",
      "kind": "number",
      "optional": true,
      "default": 0.95,
      "minimum": "0",
      "maximum": "1"
    },
    {
      "name": "temperature",
      "kind": "number",
      "optional": true,
      "default": 1,
      "minimum": "0",
      "maximum": "1"
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true,
      "default": -1
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "thinking_level",
      "section": "advanced"
    },
    {
      "fieldId": "enable_web_search",
      "section": "advanced"
    },
    {
      "fieldId": "top_p",
      "section": "advanced"
    },
    {
      "fieldId": "temperature",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "google/nano-banana-2/text-to-image-developer",
      "parameters": {
        "prompt": "prompt",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "thinking_level": "thinking_level",
        "enable_web_search": "enable_web_search",
        "top_p": "top_p",
        "temperature": "temperature",
        "seed": "seed",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["aspect_ratio"]
    }
  },
