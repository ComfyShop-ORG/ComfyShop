          "label": "扩写提示词"
        }
      },
      "parameterLayout": {
        "prompt": {
          "help": "描述主体、动作和场景，最多 2,000 字符。"
        },
        "expand_prompt": {
          "help": "开启后由模型在生成前优化提示词。"
        }
      }
    },
