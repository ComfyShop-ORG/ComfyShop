{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-vidu-2-reference-to-video",
  "name": "Vidu 2.0 参考生视频",
  "description": "用一至三张参考图生成视频，保持人物、物体和标识的外观一致。",
  "category": "video",
  "fields": [
    {
      "name": "reference_image_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "the girl walks from the painting to the room, put the coffee cup on the table",
      "multiline": true,
      "maxLength": 1500
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "choices": ["16:9", "9:16", "1:1"],
      "default": "16:9",
      "optional": true
    },
    {
      "name": "movement_amplitude",
      "kind": "choice",
      "default": "auto",
      "choices": ["auto", "small", "medium", "large"],
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": 0,
      "optional": true
    },
    {
      "name": "reference_image_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "image_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "reference_image_1",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "movement_amplitude",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_3",
      "section": "advanced"
    },
    {
      "fieldId": "image_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "vidu/reference-to-video-2.0",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "movement_amplitude": "movement_amplitude",
        "seed": "seed",
        "aspect_ratio": "aspect_ratio"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 1500
      },
      "media": {
        "images": {
          "kind": "image",
          "fields": ["reference_image_1", "reference_image_2", "reference_image_3"],
          "external_sources_field": "image_sources",
          "min_items": 1,
          "max_bytes": 50000000,
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "image_bounds": {
            "min_side": 128,
            "max_aspect_ratio_exclusive": 4
          },
          "array": true
        }
      }
    }
  },
  "translations": {
