      "name": "video",
      "kind": "video"
    },
    {
      "name": "template",
      "kind": "choice",
      "optional": true,
      "default": "anime-enhance-4k",
      "choices": [
        "live-action-enhance-720p",
        "live-action-enhance-1080p",
        "live-action-enhance-2k",
        "live-action-enhance-4k",
        "anime-enhance-720p",
        "anime-enhance-1080p",
        "anime-enhance-2k",
        "anime-enhance-4k",
        "restore-720p",
        "restore-1080p",
        "restore-2k",
        "restore-4k",
        "live-action-smallface-720p",
        "live-action-smallface-1080p",
        "live-action-smallface-2k",
        "live-action-smallface-4k",
        "anime-smallface-720p",
        "anime-smallface-1080p",
        "anime-smallface-2k",
        "anime-smallface-4k",
        "seedance2-enhance-720p",
        "seedance2-enhance-1080p",
        "seedance2-enhance-2k",
        "seedance2-enhance-4k"
      ]
    },
    {
      "name": "short",
      "kind": "integer",
      "optional": true,
      "default": 0,
      "minimum": "0",
      "maximum": "2160"
    },
    {
      "name": "fps",
      "kind": "integer",
      "optional": true,
      "minimum": "1"
    },
    {
      "name": "keep_metadata",
      "kind": "boolean",
      "optional": true,
      "default": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "video",
      "section": "default"
    },
    {
      "fieldId": "template",
      "section": "default"
    },
    {
      "fieldId": "short",
      "section": "advanced"
    },
    {
      "fieldId": "fps",
      "section": "advanced"
    },
    {
      "fieldId": "keep_metadata",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "operation": "video",
      "model": "tencent/video/upscaler",
      "prediction_endpoint": "result",
      "parameters": {
        "template": "template",
        "short": "short",
        "fps": "fps",
        "keep_metadata": "keep_metadata"
      },
      "media": {
        "video_url": {
          "kind": "video",
          "fields": ["video"],
          "min_items": 1
        }
      },
      "choice_bounds": {
        "short": {
          "parameter": "template",
          "ranges": {
            "live-action-enhance-720p": [0, 720],
            "live-action-enhance-1080p": [721, 1080],
            "live-action-enhance-2k": [1081, 1440],
            "live-action-enhance-4k": [1441, 2160],
            "anime-enhance-720p": [0, 720],
            "anime-enhance-1080p": [721, 1080],
            "anime-enhance-2k": [1081, 1440],
            "anime-enhance-4k": [1441, 2160],
            "restore-720p": [0, 720],
            "restore-1080p": [721, 1080],
            "restore-2k": [1081, 1440],
            "restore-4k": [1441, 2160],
            "live-action-smallface-720p": [0, 720],
            "live-action-smallface-1080p": [721, 1080],
            "live-action-smallface-2k": [1081, 1440],
            "live-action-smallface-4k": [1441, 2160],
            "anime-smallface-720p": [0, 720],
            "anime-smallface-1080p": [721, 1080],
            "anime-smallface-2k": [1081, 1440],
            "anime-smallface-4k": [1441, 2160],
            "seedance2-enhance-720p": [0, 720],
            "seedance2-enhance-1080p": [721, 1080],
            "seedance2-enhance-2k": [1081, 1440],
            "seedance2-enhance-4k": [1441, 2160]
          },
          "exceptions": [0]
        }
      }
    }
