{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-flux3-edit-video",
  "name": "FLUX 3 视频编辑",
  "description": "按文字指示重新渲染 MP4，保留原视频的动作、长度和分辨率。",
  "category": "video_tool",
  "fields": [
    {
      "name": "source_video",
      "kind": "video",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "video_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "safety_tolerance",
      "kind": "integer",
      "default": 2,
      "minimum": "0",
      "maximum": "4",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "source_video",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "video_source",
      "section": "advanced"
    },
    {
      "fieldId": "safety_tolerance",
      "section": "advanced",
      "control": "slider"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "black-forest-labs/flux-3/edit-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "safety_tolerance": "safety_tolerance"
      },
      "required_text": ["prompt"],
      "media": {
        "video_url": {
          "kind": "video",
          "fields": ["source_video"],
          "external_sources_field": "video_source",
          "external_urls_only": true,
          "content_types": ["video/mp4"],
          "max_duration_ms": 14999,
          "min_items": 1,
          "max_bytes": 49999999
        }
      }
    }
  },
  "translations": {
