      "parameterLayout": {
        "prompt": {
          "help": "描述要生成的物体、形状和材质，最多 1024 个字符。"
        },
        "negative_prompt": {
          "help": "描述希望在模型中避免的特征。"
        },
        "texture": {
          "help": "为网格生成纹理。"
        },
        "pbr": {
          "help": "生成基于物理的渲染材质。"
        },
        "texture_quality": {
          "help": "选择标准或精细纹理。"
        },
        "geometry_quality": {
          "help": "选择标准或精细几何结构。"
        },
        "face_limit": {
          "help": "输入 1000 至 2000000 个面。初始为空，由模型自适应决定。"
        },
        "model_seed": {
          "help": "指定用于复现几何的整数种子。"
        },
        "image_seed": {
          "help": "指定用于复现文字生成概念图步骤的整数种子。"
