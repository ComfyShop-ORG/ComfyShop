{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-google-gemini-omni-1-2-flash-text-to-video",
  "name": "Gemini Omni 1.2 Flash 文生视频",
  "description": "从文字生成带同步音频的视频，可设置时长、比例和分辨率。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 20000
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 10,
      "optional": true,
      "minimum": "3",
      "maximum": "15"
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "optional": true,
      "choices": ["16:9", "9:16"]
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "optional": true,
      "choices": ["360p", "720p", "1080p", "4k"]
    },
    {
      "name": "thinking_level",
      "kind": "choice",
      "default": "default",
      "optional": true,
      "choices": ["default", "high", "low"]
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "thinking_level",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "google/gemini-omni-1.2-flash/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "thinking_level": "thinking_level",
        "seed": "seed"
      },
      "required_text": ["prompt"]
    }
  },
