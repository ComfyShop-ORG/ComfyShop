{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-atlascloud-qwen-image-edit",
  "name": "Atlas Cloud Qwen Image 图像编辑",
  "description": "用文字指令编辑已有图片，可增删元素、调整物体或替换画面中的文字。",
  "category": "image_tool",
  "fields": [
    {
      "name": "image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "image_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "image",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "image_source",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "atlascloud/qwen-image/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "seed": "seed",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["image"],
          "external_sources_field": "image_source",
          "min_items": 1,
          "external_urls_only": true
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Atlas Cloud Qwen Image 图像编辑",
      "description": "用文字指令编辑已有图片，可增删元素、调整物体或替换画面中的文字。",
      "fields": {
        "image": {
          "label": "原图"
        },
        "prompt": {
          "label": "编辑指令"
        },
        "image_source": {
          "label": "原图来源"
        },
        "seed": {
          "label": "种子"
        },
        "enable_sync_mode": {
          "label": "同步响应"
