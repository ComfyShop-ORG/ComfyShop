        },
        "brand_story": {
          "help": "Present the brand's background, identity, or values."
        },
        "ratio": {
          "help": "Choose the width-to-height ratio. The default is 3:4."
        },
        "product_source": {
          "help": "Enter one public product image URL."
        },
        "model_source": {
          "help": "Enter one public model image URL."
        },
        "resolution": {
          "help": "Choose 1K, 2K, or 4K. The default is 2K."
