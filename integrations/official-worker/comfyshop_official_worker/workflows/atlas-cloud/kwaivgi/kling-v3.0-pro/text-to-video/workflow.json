      "parameterLayout": {
        "prompt": {
          "help": "描述画面主体、动作和运镜，最多 2,500 字符。未提供自定义分镜时必填。"
        },
        "aspect_ratio": {
          "help": "选择 16:9、9:16 或 1:1。默认 16:9。"
        },
        "duration": {
          "help": "选择 3 至 15 秒的整数时长。默认 5 秒。"
        },
        "multi_shot": {
          "help": "开启后可在高级参数输入自定义分镜。留空时模型根据提示词自动分镜。"
        },
        "multi_prompt": {
          "help": "开启多镜头后可填 1 至 6 项 JSON 数组。每项填写 prompt（最多 512 字符）和 duration（1 至 15 秒）。工作机按顺序生成 index 并将时长转为字符串。各段时长之和须等于总时长。"
        },
        "sound": {
          "help": "开启后生成同步声音。默认开启。"
        }
      }
