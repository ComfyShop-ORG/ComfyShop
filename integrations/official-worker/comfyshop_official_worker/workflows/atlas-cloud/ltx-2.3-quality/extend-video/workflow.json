{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-ltx23q-extend",
  "name": "LTX 2.3 Quality 视频延长",
  "description": "根据提示词在原视频前后生成新画面，可匹配原片帧率并生成音频。",
  "category": "video_tool",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "Continue the scene naturally, maintaining the same style, lighting, and motion dynamics",
      "maxLength": 2000
    },
    {
      "name": "num_frames",
      "kind": "integer",
      "minimum": "9",
      "maximum": "481",
      "step": "8",
      "optional": true,
      "default": 81
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": [
        "square_hd",
        "square",
        "portrait_3_4",
        "portrait_9_16",
        "landscape_4_3",
        "landscape_16_9"
      ],
      "optional": true,
      "default": "landscape_16_9"
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "seed",
      "kind": "integer",
      "minimum": "0",
      "optional": true
    },
    {
      "name": "source_video",
      "kind": "video",
      "optional": true,
      "additionalAssetKinds": ["image"]
    },
    {
      "name": "source_video_url",
      "kind": "string",
      "optional": true,
      "default": ""
    },
    {
      "name": "extend_direction",
      "kind": "choice",
      "choices": ["forward", "backward"],
      "optional": true,
      "default": "forward"
    },
    {
      "name": "match_input_fps",
      "kind": "boolean",
      "optional": true,
      "default": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "source_video",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "extend_direction",
      "section": "default"
    },
    {
      "fieldId": "num_frames",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "match_input_fps",
      "section": "advanced"
    },
    {
      "fieldId": "source_video_url",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "ltx-2.3-quality/extend-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "num_frames": "num_frames",
        "resolution": "resolution",
        "generate_audio": "generate_audio",
        "seed": "seed",
        "extend_direction": "extend_direction",
        "match_input_fps": "match_input_fps"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 2000
      },
      "media": {
        "video_url": {
          "kind": "video",
          "fields": ["source_video"],
          "external_sources_field": "source_video_url",
          "external_urls_only": true,
          "min_items": 1,
          "content_types": [
            "video/mp4",
            "video/quicktime",
            "video/webm",
            "video/x-m4v",
            "image/gif"
          ]
        }
      }
    }
  },
  "translations": {
