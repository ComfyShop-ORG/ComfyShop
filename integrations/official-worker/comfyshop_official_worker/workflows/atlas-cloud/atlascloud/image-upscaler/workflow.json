{
  "format": "service",
  "workerKind": "official",
  "key": "atlascloud-image-upscaler",
  "name": "Atlas Cloud 图片放大",
  "description": "将图片放大至最多 4 倍，保留原图构图并增强纹理。",
  "category": "image_tool",
  "fields": [
    {
      "name": "image",
      "kind": "image"
    },
    {
      "name": "outscale",
      "kind": "number",
      "optional": true,
      "default": 1,
      "minimum": "1",
      "maximum": "4"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "jpeg",
      "choices": ["jpeg", "png", "webp", "jpg"]
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "image",
      "section": "default"
    },
    {
      "fieldId": "outscale",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "atlascloud/image-upscaler",
      "parameters": {
        "outscale": "outscale",
        "output_format": "output_format"
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["image"],
          "min_items": 1
        }
      }
    }
  },
  "translations": {
