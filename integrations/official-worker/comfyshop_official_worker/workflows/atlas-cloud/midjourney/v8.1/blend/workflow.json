      "kind": "integer",
      "optional": true,
      "default": 0,
      "minimum": "0",
      "maximum": "1000"
    },
    {
      "name": "chaos",
      "kind": "integer",
      "optional": true,
      "default": 0,
      "minimum": "0",
      "maximum": "100"
    },
    {
      "name": "weird",
      "kind": "integer",
      "optional": true,
      "default": 0,
      "minimum": "0",
      "maximum": "3000"
    },
    {
      "name": "quality",
      "kind": "choice",
      "choices": [1, 4],
      "optional": true,
      "default": 1
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true,
      "default": -1
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "reference_image_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_4",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_5",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "reference_image_1",
      "section": "default"
    },
    {
      "fieldId": "reference_image_2",
      "section": "default"
    },
    {
      "fieldId": "reference_image_3",
      "section": "default"
