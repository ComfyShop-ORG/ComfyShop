{
  "format": "service",
  "workerKind": "official",
  "key": "gpt-image-25-flare-developer-text",
  "name": "GPT Image 2.5 Flare Developer 文生图",
  "description": "使用 Developer 接口从提示词生成图片，支持自定义尺寸、透明背景和最多 10 张成品。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "maxLength": 32000,
      "default": "A neon-lit ramen stall on a rainy Tokyo street, cinematic wide shot."
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "default": "1024x1024",
      "choices": [
        "auto",
        "1024x1024",
        "1024x768",
        "768x1024",
        "1024x1536",
        "1536x1024",
        "2048x2048",
        "2048x1152",
        "1152x2048",
        "2560x1088",
        "1088x2560",
        "2880x2160",
        "2160x2880",
        "3840x2160",
        "2160x3840"
      ]
    },
    {
      "name": "custom_size",
      "kind": "string",
      "optional": true,
      "default": "",
      "maxLength": 9
    },
    {
      "name": "background",
      "kind": "choice",
      "optional": true,
      "default": "auto",
      "choices": ["auto", "opaque", "transparent"]
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "png",
      "choices": ["png", "jpeg", "webp"]
    },
    {
      "name": "moderation",
      "kind": "choice",
      "optional": true,
      "default": "auto",
      "choices": ["auto", "low"]
    },
    {
      "name": "n",
      "kind": "integer",
      "optional": true,
      "default": 1,
      "minimum": "1",
      "maximum": "10"
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "custom_size",
      "section": "advanced"
    },
    {
      "fieldId": "background",
      "section": "advanced"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "moderation",
      "section": "advanced"
    },
    {
      "fieldId": "n",
      "section": "default"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "openai/gpt-image-2.5-flare-developer/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "background": "background",
        "output_format": "output_format",
        "moderation": "moderation",
        "n": "n"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 32000
      },
      "parameter_overrides": {
        "size": "custom_size"
      },
      "image_size_limits": {
        "min_side": 256,
        "max_side": 3840,
        "min_pixels": 65536,
        "max_pixels": 8294400,
        "max_aspect_ratio": 3,
        "separator": "x",
        "side_multiple": 16
      },
      "choice_constraints": {
        "output_format": {
          "parameter": "background",
          "values": {
            "transparent": ["png", "webp"]
          }
        }
      }
    }
  },
