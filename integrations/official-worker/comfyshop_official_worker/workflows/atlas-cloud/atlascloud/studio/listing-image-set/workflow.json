    {
      "name": "model_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "user_prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": true
    },
    {
      "name": "main_image",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "multi_angle",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "detail_shot",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "feature_image",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "size_specs",
