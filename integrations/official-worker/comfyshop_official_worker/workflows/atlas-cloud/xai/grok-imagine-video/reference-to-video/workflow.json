{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-grok-video-reference-to-video",
  "name": "Grok Imagine Video 参考生视频",
  "description": "用 1 至 7 张参考图和文字生成最长 10 秒的视频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "duration_seconds",
      "kind": "integer",
      "default": 8,
      "minimum": "1",
      "maximum": "10",
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "choices": ["480p", "720p"],
      "optional": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "choices": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"],
      "optional": true
    },
    {
      "name": "reference_image_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_4",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_5",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_6",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_7",
      "kind": "image",
      "optional": true
    },
    {
      "name": "image_sources",
      "kind": "string",
      "default": "",
      "optional": true,
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "reference_image_1",
      "section": "default"
    },
    {
      "fieldId": "duration_seconds",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "reference_image_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_3",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_4",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_5",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_6",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_7",
      "section": "advanced"
    },
    {
      "fieldId": "image_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "xai/grok-imagine-video/reference-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "resolution": "resolution",
        "aspect_ratio": "aspect_ratio"
      },
      "required_text": ["prompt"],
      "media": {
        "image_urls": {
          "kind": "image",
          "array": true,
          "fields": [
            "reference_image_1",
            "reference_image_2",
            "reference_image_3",
            "reference_image_4",
            "reference_image_5",
            "reference_image_6",
            "reference_image_7"
          ],
          "external_sources_field": "image_sources",
          "min_items": 1,
          "external_https_only": true,
          "content_types": ["image/jpeg", "image/png", "image/webp"]
        }
      }
    }
  },
