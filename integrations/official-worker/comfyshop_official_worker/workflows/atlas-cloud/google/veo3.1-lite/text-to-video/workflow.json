{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-google-veo3-1-lite-text-to-video",
  "name": "Veo 3.1 Lite 文生视频",
  "description": "根据描述生成 720p 或 1080p 视频，可在提示词中描述对白、音效和环境声。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 8,
      "optional": true,
      "choices": [4, 6, 8]
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "optional": true,
      "choices": ["16:9", "9:16"]
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "optional": true,
      "choices": ["720p", "1080p"]
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "google/veo3.1-lite/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "choice_bounds": {
        "duration": {
          "parameter": "resolution",
          "ranges": {
            "1080p": [8, 8]
          }
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Veo 3.1 Lite 文生视频",
