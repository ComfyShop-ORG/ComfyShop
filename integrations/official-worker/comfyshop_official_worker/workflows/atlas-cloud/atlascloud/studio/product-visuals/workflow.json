        "model_source": {
          "help": "填写一个可公开访问的模特图片 URL。"
        },
        "count": {
          "help": "选择 1 至 4 张。默认 1 张。"
        },
        "resolution": {
          "help": "选择 1K、2K 或 4K。默认 2K。实际尺寸随比例变化，3:4 与 4:3 没有中间像素档，1:1 上限为 2048 像素。"
        },
        "format": {
          "help": "选择 PNG 或 JPEG。默认 PNG。"
        }
      }
    },
