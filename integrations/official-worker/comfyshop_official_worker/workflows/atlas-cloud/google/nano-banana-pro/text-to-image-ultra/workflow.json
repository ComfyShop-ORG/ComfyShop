{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-google-nano-banana-pro-text-to-image-ultra",
  "name": "Nano Banana Pro Ultra 文生图",
  "description": "用文字生成 4K 或 8K 图片，可选择输出比例及格式。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "optional": true,
      "default": "",
      "choices": ["", "1:1", "3:2", "2:3", "3:4", "4:3", "4:5", "5:4", "9:16", "16:9", "21:9"]
    },
    {
      "name": "resolution",
      "kind": "choice",
      "optional": true,
      "default": "4k",
      "choices": ["4k", "8k"]
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "jpeg",
      "choices": ["png", "jpeg"]
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "google/nano-banana-pro/text-to-image-ultra",
      "parameters": {
        "prompt": "prompt",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output",
        "output_format": "output_format"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["aspect_ratio"]
    }
  },
