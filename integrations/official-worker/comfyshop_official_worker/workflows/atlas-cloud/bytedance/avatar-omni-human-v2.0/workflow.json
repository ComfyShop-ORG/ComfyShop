{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-omnihuman-20",
  "name": "OmniHuman 2.0 音频驱动人像",
  "description": "用一张图片和一段说话或唱歌音频生成视频，视频时长跟随音频。",
  "category": "video",
  "fields": [
    {
      "name": "portrait",
      "kind": "image",
      "optional": true
    },
    {
      "name": "driving_audio",
      "kind": "audio",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": true
    },
    {
      "name": "portrait_source",
      "kind": "string",
      "default": "",
      "optional": true,
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "audio_source",
      "kind": "string",
      "default": "",
      "optional": true,
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "add_watermark",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "portrait",
      "section": "default"
    },
    {
      "fieldId": "driving_audio",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "advanced"
    },
    {
      "fieldId": "portrait_source",
      "section": "advanced"
    },
    {
      "fieldId": "audio_source",
      "section": "advanced"
    },
    {
      "fieldId": "add_watermark",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "bytedance/avatar-omni-human-v2.0",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "watermark": "add_watermark"
      },
      "omit_blank_parameters": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["portrait"],
          "external_sources_field": "portrait_source",
          "min_items": 1,
          "allow_raw_base64": true,
          "content_types": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/bmp",
            "image/tiff",
            "image/gif",
            "image/heic",
            "image/heif"
          ],
          "max_bytes": 29999999,
          "image_bounds": {
            "min_side": 300,
            "max_side": 6000,
            "aspect_ratio_range": [0.4, 2.5]
          }
        },
        "audio": {
          "kind": "audio",
          "fields": ["driving_audio"],
          "external_sources_field": "audio_source",
          "min_items": 1,
          "allow_raw_base64": true,
          "content_types": ["audio/mpeg", "audio/mp3", "audio/wav", "audio/wave", "audio/x-wav"],
          "max_bytes": 14999999,
          "min_duration_ms": 4000,
          "max_duration_ms": 300000
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "OmniHuman 2.0 音频驱动人像",
      "description": "用一张图片和一段说话或唱歌音频生成视频，视频时长跟随音频。",
      "fields": {
        "portrait": {
          "label": "人像"
        },
        "driving_audio": {
          "label": "驱动音频"
        },
        "prompt": {
          "label": "提示词"
        },
        "portrait_source": {
          "label": "人像来源"
        },
        "audio_source": {
          "label": "音频来源"
        },
        "add_watermark": {
          "label": "添加水印"
        }
      },
      "parameterLayout": {
        "portrait": {
          "help": "上传 JPEG、PNG、WebP、BMP、TIFF、GIF、HEIC 或 HEIF，尺寸和比例限制见模型说明。"
        },
        "driving_audio": {
          "help": "上传 4 至 300 秒的 WAV 或 MP3，小于 15 MB。"
        },
        "prompt": {
          "help": "可描述场景、动作、手势和镜头。支持中文、英文、日文、韩文、墨西哥西班牙语和印尼语。"
        },
        "portrait_source": {
          "help": "可填写公开 HTTP(S) 图片地址或 Base64，与上传二选一。"
        },
        "audio_source": {
          "help": "可填写公开 HTTP(S) WAV 或 MP3 地址或 Base64，与上传二选一。"
        },
        "add_watermark": {
          "help": "为输出视频添加水印。"
        }
      }
    },
