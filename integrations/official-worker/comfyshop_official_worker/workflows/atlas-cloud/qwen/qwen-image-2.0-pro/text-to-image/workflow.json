      "fields": {
        "prompt": {
          "label": "提示词"
        },
        "size": {
          "label": "输出尺寸"
        },
        "seed": {
          "label": "随机种子"
        }
      },
      "parameterLayout": {
        "prompt": {
          "help": "用中文或英文描述画面，最多 800 字符。"
        },
        "size": {
          "help": "输入宽*高，宽、高均为 512 至 2,048 像素，默认 1024*1024。"
        },
        "seed": {
          "help": "-1 为随机。可填写 0 至 2,147,483,647 的整数以复用种子。"
        }
      }
    },
    "zh-tw": {
