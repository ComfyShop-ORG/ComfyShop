{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-luma-ray32-reframe",
  "name": "Luma Ray 3.2 视频重构画幅",
  "description": "把原视频重构为指定宽高比，可用提示词说明要保留的主体和位置。",
  "category": "video_tool",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": ["540p", "720p", "1080p"],
      "optional": true,
      "default": "720p"
    },
    {
      "name": "source_video",
      "kind": "video",
      "optional": true
    },
    {
      "name": "source_video_url",
      "kind": "string",
      "optional": true,
      "default": ""
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "choices": ["16:9", "9:16", "1:1", "4:3", "3:4", "21:9", "9:21"],
      "optional": false,
      "default": "9:16"
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "source_video",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "source_video_url",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "luma/ray-3.2/reframe",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution"
      },
      "media": {
        "video": {
          "kind": "video",
          "fields": ["source_video"],
          "external_sources_field": "source_video_url",
          "external_urls_only": true,
          "external_https_only": true,
          "min_items": 1,
          "content_types": ["video/mp4"]
        }
      }
    }
  },
  "translations": {
