{
  "format": "service",
  "workerKind": "official",
  "key": "xai-stt-v1",
  "name": "xAI STT v1 语音转文字",
  "description": "从音频或视频提取文字和单词级时间戳，支持说话人区分和分声道转写。",
  "category": "audio",
  "fields": [
    {
      "name": "source_audio",
      "kind": "audio",
      "additionalAssetKinds": ["video"]
    },
    {
      "name": "normalize_numbers",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "language",
      "kind": "choice",
      "optional": true,
      "choices": [
        "ar",
        "cs",
        "da",
        "nl",
        "en",
        "fil",
        "fr",
        "de",
        "hi",
        "id",
        "it",
        "ja",
        "ko",
        "mk",
        "ms",
        "fa",
        "pl",
        "pt",
        "ro",
        "ru",
        "es",
        "sv",
        "th",
        "tr",
        "vi"
      ]
    },
    {
      "name": "key_terms",
      "kind": "string",
      "optional": true,
      "multiline": true
    },
    {
      "name": "diarize",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "keep_fillers",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "audio_format",
      "kind": "choice",
      "optional": true,
      "choices": ["auto", "pcm", "mulaw", "alaw"],
      "default": "auto"
    },
    {
      "name": "sample_rate",
      "kind": "choice",
      "optional": true,
      "choices": [8000, 16000, 22050, 24000, 44100, 48000]
    },
    {
      "name": "multichannel",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "channels",
      "kind": "integer",
      "optional": true,
      "minimum": "2",
      "maximum": "8",
      "step": "1"
    },
    {
      "name": "sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "source_audio",
      "section": "default"
    },
    {
      "fieldId": "normalize_numbers",
      "section": "default"
    },
    {
      "fieldId": "language",
      "section": "default"
    },
    {
      "fieldId": "key_terms",
      "section": "default"
    },
    {
      "fieldId": "diarize",
      "section": "advanced"
    },
    {
      "fieldId": "keep_fillers",
      "section": "advanced"
    },
    {
      "fieldId": "audio_format",
      "section": "advanced"
    },
    {
      "fieldId": "sample_rate",
      "section": "advanced"
    },
    {
      "fieldId": "multichannel",
      "section": "advanced"
    },
    {
      "fieldId": "channels",
      "section": "advanced"
    },
    {
      "fieldId": "sync_mode",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "text",
    "config": {
      "operation": "audio",
      "model": "xai/stt-v1",
      "parameters": {
        "text_normalization": "normalize_numbers",
        "language": "language",
        "diarize": "diarize",
        "filler_words": "keep_fillers",
        "audio_format": "audio_format",
        "sample_rate": "sample_rate",
        "multichannel": "multichannel",
        "channels": "channels",
        "enable_sync_mode": "sync_mode"
      },
      "text_arrays": {
        "keyterm": {
          "field": "key_terms",
          "max_items": 100,
          "max_item_length": 50
        }
      },
      "required_when": {
        "language": {
          "text_normalization": true
        },
        "sample_rate": {
          "audio_format": ["pcm", "mulaw", "alaw"]
        },
        "channels": {
          "audio_format": ["pcm", "mulaw", "alaw"],
          "multichannel": true
        }
      },
      "media": {
        "audio": {
          "kind": "audio",
          "fields": ["source_audio"],
          "min_items": 1,
          "content_types": [
            "audio/aac",
            "audio/flac",
            "audio/mp4",
            "audio/mpeg",
            "audio/ogg",
            "audio/wav",
            "audio/webm",
            "audio/x-matroska",
            "video/mp4",
            "video/webm",
            "video/x-matroska",
            "audio/x-pcm",
            "audio/x-mulaw",
            "audio/x-alaw"
          ],
          "max_bytes": 500000000,
          "format": {
            "parameter": "audio_format",
            "content_types": {
              "auto": [
                "audio/aac",
                "audio/flac",
                "audio/mp4",
                "audio/mpeg",
                "audio/ogg",
                "audio/wav",
                "audio/webm",
                "audio/x-matroska",
                "video/mp4",
                "video/webm",
                "video/x-matroska"
              ],
              "pcm": "audio/x-pcm",
              "mulaw": "audio/x-mulaw",
              "alaw": "audio/x-alaw"
            },
            "default": "auto"
          }
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "xAI STT v1 语音转文字",
      "description": "从音频或视频提取文字和单词级时间戳，支持说话人区分和分声道转写。",
      "fields": {
        "source_audio": {
          "label": "音频或视频"
        },
        "normalize_numbers": {
          "label": "数字和单位规范化"
        },
        "language": {
          "label": "识别语言"
        },
        "key_terms": {
          "label": "识别热词"
        },
        "diarize": {
          "label": "区分说话人"
        },
        "keep_fillers": {
          "label": "保留口头语"
        },
        "audio_format": {
          "label": "裸音频编码"
        },
        "sample_rate": {
          "label": "采样率"
        },
        "multichannel": {
          "label": "分声道转写"
        },
        "channels": {
          "label": "声道数"
        },
        "sync_mode": {
          "label": "同步返回"
        }
      },
      "parameterLayout": {
        "source_audio": {
          "help": "上传包含音轨的音频或视频。支持 MP3、WAV、M4A、FLAC、OGG、Opus、AAC、MP4 和 MKV，也可上传裸音频。"
        },
        "normalize_numbers": {
          "help": "把口述数字、货币和单位转为常用书写形式。开启后需要选择语言。"
        },
        "language": {
          "help": "留空自动识别。开启数字和单位规范化时，所选语言决定书写规则。"
        },
        "key_terms": {
          "help": "每行填写一个词组，最多 100 个，每个最多 50 字符。空行会跳过。"
        },
        "diarize": {
          "help": "为转写词语标记说话人。默认关闭。"
        },
        "keep_fillers": {
          "help": "开启后保留停顿词和语气词。默认移除。"
        },
        "audio_format": {
          "help": "容器文件使用 auto。裸音频选择 PCM、G.711 μ-law 或 G.711 A-law。使用 .raw 或 .pcm、.mulaw 或 .ulaw、.alaw 对应的扩展名。"
        },
        "sample_rate": {
          "help": "裸音频必填。按原件填写采样率，单位为 Hz。"
        },
        "multichannel": {
          "help": "分别转写各声道，最多 8 声道。默认关闭。"
        },
        "channels": {
          "help": "分声道转写裸音频时填写 2 至 8。容器文件会自动识别。"
        },
        "sync_mode": {
          "help": "开启后优先从提交响应读取结果。默认关闭。"
        }
      }
    },
    "zh-tw": {
      "name": "xAI STT v1 語音轉文字",
