          "help": "Choose a 1K, 1.5K, or 2K width and height preset in pixels. Select output dimensions. Choose a matching aspect ratio to keep the reference proportions."
        },
        "output_format": {
          "help": "Choose PNG or JPEG. JPEG results are always opaque."
        },
        "background": {
          "help": "Auto chooses the background from the prompt and output format. Transparency requires PNG."
