    "en": {
      "name": "MiniMax Music 3.0 Music Generation",
      "description": "Create songs from a musical description and lyrics. Generate lyrics automatically or make an instrumental track.",
      "fields": {
        "prompt": {
          "label": "Musical description"
        },
        "lyrics": {
          "label": "Lyrics"
        },
        "instrumental": {
          "label": "Instrumental"
        },
        "automatic_lyrics": {
          "label": "Write lyrics automatically"
        },
        "format": {
          "label": "Output format"
        },
        "sample_rate": {
          "label": "Sample rate"
        },
        "bitrate": {
          "label": "MP3 bitrate"
        },
        "sync_mode": {
          "label": "Return synchronously"
        },
        "base64_output": {
          "label": "Base64 output"
        }
      },
      "parameterLayout": {
        "prompt": {
          "help": "Describe the style, tempo, instruments, and vocals in up to 2000 characters. Required for instrumental tracks and automatic lyrics."
        },
        "lyrics": {
          "help": "Enter up to 3500 characters, one lyric line at a time. Use tags such as [Verse] and [Chorus] to arrange sections. Leave blank for instrumental tracks or automatic lyrics."
        },
        "instrumental": {
          "help": "Generate instrumental music. Enter a musical description when enabled. Off by default."
        },
        "automatic_lyrics": {
          "help": "Write lyrics from the musical description. Clear Lyrics and turn off Instrumental to use this option. Off by default."
        },
        "format": {
          "help": "Export MP3, WAV, or PCM. The default is MP3."
        },
        "sample_rate": {
          "help": "Select the output sample rate. The default is 44100 Hz."
        },
        "bitrate": {
          "help": "Applies to MP3. The default is 256000 bit/s."
        },
        "sync_mode": {
          "help": "Read the result from the submission response when available. Off by default."
        },
        "base64_output": {
          "help": "The work machine decodes the returned audio. By default, it downloads audio from a link."
        }
      }
    },
    "ja": {
      "name": "MiniMax Music 3.0 音楽生成",
      "description": "曲の説明と歌詞から楽曲を生成します。歌詞の自動作成やインストゥルメンタルにも対応します。",
      "fields": {
        "prompt": {
          "label": "曲の説明"
        },
        "lyrics": {
          "label": "歌詞"
        },
        "instrumental": {
          "label": "インストゥルメンタル"
        },
        "automatic_lyrics": {
          "label": "歌詞を自動作成"
        },
        "format": {
          "label": "出力形式"
        },
        "sample_rate": {
          "label": "サンプリング周波数"
        },
        "bitrate": {
          "label": "MP3 ビットレート"
        },
        "sync_mode": {
          "label": "同期で返す"
