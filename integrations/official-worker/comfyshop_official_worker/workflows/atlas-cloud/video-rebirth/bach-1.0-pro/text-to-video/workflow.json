{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-bach-text",
  "name": "Bach 1.0 Pro 文生视频",
  "description": "根据提示词生成 5 至 16 秒的视频，可保留自动生成的音轨。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "A cinematic daytime street scene.",
      "maxLength": 6500
    },
    {
      "name": "duration",
      "kind": "integer",
      "minimum": "5",
      "maximum": "16",
      "optional": true,
      "default": 5
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": ["1080p", "4k"],
      "optional": true,
      "default": "1080p"
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "choices": ["16:9", "9:16", "4:3", "3:4", "21:9", "1:1"],
      "optional": true,
      "default": "16:9"
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "optional": true,
      "default": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "minimum": "1",
      "maximum": "100000",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "video-rebirth/bach-1.0-pro/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "resolution": "resolution",
        "aspect_ratio": "aspect_ratio",
        "generate_audio": "generate_audio",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 6500
      }
    }
  },
  "translations": {
    "zh": {
