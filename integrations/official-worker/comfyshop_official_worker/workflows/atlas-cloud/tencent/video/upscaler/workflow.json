{
  "format": "service",
  "workerKind": "official",
  "key": "tencent-video-upscaler",
  "name": "腾讯云视频超分",
  "description": "使用腾讯云 MPS 提升视频清晰度，可选择实拍、动漫、老片修复等模板。",
  "category": "video_tool",
  "fields": [
