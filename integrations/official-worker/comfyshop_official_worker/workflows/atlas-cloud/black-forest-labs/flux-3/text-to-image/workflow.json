{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-flux3-text-to-image",
  "name": "FLUX 3 文生图",
  "description": "按提示词生成图片，可选择自动画面比例和最高 4K 的分辨率。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "optional": true,
      "default": "auto",
      "choices": [
        "auto",
        "21:9",
        "2:1",
        "16:9",
        "3:2",
        "7:5",
        "4:3",
        "5:4",
        "1:1",
        "4:5",
        "3:4",
        "5:7",
        "2:3",
        "9:16",
        "1:2"
      ]
    },
    {
      "name": "resolution",
      "kind": "choice",
      "optional": true,
      "default": "1k",
      "choices": ["768sq", "1k", "2k", "4k"]
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "jpeg",
      "choices": ["jpeg", "png"]
    },
    {
      "name": "safety_tolerance",
      "kind": "integer",
      "default": 2,
      "minimum": "0",
      "maximum": "4",
      "optional": true
    },
    {
      "name": "enable_prompt_expansion",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "safety_tolerance",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "enable_prompt_expansion",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "black-forest-labs/flux-3/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "output_format": "output_format",
        "safety_tolerance": "safety_tolerance",
        "enable_prompt_expansion": "enable_prompt_expansion"
      },
      "required_text": ["prompt"]
    }
  },
