# 平台配置示例。直接启动 API 时从仓库根目录的 .env 读取。
# Docker Compose 用 .env 做变量替换，API 设置需通过服务的 environment 传入容器。

# API 文档标题和健康检查中的服务名称。
COMFYSHOP_APP_NAME="ComfyShop API"
# true 开启 FastAPI 调试输出，false 适合部署。
COMFYSHOP_DEBUG=false
# HTTPS 部署填 true，使会话 Cookie 只通过安全连接发送。局域网 HTTP 使用 false。
COMFYSHOP_COOKIE_SECURE=false

# 运行时语言回退。可选 zh、zh-tw、en、ja、ko，默认为 zh。
# COMFYSHOP_DEFAULT_LANGUAGE=zh
# 页头语言菜单按以下顺序展示简体中文和英文。省略时显示全部语言。
# COMFYSHOP_MENU_LANGUAGES=zh,en

# 三类工作机的 Loguru 日志级别，默认 INFO。
COMFYSHOP_WORKER_LOG_LEVEL=INFO

# 可选的官方工作机。实际凭据放在仓库外的私有环境文件。
# 工作机已配置服务凭据时，默认使用已注册的 ComfyShop 账号。
# COMFYSHOP_OFFICIAL_OWNER=ComfyShop
# COMFYSHOP_WORKER_SERVICE_TOKENS__OFFICIAL=<部署方生成的服务凭据，至少 32 字符>
# Compose 的官方工作机内网报价地址，设为空关闭入口。
# COMFYSHOP_OFFICIAL_QUOTE_URL=http://official-worker:8690/quote

# 启用 comfyui profile 时使用仓库外的私有目录，存放 worker.json 和运行状态。
# COMFYSHOP_COMFYUI_WORKER_DIR=/srv/comfyshop/comfyui-worker
# 让下面的 UID/GID 与该目录的读写权限匹配。
# COMFYSHOP_COMFYUI_WORKER_UID=10001
# COMFYSHOP_COMFYUI_WORKER_GID=10001

# 直接运行 API 的数据目录，默认 ~/.local/share/comfyshop。Compose 将数据卷挂在 /data。
# COMFYSHOP_DATA_DIR="/absolute/path/to/private/comfyshop-data"
# 数据库连接地址，省略时使用数据目录内的 comfyshop.db。以下是 SQLite 绝对路径示例。
# COMFYSHOP_DATABASE_URL="sqlite:////absolute/path/to/comfyshop.db"
# 局域网 PostgreSQL 示例。把 db.lan.example 换成 API 主机可访问的数据库局域网 IP 或主机名。
# 含凭据的实际连接地址保存在私有环境文件中。
# COMFYSHOP_DATABASE_URL="postgresql+psycopg://comfyshop:<password>@db.lan.example:5432/comfyshop"
# 原文件存储默认 local。使用外部 S3 时先建好私有存储桶，其余参数见 .env.team.example。
# COMFYSHOP_STORAGE_BACKEND=local
# 派生缓存的容量和有效期，默认每层 512 MiB、生成后 7 天。容量填 0 时按需生成。
# COMFYSHOP_DERIVATIVE_CACHE_MAX_BYTES=536870912
# COMFYSHOP_DERIVATIVE_CACHE_TTL_SECONDS=604800
# 直接运行 API 的网页构建产物目录，默认 dist。Compose 镜像使用 /app/dist。
# COMFYSHOP_STATIC_DIR="dist"

# JSON 字符串数组。默认 ["*"] 接收任意 Host，限制时填写主机名或 IP。
# COMFYSHOP_ALLOWED_HOSTS='["*"]'
# 来源检查允许同源。以下 JSON 数组是默认额外来源，每项包含协议、主机和端口。
# COMFYSHOP_ALLOWED_ORIGINS='["http://127.0.0.1:8688","http://localhost:8688","http://127.0.0.1:5173","http://localhost:5173"]'
# Compose 宿主机端口，整数 1–65535。容器内端口固定为 8688。
# COMFYSHOP_PORT=8688

# 浏览器会话有效期，默认 7 天，范围 60–2592000 秒。
# COMFYSHOP_SESSION_TTL_SECONDS=604800
# 工作机任务租约时长，每次有效任务心跳续期。范围 10–600 秒。
# COMFYSHOP_WORKER_LEASE_SECONDS=90

# 单个成品上限，默认 1 GiB，最小 1024 字节。
# COMFYSHOP_MAX_ARTIFACT_BYTES=1073741824
# 一次执行最多回传的成品数，范围 1–1024。
# COMFYSHOP_MAX_EXECUTION_ARTIFACTS=256
# 失败或取消执行的部分成品从执行结束起计，默认保留 24 小时，最短 60 秒。
# COMFYSHOP_FAILED_ARTIFACT_TTL_SECONDS=86400
# 单个输入素材上限，默认 256 MiB，最小 1024 字节。
# COMFYSHOP_MAX_ASSET_BYTES=268435456
# 输入素材的空间默认配额，默认 10 GiB，最小 1024 字节。
# COMFYSHOP_ASSET_QUOTA_BYTES=10737418240
# 按团队 ID 指定素材配额。值为字节数，以下为示例团队的 20 GiB 上限。
# COMFYSHOP_TEAM_ASSET_QUOTA_BYTES='{"11111111-1111-4111-8111-111111111111":21474836480}'
# 未绑定素材从上传起计，默认保留 24 小时，最短 60 秒。
# COMFYSHOP_UNUSED_ASSET_TTL_SECONDS=86400

# 媒体工具的命令名或绝对路径。ffprobe 验证视频，ffmpeg 生成封面和短片。
# COMFYSHOP_FFPROBE=ffprobe
# COMFYSHOP_FFMPEG=ffmpeg

# 找回密码的邮件服务。不填 COMFYSHOP_SMTP_HOST 时不发邮件，重置链接写入服务日志，
# 开发环境可以直接从日志里取链接完成流程。
# COMFYSHOP_SMTP_HOST="smtp.example.com"
# 端口，默认 587。
# COMFYSHOP_SMTP_PORT=587
# COMFYSHOP_SMTP_USERNAME="mailer@example.com"
# COMFYSHOP_SMTP_PASSWORD=""
# 发件人，默认 "ComfyShop <no-reply@localhost>"。
# COMFYSHOP_SMTP_FROM="ComfyShop <no-reply@example.com>"
# 连接方式：starttls（默认）、ssl 或 none。
# COMFYSHOP_SMTP_SECURITY=starttls
# 对外的可信平台地址。邮件链接仅使用此地址，不读取请求 Host；工作机启动包的 serverUrl
# 和分享预览图也使用它，未填写时这两项取请求的地址。部署在反向代理后时应填写。
# 配置了 COMFYSHOP_SMTP_HOST 时必填，否则申请重置返回 503。不发信时可以不填，
# 服务日志里给出 /reset-password?token=… 路径，拼在平台地址后打开即可。
# COMFYSHOP_PUBLIC_URL="https://comfyshop.example.com"
# 默认提供浏览器推送能力，订阅由每台已登录的设备主动开启。推送要求 HTTPS 或本机回环地址。
# COMFYSHOP_WEB_PUSH_ENABLED=true
# COMFYSHOP_WEB_PUSH_CONTACT="mailto:admin@example.com"
# 重置链接有效期，默认 30 分钟，范围 60–86400 秒。
# COMFYSHOP_PASSWORD_RESET_TTL_SECONDS=1800
# 绑定邮箱的确认链接有效期，默认 24 小时，范围 60–604800 秒。确认邮件与重置邮件使用同一套
# 邮件服务和平台地址；不发信时确认链接同样写入服务日志。
# COMFYSHOP_EMAIL_CONFIRM_TTL_SECONDS=86400

# 个人和团队的 RunningHub 连接。API 保存 Fernet 密钥，独立工作机和 API 共用另一个随机服务令牌。
COMFYSHOP_CONNECTION_ENCRYPTION_KEY=
COMFYSHOP_WORKER_SERVICE_TOKENS__RUNNINGHUB=
