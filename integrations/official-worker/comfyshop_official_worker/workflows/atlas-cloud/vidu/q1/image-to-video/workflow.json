{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-vidu-q1-image-to-video",
  "name": "Vidu Q1 图生视频",
  "description": "从一张起始图生成 5 秒的 1080p 视频，可控制动作幅度、音频和背景音乐。",
  "category": "video",
  "fields": [
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "",
      "maxLength": 5000
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1080p",
      "choices": ["1080p"],
      "optional": true
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 5,
      "choices": [5],
      "optional": true
    },
    {
      "name": "movement_amplitude",
      "kind": "choice",
      "default": "auto",
      "choices": ["auto", "small", "medium", "large"],
      "optional": true
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "bgm",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": ""
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "hidden"
    },
    {
      "fieldId": "duration",
      "section": "hidden"
    },
    {
      "fieldId": "movement_amplitude",
      "section": "advanced"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "bgm",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "vidu/q1/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "duration": "duration",
        "movement_amplitude": "movement_amplitude",
        "generate_audio": "generate_audio",
        "bgm": "bgm",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 5000
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "min_items": 1,
          "external_sources_field": "first_frame_source",
          "external_urls_only": true
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Vidu Q1 图生视频",
