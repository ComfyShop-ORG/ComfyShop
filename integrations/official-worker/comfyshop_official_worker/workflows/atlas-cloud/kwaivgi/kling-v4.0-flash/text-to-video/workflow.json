{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-kwaivgi-kling-v4-0-flash-text-to-video",
  "name": "可灵 4.0 Flash 文生视频",
  "description": "用文字生成 3 至 20 秒的 720p 视频，可选横屏、竖屏、方形和宽银幕比例。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "A single drop of water falls from the tip of a leaf into a shallow dish, creating concentric ripples; warm window light, macro cinematography, photorealistic.",
      "multiline": true,
      "maxLength": 26000,
      "optional": false
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "choices": ["16:9", "9:16", "1:1", "21:9"],
      "optional": true
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 10,
      "minimum": "3",
      "maximum": "20",
      "step": "1",
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "choices": ["720p"],
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "resolution",
      "section": "hidden"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "kwaivgi/kling-v4.0-flash/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "resolution": "resolution",
        "aspect_ratio": "aspect_ratio"
      },
      "text_max_lengths": {
        "prompt": 26000
      },
      "required_text": ["prompt"]
    }
  },
