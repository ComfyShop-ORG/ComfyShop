      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "top_p",
      "kind": "number",
      "optional": true,
      "default": 0.95,
      "minimum": "0",
      "maximum": "1"
    },
    {
      "name": "temperature",
      "kind": "number",
      "optional": true,
      "default": 1,
      "minimum": "0",
      "maximum": "1"
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true,
      "default": -1
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "media_resolution",
      "kind": "choice",
      "optional": true,
      "default": "default",
      "choices": ["default", "low", "medium", "high"]
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "default",
      "choices": ["default", "png", "jpeg"]
    },
    {
      "name": "reference_1",
