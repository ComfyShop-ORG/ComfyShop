{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-grok-video-extend",
  "name": "Grok Imagine Video 视频续写",
  "description": "在一段 MP4 结尾追加 2 至 10 秒，输出原视频和续写片段。",
  "category": "video_tool",
  "fields": [
    {
      "name": "source_video",
      "kind": "video",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "video_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "duration_seconds",
      "kind": "integer",
      "default": 6,
      "minimum": "2",
      "maximum": "10",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "source_video",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration_seconds",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "video_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "xai/grok-imagine-video/extend-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds"
      },
      "required_text": ["prompt"],
      "media": {
        "video_url": {
          "kind": "video",
          "fields": ["source_video"],
          "external_sources_field": "video_source",
          "external_urls_only": true,
          "content_types": ["video/mp4"],
          "max_duration_ms": 15000,
          "min_items": 1,
          "min_duration_ms": 2000
        }
      }
    }
  },
  "translations": {
