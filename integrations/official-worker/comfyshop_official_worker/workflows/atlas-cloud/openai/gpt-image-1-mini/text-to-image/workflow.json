{
  "format": "service",
  "workerKind": "official",
  "key": "gpt-image-1-mini-text",
  "name": "GPT Image 1 Mini 文生图",
  "description": "根据提示词生成一张或多张图片，支持三种尺寸和 JPEG 压缩。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "quality",
      "kind": "choice",
      "optional": true,
      "default": "medium",
      "choices": ["low", "medium", "high"]
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "default": "1024x1024",
      "choices": ["1024x1024", "1024x1536", "1536x1024"]
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "png",
      "choices": ["png", "jpeg"]
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "n",
      "kind": "integer",
      "optional": true,
      "default": 1,
      "minimum": "1",
      "maximum": "10"
    },
    {
      "name": "output_compression",
      "kind": "integer",
      "optional": true,
      "default": 100,
      "minimum": "0",
      "maximum": "100"
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "quality",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "n",
      "section": "default"
    },
    {
      "fieldId": "output_compression",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "openai/gpt-image-1-mini/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "quality": "quality",
        "size": "size",
        "output_format": "output_format",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output",
        "n": "n",
        "output_compression": "output_compression"
      },
      "required_text": ["prompt"],
      "enabled_by": {
        "output_compression": {
          "parameter": "output_format",
          "equals": ["jpeg"]
        }
      }
    }
  },
  "translations": {
