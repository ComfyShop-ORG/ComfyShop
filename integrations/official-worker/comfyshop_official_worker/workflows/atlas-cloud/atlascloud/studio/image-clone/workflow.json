      "parameterLayout": {
        "product_image": {
          "help": "上传商品图，最多 10 MB。也可填写公开 URL。"
        },
        "reference_image": {
          "help": "上传想参考的图片，最多 10 MB。也可填写公开 URL。"
        },
        "user_prompt": {
          "help": "描述商品和想保留或调整的画面元素。"
        },
        "visual_type": {
          "help": "参考复刻会根据参考图风格创作。完全一致会沿用构图、光线和背景并替换商品。"
        },
        "ratio": {
          "help": "选择输出宽高比。默认 3:4。"
        },
        "product_source": {
          "help": "填写一个可公开访问的商品图 URL。"
        },
        "reference_source": {
          "help": "填写一个可公开访问的参考图 URL。"
        },
        "count": {
          "help": "选择 1 至 4 张。默认 1 张。"
        },
        "resolution": {
          "help": "选择 1K、2K 或 4K。默认 2K。"
        },
        "format": {
          "help": "选择 PNG 或 JPEG。默认 PNG。"
        }
      }
    },
