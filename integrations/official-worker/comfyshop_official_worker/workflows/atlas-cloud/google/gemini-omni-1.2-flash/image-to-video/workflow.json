            "4k": "4K"
          }
        },
        "thinking_level": {
          "label": "推理程度",
          "choiceLabels": {
            "default": "模型默认",
            "high": "高",
            "low": "低"
          }
        },
        "seed": {
          "label": "随机种子"
        },
        "first_frame": {
          "label": "起始帧"
