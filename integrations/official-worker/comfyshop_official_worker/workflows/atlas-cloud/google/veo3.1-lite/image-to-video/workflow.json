{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-google-veo3-1-lite-image-to-video",
  "name": "Veo 3.1 Lite 图生视频",
  "description": "让一张起始图动起来，生成带同步音频的 720p 或 1080p 视频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 8,
      "optional": true,
      "choices": [4, 6, 8]
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "optional": true,
      "choices": ["16:9", "9:16"]
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "optional": true,
      "choices": ["720p", "1080p"]
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "google/veo3.1-lite/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "choice_bounds": {
        "duration": {
          "parameter": "resolution",
          "ranges": {
            "1080p": [8, 8]
          }
        }
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "max_bytes": 8000000,
          "content_types": ["image/png", "image/jpeg"],
          "allow_raw_base64": true
        }
      }
    }
  },
  "translations": {
    "zh": {
