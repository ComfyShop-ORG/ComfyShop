{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-zimage",
  "name": "Z-Image Turbo 文生图",
  "description": "根据中文或英文提示词快速生成图片，可选择提示词改写。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "size",
      "kind": "string",
      "default": "1024*1536",
      "optional": true
    },
    {
      "name": "prompt_extend",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "prompt_extend",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "z-image/turbo",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "prompt_extend": "prompt_extend",
        "seed": "seed",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"],
      "image_size_limits": {
        "min_side": 512,
        "max_side": 2048,
        "allow_auto": false
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Z-Image Turbo 文生图",
      "description": "根据中文或英文提示词快速生成图片，可选择提示词改写。",
      "fields": {
        "prompt": {
          "label": "提示词"
        },
        "size": {
          "label": "输出尺寸"
        },
        "prompt_extend": {
          "label": "改写提示词"
        },
        "seed": {
          "label": "随机种子"
        },
        "enable_sync_mode": {
          "label": "同步返回"
        },
        "enable_base64_output": {
          "label": "Base64 成品"
        }
      },
      "parameterLayout": {
        "prompt": {
          "help": "描述场景、画面风格和图片中的文字。"
