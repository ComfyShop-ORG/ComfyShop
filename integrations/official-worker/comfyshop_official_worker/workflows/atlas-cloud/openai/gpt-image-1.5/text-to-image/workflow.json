{
  "format": "service",
  "workerKind": "official",
  "key": "gpt-image-15-text",
  "name": "GPT Image 1.5 文生图",
  "description": "根据提示词生成图片，提供方形、横向或纵向尺寸，可选画质和输出格式。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "quality",
      "kind": "choice",
      "optional": true,
      "default": "medium",
      "choices": ["low", "medium", "high"]
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "default": "1024x1024",
      "choices": ["1024x1024", "1024x1536", "1536x1024"]
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "jpeg",
      "choices": ["jpeg", "png"]
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "quality",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "openai/gpt-image-1.5/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "quality": "quality",
        "size": "size",
        "output_format": "output_format",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"]
    }
  },
  "translations": {
