{
  "format": "service",
  "workerKind": "official",
  "key": "atlascloud-video-upscaler",
  "name": "Atlas Cloud 视频放大",
  "description": "将现有视频提升到 1080p 或 2K，保留原有画面构图和时间节奏。",
  "category": "video_tool",
  "fields": [
    {
      "name": "video",
      "kind": "video"
    },
    {
      "name": "target_resolution",
      "kind": "choice",
      "optional": true,
      "default": "1080p",
      "choices": ["1080p", "2k"]
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "video",
      "section": "default"
    },
    {
      "fieldId": "target_resolution",
      "section": "default"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "operation": "video",
      "model": "atlascloud/video-upscaler",
      "parameters": {
        "target_resolution": "target_resolution"
      },
      "media": {
        "video": {
          "kind": "video",
          "fields": ["video"],
          "min_items": 1
        }
      }
    }
  },
  "translations": {
    "zh": {
