        "quality": {
          "help": "4 提供更多细节，耗时更长。"
        },
        "seed": {
          "help": "-1 为随机。复用种子和输入素材有助于复现画面。"
        },
        "enable_base64_output": {
          "help": "开启后，Atlas 以 Base64 返回图片，由工作机解码保存。"
        },
        "style_reference_source": {
          "help": "填写公开可访问的 HTTPS 图片地址，与上传二选一。"
        },
        "input_image_source": {
          "help": "填写公开可访问的 HTTPS 图片地址，与上传二选一。"
        }
      }
