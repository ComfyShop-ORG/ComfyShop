          "label": "生成草稿"
        }
      },
      "parameterLayout": {
        "prompt": {
          "help": "描述主体、场景、动作和镜头。建议中文少于 500 字，英文少于 1,000 词。"
        },
        "duration_seconds": {
          "help": "选择 4 至 30 秒，选 -1 由模型决定时长。"
        },
        "aspect_ratio": {
          "help": "选择画面宽高比，或让模型根据提示词决定。"
        },
        "resolution": {
          "help": "选择原生分辨率、SR 超分辨率或 ESR 增强。开启草稿时生成 480p。"
        },
        "generate_audio": {
          "help": "生成与画面同步的语音、音效或音乐。"
        },
        "add_watermark": {
          "help": "为输出视频添加水印。"
        },
        "include_last_frame": {
          "help": "将输出视频的最后一帧另存为图片。"
        },
        "video_format": {
          "help": "选择 MP4 或 MOV。MOV 使用 YUV 4:4:4 以保留色彩细节。"
        },
        "draft": {
          "help": "生成 480p 预览和草稿 ID。可在七天内用草稿 ID 渲染正式版。"
        }
      }
    },
