      "parameterLayout": {
        "prompt": {
          "help": "Describe the scene, visual style, and any text in the image."
        },
        "size": {
          "help": "Enter width*height, up to 1,536 pixels per side. The default is 1024*1024."
        },
        "loras": {
          "help": "Enter a JSON array with up to three items. Each needs path (a weights ID or .safetensors URL). Optional scale ranges from 0 to 4 and defaults to 1."
        },
        "seed": {
          "help": "Use -1 for a random seed, or enter an integer to reuse a seed."
        },
        "num_inference_steps": {
          "help": "Enter an integer of at least 1. The default is 9."
        },
        "guidance_scale": {
          "help": "Enter the guidance scale. The default is 1."
        },
        "output_format": {
          "help": "Choose PNG, JPEG, or WebP. The default is PNG."
        },
        "enable_sync_mode": {
          "help": "Wait for upload and return the completed output in the submission response."
        },
        "enable_base64_output": {
          "help": "Return the image as Base64. The worker decodes and saves it."
        }
      }
    },
