      "name": "max_images",
      "kind": "integer",
      "optional": true,
      "default": 1,
      "minimum": "1",
      "maximum": "15"
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "reference_1",
      "kind": "image",
      "optional": true
    },
    {
