{
  "format": "service",
  "workerKind": "official",
  "key": "atlascloud-photo-cleanup",
  "name": "Atlas Cloud 照片清理",
  "description": "减少静态图片里的灰尘、细划痕、噪点和重复纹理，保留主体与构图。",
  "category": "image_tool",
  "fields": [
    {
      "name": "image",
      "kind": "image"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "png",
      "choices": ["png", "jpeg", "webp", "jpg"]
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "image",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "atlascloud/photo-cleanup",
      "parameters": {
        "output_format": "output_format"
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["image"],
          "min_items": 1
        }
      }
    }
  },
