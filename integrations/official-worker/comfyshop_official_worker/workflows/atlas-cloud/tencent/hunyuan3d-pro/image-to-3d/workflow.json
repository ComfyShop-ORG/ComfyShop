{
  "format": "service",
  "workerKind": "official",
  "key": "tencent-hunyuan3d-pro-image-to-3d",
  "name": "Hunyuan 3D Pro 图生 3D",
  "description": "根据参考图生成带纹理或纯几何的 3D 网格，可设置目标面数。",
  "category": "3d",
  "fields": [
    {
      "name": "reference_image",
      "kind": "image"
    },
    {
      "name": "generation_type",
      "kind": "choice",
      "choices": ["Normal", "Geometry"],
      "default": "Normal",
      "optional": true
    },
    {
      "name": "pbr",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "face_count",
      "kind": "integer",
      "minimum": "40000",
      "maximum": "1500000",
      "step": "1",
      "default": 500000,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "reference_image",
      "section": "default"
    },
    {
      "fieldId": "generation_type",
      "section": "default"
    },
    {
      "fieldId": "pbr",
      "section": "advanced"
    },
    {
      "fieldId": "face_count",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "3d",
    "additionalOutputKinds": ["image"],
    "config": {
      "operation": "image",
      "model": "tencent/hunyuan3d-pro/image-to-3d",
      "parameters": {
        "generate_type": "generation_type",
        "enable_pbr": "pbr",
        "face_count": "face_count"
      },
      "enabled_by": {
        "enable_pbr": {
          "parameter": "generate_type",
          "equals": "Normal"
        }
      },
      "media": {
        "image": {
          "kind": "image",
          "encoding": "base64",
          "fields": ["reference_image"],
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "image_bounds": {
            "min_side": 128,
            "max_side": 5000
          },
          "max_bytes": 6000000
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Hunyuan 3D Pro 图生 3D",
      "description": "根据参考图生成带纹理或纯几何的 3D 网格，可设置目标面数。",
      "fields": {
        "reference_image": {
          "label": "参考图片"
        },
        "generation_type": {
          "label": "生成类型"
        },
        "pbr": {
          "label": "生成 PBR 材质"
        },
        "face_count": {
          "label": "目标面数"
        }
      },
      "parameterLayout": {
        "reference_image": {
          "help": "上传 PNG、JPEG 或 WebP。每边 128 至 5000 像素，最多 6 MB。"
        },
        "generation_type": {
          "help": "Normal 生成带纹理的网格，Geometry 生成纯几何白模。"
        },
        "pbr": {
          "help": "Normal 模式可生成金属度、粗糙度和法线贴图。"
        },
        "face_count": {
          "help": "可设置 40000 至 1500000 个面，默认 500000。"
        }
      }
    },
    "zh-tw": {
