      "default": "1:1",
      "optional": true,
      "choices": ["1:1", "9:16", "16:9"]
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 5,
      "optional": true,
      "choices": [5, 10]
    },
    {
      "name": "sound",
      "kind": "boolean",
      "default": true,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "sound",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "kwaivgi/kling-v2.6-pro/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "aspect_ratio": "aspect_ratio",
        "sound": "sound"
      },
      "required_text": ["prompt"]
    }
  },
