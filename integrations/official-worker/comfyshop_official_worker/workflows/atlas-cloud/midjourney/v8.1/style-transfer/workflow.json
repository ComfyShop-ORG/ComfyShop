{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-mj81-style",
  "name": "Midjourney V8.1 风格迁移",
  "description": "按文字描述重绘一张图片，保留原图构图并产出 4 种变体。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "input_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "input_image_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "input_image",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "input_image_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "midjourney/v8.1/style-transfer",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["input_image"],
          "external_sources_field": "input_image_source",
          "min_items": 1,
          "external_urls_only": true,
          "external_https_only": true
        }
      }
    }
  },
  "translations": {
