        },
        "ratio": {
          "label": "画面比例",
          "choiceLabels": {
            "1:1": "1:1",
            "2:3": "2:3",
            "3:2": "3:2",
            "3:4": "3:4",
            "4:3": "4:3",
            "16:9": "16:9",
            "9:16": "9:16",
            "21:9": "21:9"
          }
        },
        "product_source": {
          "label": "商品图 URL"
        },
        "reference_source": {
          "label": "参考图 URL"
        },
        "count": {
          "label": "出图张数"
        },
        "resolution": {
          "label": "分辨率",
          "choiceLabels": {
            "1k": "1K",
            "2k": "2K",
            "4k": "4K"
