{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-mai25pro-edit",
  "name": "MAI-Image 2.5 Pro 图片编辑",
  "description": "根据提示词编辑一张图片。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "input_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "input_image_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "input_image",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "input_image_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "microsoft/mai-image-2.5-pro/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "enable_base64_output": "enable_base64_output",
        "enable_sync_mode": "enable_sync_mode"
      },
      "required_text": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["input_image"],
          "external_sources_field": "input_image_source",
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png"],
          "allow_raw_base64": true,
          "image_bounds": {
            "max_pixels": 1376255
          }
        }
      }
    }
  },
  "translations": {
