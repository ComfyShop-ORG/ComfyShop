{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-kwaivgi-kling-v2-6-pro-avatar",
  "name": "可灵 2.6 专业版数字人",
  "description": "用人物图和语音生成口型同步视频，成品时长由语音决定。",
  "category": "video",
  "fields": [
    {
      "name": "portrait",
      "kind": "image",
      "optional": true
    },
    {
      "name": "voice",
      "kind": "audio",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "optional": true,
      "multiline": true
    },
    {
      "name": "portrait_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "voice_source",
      "kind": "string",
      "default": "",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "portrait",
      "section": "default"
    },
    {
      "fieldId": "voice",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "portrait_source",
      "section": "advanced"
    },
    {
      "fieldId": "voice_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "kwaivgi/kling-v2.6-pro/avatar",
      "operation": "video",
      "parameters": {
        "prompt": "prompt"
      },
      "omit_blank_parameters": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["portrait"],
          "external_sources_field": "portrait_source",
          "external_urls_only": true,
          "min_items": 1
        },
        "audio": {
          "kind": "audio",
          "fields": ["voice"],
          "external_sources_field": "voice_source",
          "external_urls_only": true,
          "min_items": 1
        }
      }
    }
  },
