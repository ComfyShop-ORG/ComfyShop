{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-alibaba-happyhorse-1-1-text-to-video",
  "name": "HappyHorse 1.1 文生视频",
  "description": "用提示词生成视频，可选择分辨率、画面比例与时长。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 2500
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1080p",
      "optional": true,
      "choices": ["480p", "720p", "1080p"]
    },
    {
      "name": "ratio",
      "kind": "choice",
      "default": "16:9",
      "optional": true,
      "choices": ["16:9", "9:16", "1:1", "4:3", "3:4", "4:5", "5:4", "9:21", "21:9"]
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "optional": true,
      "minimum": "3",
      "maximum": "15"
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true,
      "minimum": "-1",
      "maximum": "2147483647"
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "ratio",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "alibaba/happyhorse-1.1/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "ratio": "ratio",
        "duration": "duration",
        "seed": "seed"
      },
      "required_text": ["prompt"]
    }
  },
  "translations": {
