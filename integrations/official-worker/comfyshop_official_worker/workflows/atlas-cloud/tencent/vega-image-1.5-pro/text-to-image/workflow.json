{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-tencent-vega-image-1-5-pro-text-to-image",
  "name": "腾讯 Vega 1.5 Pro 文生图",
  "description": "从文字生成 1K、2K 或 4K 图像，可选画面比例、反向提示词和提示词增强。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "An astronaut corgi posing on the surface of the moon, cinematic, photorealistic.",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "choice",
      "default": "1K",
      "choices": ["1K", "2K", "4K"],
      "optional": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "1:1",
      "choices": ["16:9", "9:16", "1:1", "3:4", "4:3"],
      "optional": true
    },
    {
      "name": "negative_prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": true
    },
    {
      "name": "enhance_prompt",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "input_region",
      "kind": "choice",
      "default": "Oversea",
      "choices": ["Mainland", "Oversea", "OverseaUSWest"],
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "enhance_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "input_region",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "tencent/vega-image-1.5-pro/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "aspect_ratio": "aspect_ratio",
        "negative_prompt": "negative_prompt",
        "enhance_prompt": "enhance_prompt",
        "seed": "seed",
        "input_region": "input_region"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["negative_prompt"]
    }
  },
