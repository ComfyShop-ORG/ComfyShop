        "num_inference_steps": {
          "help": "1~50단계를 선택하세요. 기본값은 28입니다."
        },
        "guidance_scale": {
          "help": "0~20을 선택하세요. 값이 높을수록 프롬프트를 더 가깝게 따릅니다. 기본값은 2.5입니다."
        },
        "seed": {
          "help": "시드를 재사용하려면 정수를 입력하세요. 기본값 -1은 무작위입니다."
        },
        "source_image_url": {
          "help": "업로드 대신 공개 이미지 URL을 입력하세요."
        },
        "mask_url": {
          "help": "업로드 대신 공개 마스크 이미지 URL을 입력하세요."
        },
        "cfg_scale": {
          "help": "0~20을 선택하세요. 네거티브 프롬프트를 사용하려면 1보다 큰 값이 필요합니다."
        },
        "negative_prompt": {
          "help": "피할 내용을 설명하세요. 이 필드를 사용하려면 CFG 강도를 1보다 크게 설정하세요."
        }
      }
    }
  }
}
