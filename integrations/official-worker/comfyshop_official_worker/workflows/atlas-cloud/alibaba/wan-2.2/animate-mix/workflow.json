{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-alibaba-wan-2-2-animate-mix",
  "name": "Wan 2.2 人物替换",
  "description": "用图片中的人物替换原视频中的人物。",
  "category": "video_tool",
  "fields": [
    {
      "name": "character_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "motion_video",
      "kind": "video",
      "optional": true
    },
    {
      "name": "mode",
      "kind": "choice",
      "default": "wan-pro",
      "choices": ["wan-std", "wan-pro"]
    },
    {
      "name": "character_image_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "motion_video_source",
      "kind": "string",
      "default": "",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "character_image",
      "section": "default"
    },
    {
      "fieldId": "motion_video",
      "section": "default"
    },
    {
      "fieldId": "mode",
      "section": "default"
    },
    {
      "fieldId": "character_image_source",
      "section": "advanced"
    },
    {
      "fieldId": "motion_video_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "alibaba/wan-2.2/animate-mix",
      "operation": "video",
      "parameters": {
        "mode": "mode"
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["character_image"],
          "min_items": 1,
          "external_sources_field": "character_image_source",
          "external_urls_only": true,
          "content_types": ["image/jpeg", "image/png", "image/bmp", "image/webp"],
          "max_bytes": 5000000,
          "image_bounds": {
            "min_side": 200,
            "max_side": 4096,
            "max_aspect_ratio": 3
          }
        },
        "video": {
          "kind": "video",
          "fields": ["motion_video"],
          "min_items": 1,
          "external_sources_field": "motion_video_source",
          "external_urls_only": true,
          "content_types": ["video/mp4", "video/quicktime"],
          "max_bytes": 200000000,
          "min_duration_ms": 2000,
          "max_duration_ms": 30000,
          "image_bounds": {
            "min_side": 200,
            "max_side": 2048,
            "max_aspect_ratio": 3
          }
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Wan 2.2 人物替换",
      "description": "用图片中的人物替换原视频中的人物。",
      "fields": {
        "character_image": {
          "label": "替换人物图"
        },
        "motion_video": {
          "label": "原视频"
        },
        "mode": {
          "label": "模式",
          "choiceLabels": {
            "wan-std": "标准",
            "wan-pro": "专业"
          }
        },
        "character_image_source": {
          "label": "人物图地址"
        },
        "motion_video_source": {
          "label": "原视频地址"
        }
      },
      "parameterLayout": {
        "character_image": {
          "help": "上传 JPEG、PNG、BMP 或 WebP。宽高各 200 至 4096 像素，长短边比例最多 3:1，最多 5 MB。"
        },
        "motion_video": {
          "help": "上传 MP4 或 MOV，或通过公开地址使用 AVI。视频须为 2 至 30 秒，宽高各 200 至 2048 像素，长短边比例最多 3:1，最多 200 MB。"
        },
        "mode": {
          "help": "标准模式用于较快生成，专业模式生成更平滑的动画。默认专业模式。"
        },
        "character_image_source": {
          "help": "填写一个公开图片 URL，与上传二选一。"
        },
        "motion_video_source": {
          "help": "填写一个公开的 MP4、MOV 或 AVI URL，与上传二选一。"
        }
      }
    },
