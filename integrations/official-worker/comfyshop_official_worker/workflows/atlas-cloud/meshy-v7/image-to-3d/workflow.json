        },
        "enhance_input": {
          "label": "Enhance source images"
        },
        "remesh": {
          "label": "Remesh"
        },
        "topology": {
          "label": "Mesh topology"
        },
        "face_target": {
          "label": "Target face count"
        },
        "decimation_level": {
          "label": "Decimation level"
        },
        "include_original_mesh": {
          "label": "Keep original mesh"
        },
        "pose": {
          "label": "Character pose"
        },
        "real_world_scale": {
          "label": "Scale to real-world size"
        },
        "origin": {
          "label": "Model origin"
        },
        "transparent_preview": {
          "label": "Transparent preview"
        },
        "additional_previews": {
          "label": "Multi-view previews"
        },
        "moderation": {
          "label": "Content moderation"
        },
        "texture_image": {
          "label": "Single texture image"
        },
        "export_glb": {
          "label": "Export GLB"
        },
        "export_obj": {
          "label": "Export OBJ"
        },
        "export_fbx": {
          "label": "Export FBX"
        },
        "export_stl": {
          "label": "Export STL"
        },
        "export_usdz": {
          "label": "Export USDZ"
        },
        "export_3mf": {
          "label": "Export 3MF"
        }
      },
      "parameterLayout": {
        "reference_image": {
          "help": "Upload a PNG or JPEG that clearly shows the object."
        },
        "textured": {
          "help": "Generate surface textures. Turn off for an untextured mesh."
        },
        "detailed_geometry": {
          "help": "Use higher-fidelity geometry for finer surface detail."
        },
        "pbr": {
          "help": "With texturing enabled, include metallic, roughness, and normal maps."
        },
        "texture_resolution": {
          "help": "Choose a 2K, 4K, or 8K base color map."
        },
        "texture_prompt": {
          "help": "Describe the surface material in up to 800 characters. This takes priority over the texture image."
        },
        "enhance_input": {
          "help": "Process the input images to improve reconstruction. Turn off to preserve their appearance."
        },
        "remesh": {
          "help": "Enable remeshing to control topology and face count."
        },
        "topology": {
          "help": "Choose a triangle or quad-dominant mesh when remeshing."
        },
        "face_target": {
          "help": "Set 100 to 300000 faces while remeshing. A decimation level takes priority."
        },
        "decimation_level": {
          "help": "Adaptively simplify when remeshing. Levels 1, 2, 3, and 4 target ultra, high, medium, and low face counts."
        },
        "include_original_mesh": {
