{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-alibaba-wan-2-5-image-to-video-fast",
  "name": "Wan 2.5 Fast 图生视频",
  "description": "用起始图和提示词生成视频，可选择最高 1080p 分辨率和参考音频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 1500
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "optional": false,
      "choices": ["720p", "1080p"]
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 5,
      "optional": true,
      "choices": [5, 10]
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true,
      "minimum": "-1",
      "maximum": "2147483647"
    },
    {
      "name": "negative_prompt",
      "optional": true,
      "kind": "string",
      "multiline": true,
      "maxLength": 500,
      "default": ""
    },
    {
      "name": "soundtrack",
      "optional": true,
      "kind": "audio"
    },
    {
      "name": "soundtrack_source",
      "optional": true,
      "kind": "string",
      "default": ""
    },
    {
      "name": "enable_prompt_expansion",
      "optional": true,
      "kind": "boolean",
      "default": false
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "soundtrack",
      "section": "advanced"
    },
    {
      "fieldId": "soundtrack_source",
      "section": "advanced"
    },
    {
      "fieldId": "enable_prompt_expansion",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "alibaba/wan-2.5/image-to-video-fast",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "duration": "duration",
        "seed": "seed",
        "negative_prompt": "negative_prompt",
        "enable_prompt_expansion": "enable_prompt_expansion"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["negative_prompt"],
      "media": {
        "audio": {
          "kind": "audio",
          "fields": ["soundtrack"],
          "content_types": ["audio/wav", "audio/mpeg"],
          "max_bytes": 15000000,
          "min_duration_ms": 3000,
          "max_duration_ms": 30000,
          "external_urls_only": true,
          "external_sources_field": "soundtrack_source"
        },
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "max_bytes": 20000000,
          "content_types": ["image/jpeg", "image/png", "image/bmp", "image/webp"],
          "image_bounds": {
            "min_side": 240,
            "max_side": 8000
          },
          "reject_png_alpha": true
        }
      }
    }
  },
