        "enable_base64_output": {
          "label": "Base64 输出"
        }
      },
      "parameterLayout": {
        "image": {
          "help": "上传要编辑的图片，也可在高级参数填写图片 URL。"
        },
        "prompt": {
          "help": "描述要调整的元素、布局或图中文字。"
        },
