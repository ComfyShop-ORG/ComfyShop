{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-grok-image2-edit",
  "name": "Grok Imagine Image 2.0 图像编辑",
  "description": "根据提示词编辑一张或多张图片，最多输出四张。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "Render this as a pencil sketch with detailed shading.",
      "multiline": true,
      "maxLength": 8000
    },
    {
      "name": "num_images",
      "kind": "choice",
      "default": 1,
      "choices": [1, 2, 3, 4],
      "optional": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "auto",
      "choices": [
        "auto",
        "1:1",
        "3:4",
        "4:3",
        "9:16",
        "16:9",
        "2:3",
        "3:2",
        "9:19.5",
        "19.5:9",
        "9:20",
        "20:9",
        "1:2",
        "2:1"
      ],
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1k",
      "choices": ["1k", "2k"],
      "optional": true
    },
    {
      "name": "quality",
      "kind": "choice",
      "default": "medium",
      "choices": ["low", "medium"],
      "optional": true
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "source_image_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "source_image_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "source_image_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "source_image_4",
      "kind": "image",
      "optional": true
    },
    {
      "name": "source_image_5",
      "kind": "image",
      "optional": true
    },
    {
      "name": "image_sources",
      "kind": "string",
      "default": "",
      "optional": true,
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "source_image_1",
      "section": "default"
    },
    {
      "fieldId": "num_images",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "quality",
      "section": "default"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_2",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_3",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_4",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_5",
      "section": "advanced"
    },
    {
      "fieldId": "image_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "xai/grok-imagine-image-2.0/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "num_images": "num_images",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "enable_base64_output": "enable_base64_output",
        "quality": "quality"
      },
      "required_text": ["prompt"],
      "media": {
        "image_urls": {
          "kind": "image",
          "array": true,
          "fields": [
            "source_image_1",
            "source_image_2",
            "source_image_3",
            "source_image_4",
            "source_image_5"
          ],
          "external_sources_field": "image_sources",
          "min_items": 1,
          "content_types": ["image/png", "image/jpeg", "image/webp"]
        }
      },
      "text_max_lengths": {
        "prompt": 8000
      }
    }
  },
