{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-veed-lips",
  "name": "VEED Lipsync 视频对口型",
  "description": "用新音频驱动原视频人物的口型，适合单人演讲和旁白视频。",
  "category": "video_tool",
  "fields": [
    {
      "name": "source_video",
      "kind": "video",
      "optional": true
    },
    {
      "name": "driving_audio",
      "kind": "audio",
      "optional": true
    },
    {
      "name": "video_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "audio_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "source_video",
      "section": "default"
    },
    {
      "fieldId": "driving_audio",
      "section": "default"
    },
    {
      "fieldId": "video_source",
      "section": "advanced"
    },
    {
      "fieldId": "audio_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "veed/lipsync",
      "operation": "video",
      "parameters": {},
      "prediction_endpoint": "result",
      "media": {
        "video_url": {
          "kind": "video",
          "fields": ["source_video"],
          "min_items": 1,
          "external_sources_field": "video_source",
          "allow_raw_base64": true,
          "content_types": ["video/mp4", "video/quicktime", "video/webm"]
        },
        "audio_url": {
          "kind": "audio",
          "fields": ["driving_audio"],
          "min_items": 1,
          "external_sources_field": "audio_source",
          "allow_raw_base64": true,
          "content_types": [
            "audio/wav",
            "audio/wave",
            "audio/x-wav",
            "audio/mpeg",
            "audio/mp3",
            "audio/mp4"
          ]
        }
      }
    }
  },
