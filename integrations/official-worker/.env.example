# 复制到仓库外的私有环境文件，通过 docker compose --env-file 加载。
ATLAS_CLOUD_API_KEY=
# 独立运行时可启用内网报价端口。Compose 使用 8690。
# COMFYSHOP_OFFICIAL_WORKER_QUOTE_PORT=8690
# 单个官方工作机实例同时执行的生成次数上限，各任务共用，正整数，默认 4。
COMFYSHOP_OFFICIAL_WORKER_MAX_CONCURRENCY=4
# DEBUG、INFO、WARNING、ERROR 或 CRITICAL，默认 INFO。
COMFYSHOP_WORKER_LOG_LEVEL=INFO
# official-init 首次注册维护账号时使用的网页登录密码，8–128 位。
# COMFYSHOP_OFFICIAL_OWNER_PASSWORD=
