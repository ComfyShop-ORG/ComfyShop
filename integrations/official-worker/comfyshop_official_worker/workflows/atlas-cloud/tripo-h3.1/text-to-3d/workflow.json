{
  "format": "service",
  "workerKind": "official",
  "key": "tripo-h31-text-to-3d",
  "name": "Tripo H3.1 文生 3D",
  "description": "根据文字描述生成带纹理的 3D 模型，可调整几何精度、材质和网格拓扑。",
  "category": "3d",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "negative_prompt",
      "kind": "string",
      "multiline": true,
      "optional": true
    },
    {
      "name": "texture",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "pbr",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "texture_quality",
      "kind": "choice",
      "choices": ["standard", "detailed"],
      "default": "standard",
      "optional": true
    },
    {
      "name": "geometry_quality",
      "kind": "choice",
      "choices": ["standard", "detailed"],
      "default": "standard",
      "optional": true
    },
    {
      "name": "face_limit",
      "kind": "integer",
      "minimum": "1000",
      "maximum": "2000000",
      "optional": true
    },
    {
      "name": "model_seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "image_seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "texture_seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "auto_size",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "quad",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "texture",
      "section": "default"
    },
    {
      "fieldId": "pbr",
      "section": "default"
    },
    {
      "fieldId": "texture_quality",
      "section": "advanced"
    },
    {
      "fieldId": "geometry_quality",
      "section": "advanced"
    },
    {
      "fieldId": "face_limit",
      "section": "advanced"
    },
    {
      "fieldId": "model_seed",
      "section": "advanced"
    },
    {
      "fieldId": "image_seed",
      "section": "advanced"
    },
    {
      "fieldId": "texture_seed",
      "section": "advanced"
    },
    {
      "fieldId": "auto_size",
      "section": "advanced"
    },
    {
      "fieldId": "quad",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "3d",
    "additionalOutputKinds": ["image"],
    "config": {
      "operation": "image",
      "model": "tripo-h3.1/text-to-3d",
      "parameters": {
        "prompt": "prompt",
        "negative_prompt": "negative_prompt",
        "texture": "texture",
        "pbr": "pbr",
        "texture_quality": "texture_quality",
        "geometry_quality": "geometry_quality",
        "face_limit": "face_limit",
        "model_seed": "model_seed",
        "image_seed": "image_seed",
        "texture_seed": "texture_seed",
        "auto_size": "auto_size",
        "quad": "quad"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 1024
      }
    }
  },
