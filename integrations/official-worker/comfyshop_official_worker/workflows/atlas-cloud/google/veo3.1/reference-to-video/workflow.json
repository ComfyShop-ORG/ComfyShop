{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-google-veo3-1-reference-to-video",
  "name": "Veo 3.1 参考生视频",
  "description": "用一至三张参考图和提示词生成 8 秒视频，保持主体一致。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 8,
      "optional": true,
      "choices": [8]
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "optional": true,
      "choices": ["720p", "1080p", "4k"]
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "generate_audio",
      "optional": true,
      "kind": "boolean",
      "default": false
    },
    {
      "name": "negative_prompt",
      "optional": true,
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "reference_image_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "reference_image_1",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "hidden"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_3",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "google/veo3.1/reference-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "resolution": "resolution",
        "seed": "seed",
        "generate_audio": "generate_audio",
        "negative_prompt": "negative_prompt"
      },
      "required_text": ["prompt"],
      "choice_bounds": {
        "duration": {
          "parameter": "resolution",
          "ranges": {
            "1080p": [8, 8],
            "4k": [8, 8]
          }
        }
      },
      "omit_blank_parameters": ["negative_prompt"],
      "media": {
        "images": {
          "kind": "image",
          "fields": ["reference_image_1", "reference_image_2", "reference_image_3"],
          "array": true,
          "min_items": 1,
          "max_bytes": 50000000,
          "image_bounds": {
            "min_side": 128
          },
          "content_types": ["image/png", "image/jpeg", "image/webp"],
          "external_sources_field": "reference_image_sources"
        }
      }
    }
  },
