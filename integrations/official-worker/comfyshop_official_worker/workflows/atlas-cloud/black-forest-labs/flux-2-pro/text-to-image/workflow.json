{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-flux2-pro-text-to-image",
  "name": "FLUX.2 Pro 文生图",
  "description": "根据提示词生成 JPEG 或 PNG 图片。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "jpeg",
      "choices": ["jpeg", "png"]
    },
    {
      "optional": true,
      "name": "seed",
      "kind": "integer",
      "default": -1
    },
    {
      "optional": true,
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "size",
      "kind": "string",
      "default": "1024*1024",
      "optional": true
    },
    {
      "name": "safety_tolerance",
      "kind": "integer",
      "default": 2,
      "minimum": "0",
      "maximum": "5",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "safety_tolerance",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "size",
      "section": "hidden"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "black-forest-labs/flux-2-pro/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "output_format": "output_format",
        "seed": "seed",
        "enable_base64_output": "enable_base64_output",
        "enable_sync_mode": "enable_sync_mode",
        "size": "size",
        "safety_tolerance": "safety_tolerance"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["size"],
      "image_size_limits": {
        "allow_auto": false,
        "min_side": 256,
        "max_side": 2048
      }
    }
  },
  "translations": {
