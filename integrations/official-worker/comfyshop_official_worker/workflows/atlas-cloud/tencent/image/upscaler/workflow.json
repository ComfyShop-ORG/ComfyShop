        "type": {
          "label": "超分类型",
          "choiceLabels": {
            "standard": "标准",
            "super": "AIGC",
            "ultra": "细节增强",
            "fidelity": "高保真"
          }
        },
        "mode": {
          "label": "缩放方式",
          "choiceLabels": {
            "percent": "按倍数",
            "aspect": "等比适配",
            "fixed": "固定尺寸"
          }
        },
        "percent": {
          "label": "放大倍数"
        },
        "width": {
          "label": "目标宽度"
        },
        "height": {
          "label": "目标高度"
        },
        "long_side": {
          "label": "目标长边"
        },
        "short_side": {
          "label": "目标短边"
        },
        "encode_format": {
          "label": "输出格式",
          "choiceLabels": {
            "JPEG": "JPEG",
            "PNG": "PNG",
            "WEBP": "WebP",
            "BMP": "BMP"
          }
        },
        "encode_quality": {
          "label": "编码质量"
