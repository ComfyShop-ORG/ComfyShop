{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-atlascloud-qwen-image-text-to-image",
  "name": "Atlas Cloud Qwen Image 文生图",
  "description": "根据文字生成图片，适合制作海报、插画和带有文字的图像。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "string",
      "default": "1024*1024",
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "atlascloud/qwen-image/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "seed": "seed",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output",
        "size": "size"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["size"],
      "image_size_limits": {
        "min_side": 512,
        "max_side": 2048,
        "allow_auto": false
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Atlas Cloud Qwen Image 文生图",
      "description": "根据文字生成图片，适合制作海报、插画和带有文字的图像。",
