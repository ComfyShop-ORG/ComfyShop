        "first_frame_source": {
          "label": "首幀來源"
        }
      },
      "parameterLayout": {
        "first_frame": {
          "help": "上傳 JPEG、PNG。寬高比須大於 2:5 且小於 5:2，短邊大於 300 像素，檔案不超過 20 MB。"
        },
        "prompt": {
          "help": "可描述動作或場景，最多 2,000 字元。"
