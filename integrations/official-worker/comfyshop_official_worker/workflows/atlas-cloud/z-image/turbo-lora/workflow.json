{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-zimage-lora",
  "name": "Z-Image Turbo LoRA 文生图",
  "description": "根据提示词生成图片，可混合最多三个 LoRA 权重。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "size",
      "kind": "string",
      "default": "1024*1024",
      "optional": true
    },
    {
      "name": "loras",
      "kind": "string",
      "multiline": true,
      "optional": true,
      "default": "[]"
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    },
    {
      "name": "num_inference_steps",
      "kind": "integer",
      "minimum": "1",
      "optional": true,
      "default": 9
    },
    {
      "name": "guidance_scale",
      "kind": "number",
      "optional": true,
      "default": 1
    },
    {
      "name": "output_format",
      "kind": "choice",
      "default": "png",
      "choices": ["png", "jpeg", "webp"],
      "optional": true
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "loras",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "num_inference_steps",
      "section": "advanced"
    },
    {
      "fieldId": "guidance_scale",
      "section": "advanced"
    },
    {
      "fieldId": "output_format",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "z-image/turbo-lora",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "loras": "loras",
        "seed": "seed",
        "num_inference_steps": "num_inference_steps",
        "guidance_scale": "guidance_scale",
        "output_format": "output_format",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"],
      "image_size_limits": {
        "min_side": 1,
        "max_side": 1536,
        "allow_auto": false
      },
      "omit_blank_parameters": ["loras"],
      "lora_parameters": {
        "loras": {
          "max_items": 3,
          "scale_range": [0, 4]
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Z-Image Turbo LoRA 文生图",
      "description": "根据提示词生成图片，可混合最多三个 LoRA 权重。",
