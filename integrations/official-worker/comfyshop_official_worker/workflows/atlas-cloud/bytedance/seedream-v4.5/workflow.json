{
  "format": "service",
  "workerKind": "official",
  "key": "seedream-v45-text",
  "name": "Seedream v4.5 文生图",
  "description": "使用提示词生成图片，提供 2K 与 4K 尺寸，适合排版与品牌视觉设计。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "choices": [
        "2048*2048",
        "2304*1728",
        "1728*2304",
        "2848*1600",
        "1600*2848",
        "2496*1664",
        "1664*2496",
        "3136*1344",
        "4096*4096",
        "4704*3520",
        "3520*4704",
        "5504*3040",
        "3040*5504",
        "4992*3328",
        "3328*4992",
        "6240*2656"
      ],
      "default": "2048*2048"
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "bytedance/seedream-v4.5",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"]
    }
  },
