{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-flux-schnell",
  "name": "FLUX.1 Schnell 图像生成",
  "description": "根据提示词生成图片，也可使用源图和蒙版修改局部。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "Cute boy with a hat, exploring nature, holding a telescope, backpack, surrounded by flowers, cartoon style, vibrant colors.",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "string",
      "default": "1024*1024",
      "optional": true
    },
    {
      "name": "num_images",
      "kind": "integer",
      "default": 1,
      "minimum": "1",
      "maximum": "4",
      "optional": true
    },
    {
      "optional": true,
      "name": "source_image",
      "kind": "image"
    },
    {
      "optional": true,
      "name": "mask",
      "kind": "image"
    },
    {
      "optional": true,
      "name": "strength",
      "kind": "number",
      "default": 0.8,
      "minimum": "0",
      "maximum": "1",
      "step": "0.01"
    },
    {
      "optional": true,
      "name": "seed",
      "kind": "integer",
      "default": -1
    },
    {
      "optional": true,
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false
    },
    {
      "name": "enable_safety_checker",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "optional": true,
      "name": "source_image_url",
      "kind": "string",
      "default": ""
    },
    {
      "optional": true,
      "name": "mask_url",
      "kind": "string",
      "default": ""
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "num_images",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "source_image",
      "section": "advanced"
    },
    {
      "fieldId": "mask",
      "section": "advanced"
    },
    {
      "fieldId": "strength",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "enable_safety_checker",
      "section": "hidden"
    },
    {
      "fieldId": "source_image_url",
      "section": "advanced"
    },
    {
      "fieldId": "mask_url",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "black-forest-labs/flux-schnell",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "num_images": "num_images",
        "strength": "strength",
        "seed": "seed",
        "enable_base64_output": "enable_base64_output",
        "enable_safety_checker": "enable_safety_checker",
        "enable_sync_mode": "enable_sync_mode"
      },
      "required_text": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["source_image"],
          "external_sources_field": "source_image_url",
          "external_urls_only": true
        },
        "mask_image": {
          "kind": "image",
          "fields": ["mask"],
          "external_sources_field": "mask_url",
          "external_urls_only": true
        }
      },
      "prediction_endpoint": "result",
      "media_requires_any_of": {
        "mask_image": ["image"]
      }
    }
  },
  "translations": {
    "zh": {
      "name": "FLUX.1 Schnell 图像生成",
      "description": "根据提示词生成图片，也可使用源图和蒙版修改局部。",
      "fields": {
        "prompt": {
          "label": "提示词"
        },
        "size": {
          "label": "图片尺寸"
