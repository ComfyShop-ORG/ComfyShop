{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-tencent-vega-image-1-0-pro-edit",
  "name": "腾讯 Vega 1.0 Pro 图像编辑",
  "description": "用主参考图和编辑指令生成 1K、2K 或 4K 图像，可再提供最多五张参考图。",
  "category": "image_tool",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "Make the lighting warm and cinematic, and add soft morning haze.",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "choice",
      "default": "1K",
      "choices": ["1K", "2K", "4K"],
      "optional": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "1:1",
      "choices": ["16:9", "9:16", "1:1", "3:4", "4:3"],
      "optional": true
    },
    {
      "name": "negative_prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": true
    },
    {
      "name": "enhance_prompt",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "input_region",
      "kind": "choice",
      "default": "Oversea",
      "choices": ["Mainland", "Oversea", "OverseaUSWest"],
      "optional": true
    },
    {
      "name": "primary_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "primary_image_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "reference_image_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "image_sources",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 4194304,
      "optional": true
    },
    {
      "name": "reference_image_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_4",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_5",
      "kind": "image",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "primary_image",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "enhance_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "input_region",
      "section": "advanced"
    },
    {
      "fieldId": "primary_image_source",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_1",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_3",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_4",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_5",
      "section": "advanced"
    },
    {
      "fieldId": "image_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "tencent/vega-image-1.0-pro/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "aspect_ratio": "aspect_ratio",
        "negative_prompt": "negative_prompt",
        "enhance_prompt": "enhance_prompt",
        "seed": "seed",
        "input_region": "input_region"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["negative_prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["primary_image"],
          "external_sources_field": "primary_image_source",
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true
        },
        "images": {
          "kind": "image",
          "array": true,
          "fields": [
            "reference_image_1",
            "reference_image_2",
            "reference_image_3",
            "reference_image_4",
            "reference_image_5"
          ],
          "external_sources_field": "image_sources",
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true
        }
      }
    }
  },
