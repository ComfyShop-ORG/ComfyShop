{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-vidu-q3-reference-to-video",
  "name": "Vidu Q3 参考生视频",
  "description": "用一至四张参考图保持主体外观，生成 3 至 16 秒的视频。",
  "category": "video",
  "fields": [
    {
      "name": "reference_image_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "Santa Claus and the bear hug by the lakeside.",
      "multiline": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "choices": ["16:9", "9:16", "3:4", "4:3", "1:1"],
      "default": "16:9",
      "optional": true
    },
    {
      "name": "movement_amplitude",
      "kind": "choice",
      "default": "auto",
      "choices": ["auto", "small", "medium", "large"],
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": 0,
      "optional": true
    },
    {
      "name": "reference_image_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "image_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "choices": ["540p", "720p", "1080p", "1080p-sr", "1440p-sr"],
      "optional": true
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "optional": true,
      "minimum": "3",
      "maximum": "16",
      "step": "1"
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "reference_image_4",
      "kind": "image",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "reference_image_1",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "movement_amplitude",
      "section": "default"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_3",
      "section": "advanced"
    },
    {
      "fieldId": "image_sources",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_4",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "vidu/q3/reference-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "movement_amplitude": "movement_amplitude",
        "seed": "seed",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "duration": "duration",
        "generate_audio": "generate_audio"
      },
      "required_text": ["prompt"],
      "media": {
        "images": {
          "kind": "image",
          "fields": [
            "reference_image_1",
            "reference_image_2",
            "reference_image_3",
            "reference_image_4"
          ],
          "external_sources_field": "image_sources",
          "min_items": 1,
          "max_bytes": 50000000,
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "image_bounds": {
            "min_side": 128,
            "max_aspect_ratio_exclusive": 4
          },
          "array": true
        }
      }
    }
  },
