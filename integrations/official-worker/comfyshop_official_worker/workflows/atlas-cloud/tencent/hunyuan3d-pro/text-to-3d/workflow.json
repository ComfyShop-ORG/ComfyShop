{
  "format": "service",
  "workerKind": "official",
  "key": "tencent-hunyuan3d-pro-text-to-3d",
  "name": "Hunyuan 3D Pro 文生 3D",
  "description": "根据文字生成带纹理或纯几何的 3D 网格，可设置目标面数。",
  "category": "3d",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "generation_type",
      "kind": "choice",
      "choices": ["Normal", "Geometry"],
      "default": "Normal",
      "optional": true
    },
    {
      "name": "pbr",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "face_count",
      "kind": "integer",
      "minimum": "40000",
      "maximum": "1500000",
      "step": "1",
      "default": 500000,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "generation_type",
      "section": "default"
    },
    {
      "fieldId": "pbr",
      "section": "advanced"
    },
    {
      "fieldId": "face_count",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "3d",
    "additionalOutputKinds": ["image"],
    "config": {
      "operation": "image",
      "model": "tencent/hunyuan3d-pro/text-to-3d",
      "parameters": {
        "prompt": "prompt",
        "generate_type": "generation_type",
        "enable_pbr": "pbr",
        "face_count": "face_count"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 1024
      },
      "enabled_by": {
        "enable_pbr": {
          "parameter": "generate_type",
          "equals": "Normal"
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Hunyuan 3D Pro 文生 3D",
      "description": "根据文字生成带纹理或纯几何的 3D 网格，可设置目标面数。",
      "fields": {
        "prompt": {
          "label": "提示词"
        },
        "generation_type": {
          "label": "生成类型"
        },
        "pbr": {
          "label": "生成 PBR 材质"
        },
        "face_count": {
          "label": "目标面数"
        }
      },
      "parameterLayout": {
        "prompt": {
          "help": "描述物体的形状和外观，最多 1024 个字符。"
        },
        "generation_type": {
          "help": "Normal 生成带纹理的网格，Geometry 生成纯几何白模。"
        },
        "pbr": {
          "help": "Normal 模式可生成金属度、粗糙度和法线贴图。"
        },
        "face_count": {
          "help": "可设置 40000 至 1500000 个面，默认 500000。"
        }
      }
    },
    "zh-tw": {
