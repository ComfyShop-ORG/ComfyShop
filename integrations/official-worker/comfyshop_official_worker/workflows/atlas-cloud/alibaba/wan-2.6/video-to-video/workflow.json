{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-alibaba-wan-2-6-video-to-video",
  "name": "Wan 2.6 视频生视频",
  "description": "参考一至三段视频中的人物、主体与声音生成新视频。",
  "category": "video_tool",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 1500
    },
    {
      "name": "size",
      "kind": "choice",
      "default": "1280*720",
      "optional": false,
      "choices": [
        "1280*720",
        "720*1280",
        "960*960",
        "1088*832",
        "832*1088",
        "1920*1080",
        "1080*1920",
        "1440*1440",
        "1632*1248",
        "1248*1632"
      ]
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 5,
      "optional": true,
      "choices": [5, 10]
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true,
      "minimum": "-1",
      "maximum": "2147483647"
    },
    {
      "name": "negative_prompt",
      "optional": true,
      "kind": "string",
      "multiline": true,
      "maxLength": 500,
      "default": ""
    },
    {
      "name": "enable_prompt_expansion",
      "optional": true,
      "kind": "boolean",
      "default": true
    },
    {
      "name": "shot_type",
      "kind": "choice",
      "optional": true,
      "default": "multi",
      "choices": ["multi", "single"]
    },
    {
      "name": "reference_video_1",
      "kind": "video",
      "optional": true
    },
    {
      "name": "reference_video_2",
      "kind": "video",
      "optional": true
    },
    {
      "name": "reference_video_3",
      "kind": "video",
      "optional": true
    },
    {
      "name": "reference_video_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "reference_video_1",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "shot_type",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "enable_prompt_expansion",
      "section": "advanced"
    },
    {
      "fieldId": "reference_video_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_video_3",
      "section": "advanced"
    },
    {
      "fieldId": "reference_video_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "alibaba/wan-2.6/video-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "seed": "seed",
        "negative_prompt": "negative_prompt",
        "enable_prompt_expansion": "enable_prompt_expansion",
        "shot_type": "shot_type",
        "size": "size"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["negative_prompt"],
      "media": {
        "videos": {
          "kind": "video",
          "fields": ["reference_video_1", "reference_video_2", "reference_video_3"],
          "min_items": 1,
          "array": true,
          "content_types": ["video/mp4", "video/quicktime"],
          "max_bytes": 99999999,
          "min_duration_ms": 2000,
          "max_duration_ms": 30000,
          "external_sources_field": "reference_video_sources",
          "external_urls_only": true
        }
      },
      "choice_constraints": {
        "enable_prompt_expansion": {
          "parameter": "shot_type",
          "values": {
            "multi": true
          }
        }
      }
    }
  },
