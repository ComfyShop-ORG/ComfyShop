      "parameterLayout": {
        "product_image": {
          "help": "上传商品图，最多 10 MB。也可填写公开 URL。"
        },
        "model_image": {
          "help": "可上传一张模特图保持人物一致，最多 10 MB。"
        },
        "user_prompt": {
          "help": "描述品牌、商品亮点和想要的风格。"
        },
        "visual_type": {
          "help": "选择成品样式。默认商品主图，也可让 Atlas 根据商品判断。"
        },
        "ratio": {
          "help": "选择输出宽高比。默认 9:16。"
        },
        "product_source": {
          "help": "填写一个可公开访问的商品图 URL。"
