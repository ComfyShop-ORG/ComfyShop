        "aspect_ratio": {
          "label": "画面比例",
          "choiceLabels": {
            "16:9": "16:9",
            "4:3": "4:3",
            "1:1": "1:1",
            "3:4": "3:4",
            "9:16": "9:16",
            "21:9": "21:9",
            "adaptive": "自适应"
          }
        },
        "resolution": {
          "label": "分辨率"
        },
        "generate_audio": {
          "label": "生成音频"
        },
        "add_watermark": {
          "label": "添加水印"
        },
        "include_last_frame": {
          "label": "导出尾帧"
        },
