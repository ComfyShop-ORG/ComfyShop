{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-flux-kontext-dev-lora",
  "name": "FLUX.1 Kontext Dev LoRA 图像编辑",
  "description": "用提示词和最多三组 LoRA 权重编辑图片。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": true
    },
    {
      "name": "size",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "num_images",
      "kind": "integer",
      "default": 1,
      "minimum": "1",
      "maximum": "4",
      "optional": true
    },
    {
      "optional": true,
      "name": "source_image",
      "kind": "image"
    },
    {
      "optional": true,
      "name": "num_inference_steps",
      "kind": "integer",
      "default": 28,
      "minimum": "1",
      "maximum": "50"
    },
    {
      "optional": true,
      "name": "guidance_scale",
      "kind": "number",
      "default": 2.5,
      "minimum": "0",
      "maximum": "20",
      "step": "0.1"
    },
    {
      "optional": true,
      "name": "seed",
      "kind": "integer",
      "default": -1
    },
    {
      "optional": true,
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false
    },
    {
      "optional": true,
      "name": "source_image_url",
      "kind": "string",
      "default": ""
    },
    {
      "name": "loras",
      "kind": "string",
      "optional": true,
      "multiline": true,
      "default": "[]"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "jpeg",
      "choices": ["jpeg", "png", "webp"]
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "loras",
      "section": "default"
    },
    {
      "fieldId": "num_images",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "source_image",
      "section": "default"
    },
    {
      "fieldId": "num_inference_steps",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "guidance_scale",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_url",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "black-forest-labs/flux-kontext-dev-lora",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "num_images": "num_images",
        "num_inference_steps": "num_inference_steps",
        "guidance_scale": "guidance_scale",
        "seed": "seed",
        "enable_base64_output": "enable_base64_output",
        "loras": "loras",
        "output_format": "output_format",
        "enable_sync_mode": "enable_sync_mode"
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["source_image"],
          "external_sources_field": "source_image_url",
          "external_urls_only": true
        }
      },
      "omit_blank_parameters": ["size", "prompt", "loras"],
      "image_size_limits": {
        "allow_auto": false,
        "min_side": 1,
        "max_side": 1536
      },
      "lora_parameters": {
        "loras": {
          "max_items": 3,
          "scale_range": [0, 4]
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "FLUX.1 Kontext Dev LoRA 图像编辑",
