{
  "format": "service",
  "workerKind": "official",
  "key": "seedream-v50-pro-layer-decomposition",
  "name": "Seedream v5.0 Pro 图层拆分",
  "description": "把一张图片拆成底图和最多 16 张透明 PNG 图层，保留图层顺序和位置数据。",
  "category": "image_tool",
  "fields": [
    {
      "name": "image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "image_source",
      "kind": "string",
      "optional": true,
      "multiline": true,
      "default": "",
      "maxLength": 4194304
    },
    {
      "name": "prompt",
      "kind": "string",
      "optional": true,
      "multiline": true,
      "default": ""
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "choices": ["auto", "1K", "1.5K", "2K"],
      "default": "auto"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "choices": ["jpeg", "png"],
      "default": "jpeg"
    },
    {
      "name": "optimization",
      "kind": "choice",
      "optional": true,
      "choices": ["standard", "fast"],
      "default": "standard"
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "image",
      "section": "default"
    },
    {
      "fieldId": "image_source",
      "section": "advanced"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "advanced"
    },
    {
      "fieldId": "optimization",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "additionalOutputKinds": ["text"],
    "config": {
      "operation": "image",
      "model": "bytedance/seedream-v5.0-pro/layer-decomposition",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "output_format": "output_format",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output"
      },
      "parameter_objects": {
        "optimize_prompt_options": {
          "mode": "optimization"
        }
      },
      "omit_blank_parameters": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["image"],
          "min_items": 1,
          "external_sources_field": "image_source",
          "content_types": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/bmp",
            "image/tiff",
            "image/gif"
          ],
          "max_bytes": 30000000,
          "image_bounds": {
            "min_pixels": 262144,
            "max_pixels": 36000000,
            "max_aspect_ratio": 16
          }
        }
      }
    }
  },
  "translations": {
    "zh": {
