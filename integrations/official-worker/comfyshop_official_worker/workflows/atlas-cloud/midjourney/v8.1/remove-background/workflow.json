{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-mj81-bg",
  "name": "Midjourney V8.1 去除背景",
  "description": "去除图片背景，输出保留主体的透明 PNG。",
  "category": "image_tool",
  "fields": [
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "input_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "input_image_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "input_image",
      "section": "default"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "input_image_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "midjourney/v8.1/remove-background",
      "operation": "image",
      "parameters": {
        "enable_base64_output": "enable_base64_output"
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["input_image"],
          "external_sources_field": "input_image_source",
          "min_items": 1,
          "external_urls_only": true,
          "external_https_only": true
        }
      }
    }
  },
