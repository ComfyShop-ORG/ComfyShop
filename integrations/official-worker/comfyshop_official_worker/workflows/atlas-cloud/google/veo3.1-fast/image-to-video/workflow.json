{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-google-veo3-1-fast-image-to-video",
  "name": "Veo 3.1 Fast 图生视频",
  "description": "让起始图动起来，可选结束图、音频与最高 4K 分辨率。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 8,
      "optional": true,
      "choices": [8, 4, 6]
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "optional": true,
      "choices": ["16:9", "9:16"]
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "optional": true,
      "choices": ["720p", "1080p", "4k"]
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "generate_audio",
      "optional": true,
      "kind": "boolean",
      "default": false
    },
    {
      "name": "negative_prompt",
      "optional": true,
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "last_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "last_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "last_frame",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "last_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "google/veo3.1-fast/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "seed": "seed",
        "generate_audio": "generate_audio",
        "negative_prompt": "negative_prompt"
      },
      "required_text": ["prompt"],
      "choice_bounds": {
        "duration": {
          "parameter": "resolution",
          "ranges": {
            "1080p": [8, 8],
            "4k": [8, 8]
          }
        }
      },
      "omit_blank_parameters": ["negative_prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "content_types": ["image/png", "image/jpeg"],
          "external_urls_only": true
        },
        "last_image": {
          "kind": "image",
          "fields": ["last_frame"],
          "external_sources_field": "last_frame_source",
          "content_types": ["image/png", "image/jpeg"],
          "external_urls_only": true
        }
      }
    }
  },
