{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-qwen2p-text",
  "name": "Qwen Image 2.0 Pro 文生图",
  "description": "根据中文或英文提示词生成图片，可指定尺寸和随机种子。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "",
      "maxLength": 800
    },
    {
      "name": "size",
      "kind": "string",
      "default": "1024*1024",
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "minimum": "-1",
      "maximum": "2147483647",
      "optional": true,
      "default": -1
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "qwen/qwen-image-2.0-pro/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "image_size_limits": {
        "min_side": 512,
        "max_side": 2048,
        "allow_auto": false
      },
      "prediction_endpoint": "result",
      "text_max_lengths": {
        "prompt": 800
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Qwen Image 2.0 Pro 文生图",
