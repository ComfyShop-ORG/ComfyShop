{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-luma-ray32-img",
  "name": "Luma Ray 3.2 图生视频",
  "description": "用首帧和可选尾帧生成 5 秒或 10 秒视频，画面比例随首帧。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "The scene comes alive with gentle, natural motion and cinematic lighting.",
      "optional": true
    },
    {
      "name": "duration_seconds",
      "kind": "choice",
      "choices": [5, 10],
      "optional": true,
      "default": 5
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": ["540p", "720p", "1080p"],
      "optional": true,
      "default": "720p"
    },
    {
      "name": "loop",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "hdr",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "last_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "last_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "last_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration_seconds",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "loop",
      "section": "advanced"
    },
    {
      "fieldId": "hdr",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "last_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "luma/ray-3.2/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "resolution": "resolution",
        "loop": "loop",
        "hdr": "hdr"
      },
      "forbidden_combinations": [
        {
          "loop": true,
          "duration": [10]
        },
        {
          "loop": true,
          "hdr": true
        },
        {
          "hdr": true,
          "duration": [10]
        },
        {
          "hdr": true,
          "resolution": ["540p"]
        }
      ],
      "omit_blank_parameters": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png", "image/webp", "image/gif"],
          "allow_raw_base64": true,
          "allow_asset_references": true
        },
        "last_image": {
          "kind": "image",
          "fields": ["last_frame"],
          "external_sources_field": "last_frame_source",
          "content_types": ["image/jpeg", "image/png", "image/webp", "image/gif"],
          "allow_raw_base64": true,
          "allow_asset_references": true
        }
      }
    }
  },
  "translations": {
