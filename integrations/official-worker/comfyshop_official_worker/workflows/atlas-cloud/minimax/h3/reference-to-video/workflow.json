      "parameterLayout": {
        "prompt": {
          "help": "Describe the scene and action, including which visual details, movements, and rhythms to keep from the references. Include at least one image or video and at most 12 references in total."
        },
        "image_1": {
          "help": "Add up to nine images, each no larger than 30 MB and 256–5,760 pixels per side."
        },
        "video_1": {
          "help": "Add up to three videos. Each is 2–15 seconds and up to 50 MB, with at most 15 seconds in total."
        },
        "audio_1": {
          "help": "Add up to three audio clips. Each is 2–15 seconds and up to 15 MB, with at most 15 seconds in total. Include a reference image or video."
        },
        "duration_seconds": {
          "help": "Choose a duration from 4 to 15 seconds."
        },
        "resolution": {
          "help": "480P, 768P, and 2K are native. ESR tiers enhance native 768P video."
        },
        "aspect_ratio": {
          "help": "Use adaptive to follow the reference media, or select a fixed aspect ratio."
        },
        "expand_prompt": {
