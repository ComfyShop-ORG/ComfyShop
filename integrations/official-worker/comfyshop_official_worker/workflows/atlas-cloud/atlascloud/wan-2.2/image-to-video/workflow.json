{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-atlascloud-wan-2-2-image-to-video",
  "name": "Atlas Cloud Wan 2.2 图生视频",
  "description": "将一张起始图转成 3 至 10 秒的视频，可调整画面动作和镜头。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "480p",
      "optional": true,
      "choices": ["480p", "720p"]
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "optional": true,
      "minimum": "3",
      "maximum": "10",
      "step": "1"
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    },
    {
      "name": "negative_prompt",
      "optional": true,
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": ""
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "atlascloud/wan-2.2/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "duration": "duration",
        "seed": "seed",
        "negative_prompt": "negative_prompt"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["negative_prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png", "image/bmp", "image/webp"],
          "external_urls_only": true
        }
      }
    }
  },
  "translations": {
