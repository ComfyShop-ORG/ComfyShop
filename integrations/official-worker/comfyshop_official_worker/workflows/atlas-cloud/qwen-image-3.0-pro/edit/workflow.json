{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-qwen3p-alter",
  "name": "Qwen Image 3.0 Pro 图片编辑",
  "description": "按提示词编辑图片，可使用 1 至 3 张参考图。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "size",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "image_count",
      "kind": "integer",
      "minimum": "1",
      "maximum": "4",
      "optional": true,
      "default": 1
    },
    {
      "name": "negative_prompt",
      "kind": "string",
      "multiline": true,
      "default": "",
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "minimum": "0",
      "maximum": "2147483647",
      "optional": true
    },
    {
      "name": "prompt_extend",
      "kind": "boolean",
      "optional": true,
      "default": true
    },
    {
      "name": "prompt_extend_mode",
      "kind": "choice",
      "choices": ["direct"],
      "optional": true,
      "default": "direct"
    },
    {
      "name": "reference_image_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "reference_image_1",
      "section": "default"
    },
    {
      "fieldId": "reference_image_2",
      "section": "default"
    },
    {
      "fieldId": "reference_image_3",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "image_count",
      "section": "default"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "prompt_extend",
      "section": "advanced"
    },
    {
      "fieldId": "prompt_extend_mode",
      "section": "hidden"
    },
    {
      "fieldId": "reference_image_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "qwen-image-3.0-pro/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "n": "image_count",
        "negative_prompt": "negative_prompt",
        "seed": "seed",
        "prompt_extend": "prompt_extend",
        "prompt_extend_mode": "prompt_extend_mode"
      },
      "required_text": ["prompt"],
      "image_size_limits": {
        "min_side": 512,
        "max_side": 1440,
        "allow_auto": false
      },
      "omit_blank_parameters": ["size", "negative_prompt"],
      "enabled_by": {
        "prompt_extend_mode": "prompt_extend"
      },
      "media": {
        "reference_image_urls": {
          "kind": "image",
          "array": true,
          "fields": ["reference_image_1", "reference_image_2", "reference_image_3"],
          "min_items": 1,
          "external_sources_field": "reference_image_sources",
          "content_types": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/bmp",
            "image/tiff",
            "image/gif"
          ],
          "max_bytes": 10000000,
          "allow_oss_references": true
        }
      }
    }
  },
