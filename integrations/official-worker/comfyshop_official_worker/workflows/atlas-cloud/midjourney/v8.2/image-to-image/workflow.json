{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-mj82-i2i",
  "name": "Midjourney V8.2 图生图",
  "description": "根据一张输入图片和提示词生成 4 张改编图片，可另外提供风格参考。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "",
      "maxLength": 1024
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "choices": ["1:1", "9:16", "16:9", "4:3", "3:4", "2:3", "3:2", "9:21", "21:9"],
      "optional": true,
      "default": "1:1"
    },
    {
      "name": "hd",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "stylize",
      "kind": "integer",
      "optional": true,
      "default": 0,
      "minimum": "0",
      "maximum": "1000"
    },
    {
      "name": "chaos",
      "kind": "integer",
      "optional": true,
      "default": 0,
      "minimum": "0",
      "maximum": "100"
    },
    {
      "name": "weird",
      "kind": "integer",
      "optional": true,
      "default": 0,
      "minimum": "0",
      "maximum": "3000"
    },
    {
      "name": "quality",
      "kind": "choice",
      "choices": [1, 4],
      "optional": true,
      "default": 1
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true,
      "default": -1
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "style_reference",
      "kind": "image",
      "optional": true
    },
    {
      "name": "style_reference_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "maxLength": 4194304
    },
    {
      "name": "input_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "input_image_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "input_image",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "style_reference",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "hd",
      "section": "default"
    },
    {
      "fieldId": "stylize",
      "section": "advanced"
    },
    {
      "fieldId": "chaos",
      "section": "advanced"
    },
    {
      "fieldId": "weird",
      "section": "advanced"
    },
    {
      "fieldId": "quality",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "style_reference_source",
      "section": "advanced"
    },
    {
      "fieldId": "input_image_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "midjourney/v8.2/image-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "aspect_ratio": "aspect_ratio",
        "hd": "hd",
        "stylize": "stylize",
        "chaos": "chaos",
        "weird": "weird",
        "quality": "quality",
        "seed": "seed",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 1024
      },
      "media": {
        "sref": {
          "kind": "image",
          "fields": ["style_reference"],
          "external_sources_field": "style_reference_source",
          "external_urls_only": true,
          "external_https_only": true
        },
        "image": {
          "kind": "image",
          "fields": ["input_image"],
          "external_sources_field": "input_image_source",
          "min_items": 1,
          "external_urls_only": true,
          "external_https_only": true
        }
      }
    }
  },
