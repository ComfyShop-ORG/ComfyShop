{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-luma-ray32-edit",
  "name": "Luma Ray 3.2 视频编辑",
  "description": "根据提示词编辑原视频，可选择保留原片或重新演绎的程度。",
  "category": "video_tool",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "Restyle the clip with a warm cinematic look and richer color grading."
    },
    {
      "name": "duration_seconds",
      "kind": "choice",
      "choices": [5, 10],
      "optional": true,
      "default": 5
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": ["540p", "720p", "1080p"],
      "optional": true,
      "default": "720p"
    },
    {
      "name": "hdr",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "strength",
      "kind": "choice",
      "choices": [
        "adhere_1",
        "adhere_2",
        "adhere_3",
        "flex_1",
        "flex_2",
        "flex_3",
        "reimagine_1",
        "reimagine_2",
        "reimagine_3"
      ],
      "optional": true,
      "default": "flex_2"
    },
    {
      "name": "source_video",
      "kind": "video",
      "optional": true
    },
    {
      "name": "source_video_url",
      "kind": "string",
      "optional": true,
      "default": ""
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "source_video",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "strength",
      "section": "default"
    },
    {
      "fieldId": "duration_seconds",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "hdr",
      "section": "advanced"
    },
    {
      "fieldId": "source_video_url",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "luma/ray-3.2/video-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "resolution": "resolution",
        "hdr": "hdr",
        "strength": "strength"
      },
      "required_text": ["prompt"],
      "forbidden_combinations": [
        {
          "hdr": true,
          "duration": [10]
        },
        {
          "hdr": true,
          "resolution": ["540p"]
        }
      ],
      "media": {
        "video": {
          "kind": "video",
          "fields": ["source_video"],
          "external_sources_field": "source_video_url",
          "external_urls_only": true,
          "external_https_only": true,
          "min_items": 1,
          "content_types": ["video/mp4"]
        }
      }
    }
  },
  "translations": {
