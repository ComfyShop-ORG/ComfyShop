{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-atlascloud-studio-image-clone",
  "name": "Atlas Cloud Studio 图像复刻",
  "description": "把自己的商品放入参考图的场景。可沿用原图构图与光线，也可参照风格重新创作。",
  "category": "image_tool",
  "fields": [
    {
      "name": "product_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "user_prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "visual_type",
      "kind": "choice",
      "default": "Reference Clone",
      "choices": ["Reference Clone", "Exact Clone"],
      "optional": true
    },
    {
      "name": "ratio",
      "kind": "choice",
      "default": "3:4",
      "choices": ["1:1", "2:3", "3:2", "3:4", "4:3", "16:9", "9:16", "21:9"],
      "optional": true
    },
    {
      "name": "product_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "reference_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "count",
      "kind": "choice",
      "default": 1,
      "choices": [1, 2, 3, 4],
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "2k",
      "choices": ["1k", "2k", "4k"],
      "optional": true
    },
    {
      "name": "format",
      "kind": "choice",
      "default": "png",
      "choices": ["png", "jpeg"],
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "product_image",
      "section": "default"
    },
    {
      "fieldId": "reference_image",
      "section": "default"
    },
    {
      "fieldId": "user_prompt",
      "section": "default"
    },
    {
      "fieldId": "visual_type",
      "section": "default"
    },
    {
      "fieldId": "ratio",
      "section": "default"
    },
    {
      "fieldId": "product_source",
      "section": "advanced"
    },
    {
      "fieldId": "reference_source",
      "section": "advanced"
    },
    {
      "fieldId": "count",
      "section": "advanced"
    },
    {
      "fieldId": "resolution",
      "section": "advanced"
    },
    {
      "fieldId": "format",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "atlascloud/studio/image-clone",
      "operation": "image",
      "parameters": {
        "user_prompt": "user_prompt",
        "visual_type": "visual_type",
        "ratio": "ratio",
        "count": "count",
        "resolution": "resolution",
        "format": "format"
      },
      "required_text": ["user_prompt"],
      "media": {
        "product_image": {
          "kind": "image",
          "fields": ["product_image"],
          "external_sources_field": "product_source",
          "external_urls_only": true,
          "min_items": 1,
          "max_bytes": 10000000
        },
        "reference_image": {
          "kind": "image",
          "fields": ["reference_image"],
          "external_sources_field": "reference_source",
          "external_urls_only": true,
          "min_items": 1,
          "max_bytes": 10000000
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Atlas Cloud Studio 图像复刻",
