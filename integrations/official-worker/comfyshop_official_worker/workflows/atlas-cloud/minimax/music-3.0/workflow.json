        },
        "lyrics": {
          "help": "최대 3500자까지 한 줄씩 입력하세요. [Verse], [Chorus] 등으로 구성을 지정하세요. 연주곡이나 가사 자동 작성에는 비워 두세요."
        },
        "instrumental": {
          "help": "악기 연주를 생성합니다. 켜면 음악 설명을 입력해야 합니다. 기본값은 꺼짐입니다."
        },
        "automatic_lyrics": {
          "help": "음악 설명으로 가사를 작성합니다. 가사를 비우고 연주곡을 끄세요. 기본값은 꺼짐입니다."
        },
        "format": {
          "help": "MP3, WAV, PCM을 지원합니다. 기본값은 MP3입니다."
        },
        "sample_rate": {
          "help": "출력 샘플링 주파수를 선택하세요. 기본값은 44100 Hz입니다."
        },
        "bitrate": {
          "help": "MP3에만 적용됩니다. 기본값은 256000 bit/s입니다."
        },
        "sync_mode": {
          "help": "제출 응답에 결과가 포함되면 바로 읽습니다. 기본값은 꺼짐입니다."
        },
        "base64_output": {
          "help": "켜면 작업 머신이 반환된 오디오를 디코딩합니다. 기본적으로 링크에서 오디오를 받습니다."
        }
      }
    }
  }
}
