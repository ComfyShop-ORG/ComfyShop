          "help": "GIF 生成动画。SVG 以源代码预览，可下载矢量原件。"
        },
        "frame_count": {
          "help": "只用于 GIF。可填 2 至 64，Atlas 按每组最多 8 帧计费。"
        },
        "frame_duration_ms": {
          "help": "只用于 GIF。可填 20 至 2000 毫秒，Atlas 四舍五入到 10 毫秒。"
        },
        "svg_model": {
          "help": "只用于 SVG，用于将参考图绘制为矢量文件。"
        },
        "moderation": {
          "help": "选择 Atlas 的自动或低强度内容审核。"
        },
        "n": {
          "help": "可填 1 至 10。SVG 只能生成 1 份。"
        }
      }
    },
