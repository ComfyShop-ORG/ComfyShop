{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-luma-ray32-text",
  "name": "Luma Ray 3.2 文生视频",
  "description": "根据提示词生成 5 秒或 10 秒视频。5 秒视频可选无缝循环或 HDR。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "A majestic eagle soaring through golden clouds at sunset, slow cinematic dolly-in, warm light."
    },
    {
      "name": "duration_seconds",
      "kind": "choice",
      "choices": [5, 10],
      "optional": true,
      "default": 5
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": ["540p", "720p", "1080p"],
      "optional": true,
      "default": "720p"
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "choices": ["16:9", "9:16", "1:1", "4:3", "3:4", "21:9", "9:21"],
      "optional": true,
      "default": "16:9"
    },
    {
      "name": "loop",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "hdr",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration_seconds",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "loop",
      "section": "advanced"
    },
    {
      "fieldId": "hdr",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "luma/ray-3.2/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "resolution": "resolution",
        "aspect_ratio": "aspect_ratio",
        "loop": "loop",
        "hdr": "hdr"
      },
      "required_text": ["prompt"],
      "forbidden_combinations": [
        {
          "loop": true,
          "duration": [10]
        },
        {
          "loop": true,
          "hdr": true
        },
        {
          "hdr": true,
          "duration": [10]
        },
        {
          "hdr": true,
          "resolution": ["540p"]
        }
      ]
    }
  },
  "translations": {
