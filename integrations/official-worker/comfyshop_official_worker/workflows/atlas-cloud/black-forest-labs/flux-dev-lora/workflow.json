    "en": {
      "name": "FLUX.1 Dev LoRA Image Generation",
      "description": "Generate images with up to five LoRA weights and optionally edit a source image with a mask.",
      "fields": {
        "prompt": {
          "label": "Prompt"
        },
        "loras": {
          "label": "LoRA weights"
