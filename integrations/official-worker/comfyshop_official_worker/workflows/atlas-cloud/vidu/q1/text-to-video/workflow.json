{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-vidu-q1-text-to-video",
  "name": "Vidu Q1 文生视频",
  "description": "根据文字生成 5 秒的 1080p 视频，可选通用或动画风格，并可控制音频和背景音乐。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "style",
      "kind": "choice",
      "default": "general",
      "choices": ["general", "anime"],
      "optional": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "choices": ["16:9", "9:16", "1:1"],
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1080p",
      "choices": ["1080p"],
      "optional": true
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 5,
      "choices": [5],
      "optional": true
    },
    {
      "name": "movement_amplitude",
      "kind": "choice",
      "default": "auto",
      "choices": ["auto", "small", "medium", "large"],
      "optional": true
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "bgm",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "style",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "hidden"
    },
    {
      "fieldId": "duration",
      "section": "hidden"
    },
    {
      "fieldId": "movement_amplitude",
      "section": "advanced"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "bgm",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "vidu/q1/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "style": "style",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "duration": "duration",
        "movement_amplitude": "movement_amplitude",
        "generate_audio": "generate_audio",
        "bgm": "bgm",
        "seed": "seed"
      },
      "required_text": ["prompt"]
    }
  },
