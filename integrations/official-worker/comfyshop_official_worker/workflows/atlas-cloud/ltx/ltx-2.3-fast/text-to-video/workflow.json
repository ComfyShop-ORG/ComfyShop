{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-ltx23fast-text",
  "name": "LTX 2.3 Fast 文生视频",
  "description": "用提示词生成最高 4K 的无声视频，可设置镜头运动。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "A majestic eagle soaring through golden clouds at sunset, slow cinematic dolly-in, warm light."
    },
    {
      "name": "duration_seconds",
      "kind": "choice",
      "choices": [6, 8, 10, 12, 14, 16, 18, 20],
      "optional": true,
      "default": 6
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": ["720p", "1080p", "1440p", "4k"],
      "optional": true,
      "default": "720p"
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "choices": ["16:9", "9:16"],
      "optional": true,
      "default": "16:9"
    },
    {
      "name": "fps",
      "kind": "choice",
      "choices": [24, 25, 48, 50],
      "optional": true,
      "default": 24
    },
    {
      "name": "camera_motion",
      "kind": "choice",
      "choices": [
        "",
        "dolly_in",
        "dolly_out",
        "dolly_left",
        "dolly_right",
        "jib_up",
        "jib_down",
        "static",
        "focus_shift"
      ],
      "optional": true,
      "default": ""
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration_seconds",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "fps",
      "section": "advanced"
    },
    {
      "fieldId": "camera_motion",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "ltx/ltx-2.3-fast/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "resolution": "resolution",
        "aspect_ratio": "aspect_ratio",
        "fps": "fps",
        "camera_motion": "camera_motion"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["camera_motion"],
      "choice_bounds": {
        "duration": [
          {
            "parameter": "resolution",
            "ranges": {
              "1440p": [6, 10],
              "4k": [6, 10]
            }
          },
          {
            "parameter": "fps",
            "ranges": {
              "48": [6, 10],
              "50": [6, 10]
            }
          }
        ]
      },
      "fixed": {
        "generate_audio": false
      }
    }
  },
