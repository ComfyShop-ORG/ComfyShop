    "config": {
      "model": "atlascloud/studio/a-plus-content",
      "operation": "image",
      "parameters": {
        "user_prompt": "user_prompt",
        "ratio": "ratio",
        "resolution": "resolution",
        "format": "format",
        "link": "link"
      },
