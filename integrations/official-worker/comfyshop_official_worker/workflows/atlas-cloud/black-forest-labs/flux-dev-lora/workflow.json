{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-flux-dev-lora",
  "name": "FLUX.1 Dev LoRA 图像生成",
  "description": "用最多五组 LoRA 权重生成图片，也可用源图或蒙版修改局部。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "Super Realism, Woman in a red jacket, snowy, in the style of hyper-realistic portraiture, caninecore, mountainous vistas, timeless beauty, palewave, iconic, distinctive noses --ar 72:101 --stylize 750 --v 6",
      "multiline": true
    },
    {
      "name": "loras",
      "kind": "string",
      "optional": true,
      "multiline": true,
      "default": "[\n  {\n    \"path\": \"strangerzonehf/Flux-Super-Realism-LoRA\",\n    \"scale\": 1\n  }\n]"
    },
    {
      "name": "size",
      "kind": "string",
      "default": "1024*1024",
      "optional": true
    },
    {
      "name": "num_images",
      "kind": "integer",
      "default": 1,
      "minimum": "1",
      "maximum": "4",
      "optional": true
    },
    {
      "optional": true,
      "name": "source_image",
      "kind": "image"
    },
    {
      "optional": true,
      "name": "mask",
      "kind": "image"
    },
    {
      "optional": true,
      "name": "strength",
      "kind": "number",
      "default": 0.8,
      "minimum": "0",
      "maximum": "1",
      "step": "0.01"
    },
    {
      "optional": true,
      "name": "num_inference_steps",
      "kind": "integer",
      "default": 28,
      "minimum": "1",
      "maximum": "50"
    },
    {
      "optional": true,
      "name": "guidance_scale",
      "kind": "number",
      "default": 2.5,
      "minimum": "0",
      "maximum": "20",
      "step": "0.1"
    },
    {
      "optional": true,
      "name": "seed",
      "kind": "integer",
      "default": -1
    },
    {
      "optional": true,
      "name": "source_image_url",
      "kind": "string",
      "default": ""
    },
    {
      "optional": true,
      "name": "mask_url",
      "kind": "string",
      "default": ""
    },
    {
      "name": "cfg_scale",
      "kind": "number",
      "default": 1,
      "minimum": "0",
      "maximum": "20",
      "step": "0.1",
      "optional": true
    },
    {
      "name": "negative_prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "loras",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "num_images",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "source_image",
      "section": "advanced"
    },
    {
      "fieldId": "mask",
      "section": "advanced"
    },
    {
      "fieldId": "strength",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "num_inference_steps",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "guidance_scale",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "source_image_url",
      "section": "advanced"
    },
    {
      "fieldId": "mask_url",
      "section": "advanced"
    },
    {
      "fieldId": "cfg_scale",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "black-forest-labs/flux-dev-lora",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "num_images": "num_images",
        "strength": "strength",
        "num_inference_steps": "num_inference_steps",
        "guidance_scale": "guidance_scale",
        "seed": "seed",
        "loras": "loras",
        "cfg_scale": "cfg_scale",
        "negative_prompt": "negative_prompt"
      },
      "required_text": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["source_image"],
          "external_sources_field": "source_image_url",
          "external_urls_only": true
        },
        "mask_image": {
          "kind": "image",
          "fields": ["mask"],
          "external_sources_field": "mask_url",
          "external_urls_only": true
        }
      },
      "prediction_endpoint": "result",
      "media_requires_any_of": {
        "mask_image": ["image"]
      },
      "lora_parameters": {
        "loras": {
          "max_items": 5,
          "scale_range": [0, 4]
        }
      },
      "omit_blank_parameters": ["loras", "negative_prompt"]
    }
  },
  "translations": {
    "zh": {
      "name": "FLUX.1 Dev LoRA 图像生成",
      "description": "用最多五组 LoRA 权重生成图片，也可用源图或蒙版修改局部。",
      "fields": {
        "prompt": {
          "label": "提示词"
        },
        "loras": {
          "label": "LoRA 权重"
        },
        "size": {
          "label": "图片尺寸"
        },
        "num_images": {
          "label": "出图数量"
        },
        "source_image": {
          "label": "源图"
        },
        "mask": {
          "label": "蒙版"
        },
        "strength": {
          "label": "重绘强度"
        },
        "num_inference_steps": {
          "label": "推理步数"
        },
        "guidance_scale": {
          "label": "引导强度"
        },
        "seed": {
          "label": "随机种子"
        },
        "source_image_url": {
          "label": "源图 URL"
        },
        "mask_url": {
          "label": "蒙版 URL"
        },
        "cfg_scale": {
          "label": "CFG 强度"
        },
        "negative_prompt": {
          "label": "负面提示词"
        }
      },
      "parameterLayout": {
        "prompt": {
          "help": "描述主体、场景、构图和风格。"
        },
        "loras": {
          "help": "填写 JSON 数组，最多五项。每项填写权重路径或 URL，系数 0 至 4，默认 1。"
        },
        "size": {
          "help": "按宽*高填写像素，例如 1024*1024。"
        },
        "num_images": {
          "help": "选择 1 至 4 张。"
        },
        "source_image": {
          "help": "可上传源图，将它用作图生图或蒙版编辑的起点。"
        },
        "mask": {
          "help": "在源图上用白色标出需要生成的区域，用黑色保留其他区域。"
        },
        "strength": {
          "help": "选择 0 至 1，数值越高，对源图改变越大。"
        },
        "num_inference_steps": {
          "help": "选择 1 至 50 步，默认 28 步。"
        },
        "guidance_scale": {
          "help": "选择 0 至 20，数值越高越贴近提示词。默认 2.5。"
        },
        "seed": {
          "help": "输入整数以重用种子，默认 -1 表示随机。"
        },
        "source_image_url": {
          "help": "填写一个公开图片地址，与上传二选一。"
        },
        "mask_url": {
          "help": "填写一个公开蒙版图片地址，与上传二选一。"
        },
        "cfg_scale": {
          "help": "选择 0 至 20。填写负面提示词时须设为大于 1。"
        },
        "negative_prompt": {
          "help": "描述要避开的内容。使用该字段时须将 CFG 强度设为大于 1。"
        }
      }
    },
