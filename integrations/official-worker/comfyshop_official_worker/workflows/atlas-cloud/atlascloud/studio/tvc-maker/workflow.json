        "ratio": {
          "help": "选择宽高比，默认 16:9。竖屏可用 9:16。"
        },
        "generate_audio": {
          "help": "选择是否生成环境声与配乐。默认开启。"
        },
        "count": {
          "help": "选择 1 或 2 条。默认 1 条。"
        },
        "product_source": {
          "help": "填写一个可公开访问的商品图片 URL。"
        },
        "model_source": {
          "help": "填写一个可公开访问的模特图片 URL。"
        }
      }
    },
