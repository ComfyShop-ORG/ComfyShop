{
  "format": "service",
  "workerKind": "official",
  "key": "seedream-v50-flash-edit",
  "name": "Seedream v5.0 Flash 图像编辑",
  "description": "按提示词编辑图片，支持最多 10 张参考图、1.5K 或 2K 尺寸与透明背景。",
  "category": "image_tool",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "choices": [
        "2048*2048",
        "2368*1776",
        "1776*2368",
        "2816*1584",
        "1584*2816",
        "2496*1664",
        "1664*2496",
        "3136*1344",
        "1536*1536",
        "1792*1344",
        "1344*1792",
        "2048*1152",
        "1152*2048",
        "1872*1248",
        "1248*1872",
        "2352*1008"
      ],
      "default": "2048*2048"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "choices": ["jpeg", "png"],
      "default": "jpeg"
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "reference_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_4",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_5",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_6",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_7",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_8",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_9",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_10",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "background",
      "kind": "choice",
      "optional": true,
      "default": "opaque",
      "choices": ["opaque", "transparent"]
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "reference_1",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "reference_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_3",
      "section": "advanced"
    },
    {
      "fieldId": "reference_4",
      "section": "advanced"
