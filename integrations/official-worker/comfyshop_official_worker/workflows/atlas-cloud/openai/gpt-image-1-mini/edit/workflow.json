{
  "format": "service",
  "workerKind": "official",
  "key": "gpt-image-1-mini-edit",
  "name": "GPT Image 1 Mini 图像编辑",
  "description": "按提示词编辑最多 4 张参考图，提供三种尺寸与三档画质。",
  "category": "image_tool",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "quality",
      "kind": "choice",
      "optional": true,
      "default": "medium",
      "choices": ["high", "medium", "low"]
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "default": "1024x1024",
      "choices": ["1024x1024", "1024x1536", "1536x1024"]
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "reference_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_4",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "reference_1",
      "section": "default"
    },
    {
      "fieldId": "quality",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "reference_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_3",
      "section": "advanced"
    },
    {
      "fieldId": "reference_4",
      "section": "advanced"
    },
    {
      "fieldId": "reference_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "openai/gpt-image-1-mini/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "quality": "quality",
        "size": "size",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"],
      "media": {
        "images": {
          "kind": "image",
          "fields": ["reference_1", "reference_2", "reference_3", "reference_4"],
          "array": true,
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png"],
          "external_sources_field": "reference_sources"
        }
      }
    }
  },
