{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-uni1max-text",
  "name": "Luma Uni 1 Max 文生图",
  "description": "使用 Max 档位根据提示词生成图片，可选择宽高比和 JPEG 或 PNG 格式。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "A glass of iced coffee on a marble countertop, morning light streaming through a window."
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "choices": ["1:1", "3:4", "4:3", "9:16", "16:9", "9:21", "21:9"],
      "optional": true,
      "default": "16:9"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "choices": ["jpeg", "png"],
      "optional": true,
      "default": "jpeg"
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "luma/uni-1-max/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "aspect_ratio": "aspect_ratio",
        "output_format": "output_format"
      },
      "required_text": ["prompt"]
    }
  },
  "translations": {
