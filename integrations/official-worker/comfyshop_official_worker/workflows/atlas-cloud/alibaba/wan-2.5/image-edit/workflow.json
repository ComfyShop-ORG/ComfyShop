{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-alibaba-wan-2-5-image-edit",
  "name": "Wan 2.5 图像编辑",
  "description": "根据提示词编辑一至三张图片，可设置输出尺寸和提示词扩写。",
  "category": "image_tool",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 2000
    },
    {
      "name": "size",
      "kind": "choice",
      "default": "1280*1280",
      "choices": [
        "576*1344",
        "720*1280",
        "720*1680",
        "768*1024",
        "800*1200",
        "816*1904",
        "936*1664",
        "960*1280",
        "960*1440",
        "1024*768",
        "1024*1024",
        "1040*1560",
        "1104*1472",
        "1200*800",
        "1280*720",
        "1280*960",
        "1280*1280",
        "1344*576",
        "1440*960",
        "1472*1104",
        "1560*1040",
        "1664*936",
        "1680*720",
        "1904*816"
      ],
      "optional": true
    },
    {
      "name": "custom_size",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true,
      "minimum": "-1",
      "maximum": "2147483647"
