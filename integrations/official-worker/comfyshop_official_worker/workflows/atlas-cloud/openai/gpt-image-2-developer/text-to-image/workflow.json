{
  "format": "service",
  "workerKind": "official",
  "key": "gpt-image-2-developer-text",
  "name": "GPT Image 2 Developer 文生图",
  "description": "通过 GPT Image 2 Developer 生成静态图片，支持自定义尺寸、画质与 JPEG 或 PNG 成品。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "quality",
      "kind": "choice",
      "optional": true,
      "default": "medium",
      "choices": ["low", "medium", "high"]
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "default": "1024x1024",
      "choices": [
        "1024x1024",
        "1024x768",
        "768x1024",
        "1024x1536",
        "1536x1024",
        "2048x2048",
        "2048x1152",
        "1152x2048",
        "2560x1088",
        "1088x2560",
        "2880x2160",
        "2160x2880",
        "3840x2160",
        "2160x3840"
      ]
    },
    {
      "name": "custom_size",
      "kind": "string",
      "optional": true,
      "default": "",
      "maxLength": 9
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "jpeg",
      "choices": ["jpeg", "png"]
    },
    {
      "name": "moderation",
      "kind": "choice",
      "optional": true,
      "default": "low",
      "choices": ["auto", "low"]
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "quality",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "custom_size",
      "section": "advanced"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "moderation",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "openai/gpt-image-2-developer/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "quality": "quality",
        "size": "size",
        "output_format": "output_format",
        "moderation": "moderation",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"],
      "parameter_overrides": {
        "size": "custom_size"
      },
      "image_size_limits": {
        "min_side": 1,
        "max_side": 3840,
        "min_pixels": 655360,
        "max_pixels": 8294400,
        "max_aspect_ratio": 3,
        "allow_auto": false,
        "separator": "x",
        "side_multiple": 16
      }
    }
  },
