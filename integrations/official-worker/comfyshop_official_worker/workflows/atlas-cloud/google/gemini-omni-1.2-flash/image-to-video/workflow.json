      },
      "parameterLayout": {
        "prompt": {
          "help": "描述场景、画面风格、镜头或人物动作。最多 20,000 字符。"
        },
        "first_frame": {
          "help": "上传起始图或在高级区填写其地址。支持 PNG、JPEG、WebP，每张最多 20 MB。"
        },
        "last_frame": {
          "help": "可选。用于指定成片的最后一帧，文件限制与起始帧相同。 提供结束帧时，生成时长最多 10 秒。"
        },
        "duration": {
          "help": "输入 3 至 15 的整数。提供结束帧时最多 10 秒。默认 10 秒。"
        },
        "aspect_ratio": {
          "help": "选择 16:9 横屏或 9:16 竖屏。"
        },
        "resolution": {
          "help": "360p 用于预览，720p 为默认，1080p 和 4K 由模型放大。"
        },
        "thinking_level": {
          "help": "较高的推理程度可能改善复杂任务的效果，生成耗时也可能增加。"
        },
        "seed": {
          "help": "输入整数。-1 由模型随机选取种子。"
        },
        "first_frame_source": {
          "help": "填写一个公开图片 URL 或 Base64 数据网址，与上传二选一。"
        },
        "last_frame_source": {
          "help": "填写一个公开图片 URL 或 Base64 数据网址，与上传二选一。 提供结束帧时，生成时长最多 10 秒。"
        }
      }
    },
