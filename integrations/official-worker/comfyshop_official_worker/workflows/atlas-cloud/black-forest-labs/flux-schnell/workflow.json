          "help": "Choose one to four images."
        },
        "source_image": {
          "help": "Optionally upload an image for image-to-image generation or masked editing."
        },
        "mask": {
          "help": "Mark areas to regenerate in white and areas to preserve in black. Supply a source image with the mask."
        },
        "strength": {
          "help": "Choose 0 to 1. Higher values change the source image more."
        },
        "seed": {
          "help": "Enter an integer to reuse a seed. The default of −1 selects a random seed."
        },
        "enable_base64_output": {
          "help": "Return Base64 image data for the worker to decode and save."
        },
        "enable_safety_checker": {
          "help": "Atlas safety checks are enabled by default."
        },
        "source_image_url": {
          "help": "Enter a public image URL as an alternative to uploading."
        },
        "mask_url": {
          "help": "Enter a public mask image URL as an alternative to uploading."
        },
        "enable_sync_mode": {
          "help": "Wait for Atlas to include the finished images in the submit response."
        }
      }
    },
