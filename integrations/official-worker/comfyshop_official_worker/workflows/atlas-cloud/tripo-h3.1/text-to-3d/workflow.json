        "texture_seed": {
          "help": "指定用于复现纹理的整数种子。"
        },
        "auto_size": {
          "help": "自动将模型缩放到以米为单位的实物尺寸。"
        },
        "quad": {
          "help": "开启时生成四边面网格，交付可下载的 FBX。默认交付可预览的 GLB。"
        }
      }
    },
