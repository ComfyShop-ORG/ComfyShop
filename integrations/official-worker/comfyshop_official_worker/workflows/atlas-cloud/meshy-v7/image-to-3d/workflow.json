{
  "format": "service",
  "workerKind": "official",
  "key": "meshy-v7-image-to-3d",
  "name": "Meshy v7 单图生 3D",
  "description": "用一张参考图生成 3D 模型，可调整纹理、重拓扑和导出格式。",
  "category": "3d",
  "fields": [
    {
      "name": "reference_image",
      "kind": "image"
    },
    {
      "name": "textured",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "detailed_geometry",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "pbr",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "texture_resolution",
      "kind": "choice",
      "choices": ["2k", "4k", "8k"],
      "default": "2k",
      "optional": true
    },
    {
      "name": "texture_prompt",
      "kind": "string",
      "multiline": true,
      "optional": true
    },
    {
      "name": "enhance_input",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "remesh",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "topology",
      "kind": "choice",
      "choices": ["triangle", "quad"],
      "default": "triangle",
      "optional": true
    },
    {
      "name": "face_target",
      "kind": "integer",
      "minimum": "100",
      "maximum": "300000",
      "step": "1",
      "default": 30000,
      "optional": true
    },
    {
      "name": "decimation_level",
      "kind": "choice",
      "choices": [1, 2, 3, 4],
      "optional": true
    },
    {
      "name": "include_original_mesh",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "pose",
      "kind": "choice",
      "choices": ["", "a-pose", "t-pose"],
      "default": "",
      "optional": true
    },
    {
      "name": "real_world_scale",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "origin",
      "kind": "choice",
      "choices": ["bottom", "center"],
      "default": "bottom",
      "optional": true
    },
    {
      "name": "transparent_preview",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "additional_previews",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "moderation",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "texture_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "export_glb",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "export_obj",
      "kind": "boolean",
      "default": false,
