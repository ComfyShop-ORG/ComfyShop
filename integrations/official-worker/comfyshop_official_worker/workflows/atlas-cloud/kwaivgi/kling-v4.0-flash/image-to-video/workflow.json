{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-kwaivgi-kling-v4-0-flash-image-to-video",
  "name": "可灵 4.0 Flash 图生视频",
  "description": "用一张起始图生成 3 至 20 秒的 720p 视频。可用提示词指定动作、场景变化和运镜。",
  "category": "video",
  "fields": [
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "She looks into the camera with a confident smile, adjusts her hair and walks two steps toward the camera; the camera slowly pushes in.",
      "multiline": true,
      "maxLength": 26000,
      "optional": true
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 10,
      "minimum": "3",
      "maximum": "20",
      "step": "1",
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "choices": ["720p"],
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "default": "",
      "optional": true,
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "resolution",
      "section": "hidden"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "kwaivgi/kling-v4.0-flash/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "resolution": "resolution"
      },
      "text_max_lengths": {
        "prompt": 26000
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "allow_raw_base64": true,
          "content_types": ["image/jpeg", "image/png"],
          "min_items": 1,
          "max_bytes": 30000000,
          "image_bounds": {
            "min_side": 300,
            "max_aspect_ratio": 2.5
          }
        }
      },
      "omit_blank_parameters": ["prompt"]
    }
  },
  "translations": {
    "zh": {
