{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-ltx23q-text",
  "name": "LTX 2.3 Quality 文生视频",
  "description": "根据提示词生成视频，可指定帧数、画面尺寸并生成配套音频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "",
      "maxLength": 2000
    },
    {
      "name": "num_frames",
      "kind": "integer",
      "minimum": "25",
      "maximum": "257",
      "step": "8",
      "optional": true,
      "default": 121
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": [
        "square_hd",
        "square",
        "portrait_3_4",
        "portrait_9_16",
        "landscape_4_3",
        "landscape_16_9"
      ],
      "optional": true,
      "default": "landscape_16_9"
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "seed",
      "kind": "integer",
      "minimum": "0",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "num_frames",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "ltx-2.3-quality/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "num_frames": "num_frames",
        "resolution": "resolution",
        "generate_audio": "generate_audio",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 2000
      }
    }
  },
  "translations": {
