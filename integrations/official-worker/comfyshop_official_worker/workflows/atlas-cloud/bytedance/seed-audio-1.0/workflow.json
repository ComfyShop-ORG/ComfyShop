        "audio_2": {
          "help": "支持 MP3、WAV、PCM 或 OGG Opus，单段不超过 30 秒和 10 MB。"
        },
        "inline_2": {
          "help": "开启后以内联 Base64 发送所上传的参考音频。默认上传后使用链接。"
        },
        "speaker_3": {
          "help": "选择一个官方音色，第 3 项只填一种参考来源。"
        },
        "voice_id_3": {
          "help": "填写供应商已注册的音色 ID。该项使用自定义音色时，其他来源留空。"
        },
        "audio_3": {
          "help": "支持 MP3、WAV、PCM 或 OGG Opus，单段不超过 30 秒和 10 MB。"
        },
        "inline_3": {
          "help": "开启后以内联 Base64 发送所上传的参考音频。默认上传后使用链接。"
        },
        "reference_image": {
          "help": "最多一张 JPEG、PNG 或 WebP，最大 10 MB。图片参考须单独使用。"
        },
        "inline_image": {
          "help": "开启后以内联 Base64 发送图片。默认上传后使用链接。"
        }
      }
