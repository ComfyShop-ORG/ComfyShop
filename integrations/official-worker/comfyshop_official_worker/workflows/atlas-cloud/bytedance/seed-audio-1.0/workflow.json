      "parameterLayout": {
        "text": {
          "help": "描述旁白、音效和背景声，最多 3000 字符。使用 @Audio1、@Audio2 或 @Audio3 引用依次提交的音色或音频。"
        },
        "format": {
          "help": "默认 MP3。PCM 返回可下载的裸音频。"
        },
        "sample_rate": {
          "help": "选择输出采样率，默认 24000 Hz。"
        },
        "pitch": {
          "help": "可调整 -12 至 12，默认 0。"
        },
        "speech_rate": {
          "help": "可调整 -50 至 100。-50 为 0.5 倍速，100 为 2 倍速，默认 0。"
        },
        "loudness": {
          "help": "可调整 -50 至 100。-50 为 0.5 倍响度，100 为 2 倍响度，默认 0。"
        },
        "speaker_1": {
          "help": "选择一个官方音色，第 1 项只填一种参考来源。"
        },
        "voice_id_1": {
          "help": "填写供应商已注册的音色 ID。该项使用自定义音色时，其他来源留空。"
        },
        "audio_1": {
          "help": "支持 MP3、WAV、PCM 或 OGG Opus，单段不超过 30 秒和 10 MB。"
        },
        "inline_1": {
          "help": "开启后以内联 Base64 发送所上传的参考音频。默认上传后使用链接。"
        },
        "speaker_2": {
          "help": "选择一个官方音色，第 2 项只填一种参考来源。"
        },
        "voice_id_2": {
          "help": "填写供应商已注册的音色 ID。该项使用自定义音色时，其他来源留空。"
