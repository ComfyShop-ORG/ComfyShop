{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-bytedance-seedance-v1-pro-t2v-720p",
  "name": "Seedance v1 Pro 720p 文生视频",
  "description": "根据文字生成 2 至 12 秒的 480p 视频，可配置画面比例与种子。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "A vibrant illustration centered on a blue macaw. Bold, cheerful, and crisp colors dominate the composition. The background bursts with vivid hues, artistic graphic elements, and organic shapes, enhancing the macaw’s presence. The overall style is expressive, creative, and visually harmonious.",
      "multiline": true,
      "maxLength": 2000
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "choices": ["21:9", "16:9", "4:3", "1:1", "3:4", "9:16"],
      "optional": true
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "minimum": "2",
      "maximum": "12",
      "step": "1",
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "bytedance/seedance-v1-pro-t2v-720p",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "aspect_ratio": "aspect_ratio",
        "duration": "duration",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 2000
      }
    }
  },
