{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-alibaba-wan-2-7-text-to-video",
  "name": "Wan 2.7 文生视频",
  "description": "根据提示词生成最多 15 秒的视频，可选配乐与超分辨率。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 5000
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1080P",
      "optional": true,
      "choices": ["720P", "1080P", "1080P-SR", "1440P-SR"]
    },
    {
      "name": "ratio",
      "kind": "choice",
      "default": "16:9",
      "optional": true,
      "choices": ["16:9", "9:16", "1:1", "4:3", "3:4"]
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "optional": true,
      "minimum": "2",
      "maximum": "15"
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true,
      "minimum": "-1",
      "maximum": "2147483647"
    },
    {
      "name": "negative_prompt",
      "optional": true,
      "kind": "string",
      "multiline": true,
      "maxLength": 500,
      "default": ""
    },
    {
      "name": "soundtrack",
      "optional": true,
      "kind": "audio"
    },
    {
      "name": "soundtrack_source",
      "optional": true,
      "kind": "string",
      "default": ""
    },
    {
      "name": "prompt_extend",
      "optional": true,
      "kind": "boolean",
      "default": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "ratio",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "soundtrack",
      "section": "advanced"
    },
    {
      "fieldId": "soundtrack_source",
      "section": "advanced"
    },
    {
      "fieldId": "prompt_extend",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "alibaba/wan-2.7/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "ratio": "ratio",
        "duration": "duration",
        "seed": "seed",
        "negative_prompt": "negative_prompt",
        "prompt_extend": "prompt_extend"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["negative_prompt"],
      "media": {
        "audio": {
          "kind": "audio",
          "fields": ["soundtrack"],
          "content_types": ["audio/wav", "audio/mpeg"],
          "max_bytes": 15000000,
          "min_duration_ms": 2000,
          "max_duration_ms": 30000,
          "external_urls_only": true,
          "external_sources_field": "soundtrack_source"
        }
      }
    }
  },
  "translations": {
