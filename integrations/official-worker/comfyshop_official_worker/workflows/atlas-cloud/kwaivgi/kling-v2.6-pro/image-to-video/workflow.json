        "last_frame_source": {
          "label": "结束图 URL"
        }
      },
      "parameterLayout": {
        "first_frame": {
          "help": "上传 JPEG 或 PNG。每边至少 300 像素，宽高比为 1:2.5 至 2.5:1，最多 50 MB。"
        },
        "last_frame": {
          "help": "可上传一张结束图控制过渡，格式和尺寸要求与起始图相同。"
