{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-alibaba-happyhorse-1-0-image-to-video",
  "name": "HappyHorse 1.0 图生视频",
  "description": "用起始图生成视频，可用提示词引导动作、风格和场景。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 2500,
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1080p",
      "optional": true,
      "choices": ["720p", "1080p"]
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "optional": true,
      "minimum": "3",
      "maximum": "15"
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true,
      "minimum": "-1",
      "maximum": "2147483647"
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "alibaba/happyhorse-1.0/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "duration": "duration",
        "seed": "seed"
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "max_bytes": 10000000,
          "content_types": ["image/jpeg", "image/png", "image/bmp", "image/webp"],
          "external_urls_only": true,
          "image_bounds": {
            "min_side": 300,
            "max_aspect_ratio": 2.5
          }
        }
      },
      "omit_blank_parameters": ["prompt"]
    }
  },
  "translations": {
