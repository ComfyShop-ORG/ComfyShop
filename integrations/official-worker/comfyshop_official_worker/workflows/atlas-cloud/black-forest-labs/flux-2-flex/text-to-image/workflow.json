        },
        "enable_sync_mode": {
          "help": "让 Atlas 等待图片生成后在提交响应中直接返回成品。"
        },
        "size": {
          "help": "按宽*高填写像素，宽高均为 256 至 2,048。留空时由模型选择。"
        }
