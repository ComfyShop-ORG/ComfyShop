        },
        "output_format": {
          "help": "PNG, JPEG, WebP 중에서 선택하세요. 기본값은 PNG입니다."
        },
        "enable_sync_mode": {
          "help": "결과 업로드를 기다려 요청 응답에서 결과를 바로 반환합니다."
        },
        "enable_base64_output": {
          "help": "이미지를 Base64로 반환하고 작업 머신이 디코딩하여 저장합니다."
        }
      }
    }
  }
}
