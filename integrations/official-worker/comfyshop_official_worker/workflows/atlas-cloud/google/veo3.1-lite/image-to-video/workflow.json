      "parameterLayout": {
        "prompt": {
          "help": "描述主体、场景和镜头。用引号标出对白，可描述音效和环境声。"
        },
        "first_frame": {
          "help": "上传 PNG 或 JPEG 图片，最多 8 MB。也可在高级区填写素材来源。"
        },
        "duration": {
          "help": "720p 时选择 4、6 或 8 秒。1080p 时使用 8 秒。"
