{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-kwaivgi-kling-v2-6-pro-image-to-video",
  "name": "可灵 2.6 专业版图生视频",
  "description": "用起始图生成 5 或 10 秒的视频，可添加结束帧并生成同步声音。",
  "category": "video",
  "fields": [
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "last_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": true
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 5,
      "optional": true,
      "choices": [5, 10]
    },
    {
      "name": "sound",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "last_frame_source",
      "kind": "string",
      "default": "",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "last_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "sound",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "last_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "kwaivgi/kling-v2.6-pro/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "sound": "sound"
      },
      "omit_blank_parameters": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "external_urls_only": true,
          "max_bytes": 50000000,
          "content_types": ["image/jpeg", "image/png"],
          "image_bounds": {
            "min_side": 300,
            "max_aspect_ratio": 2.5
          },
          "min_items": 1
        },
        "last_image": {
          "kind": "image",
          "fields": ["last_frame"],
          "external_sources_field": "last_frame_source",
          "external_urls_only": true,
          "max_bytes": 50000000,
          "content_types": ["image/jpeg", "image/png"],
          "image_bounds": {
            "min_side": 300,
            "max_aspect_ratio": 2.5
          }
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "可灵 2.6 专业版图生视频",
      "description": "用起始图生成 5 或 10 秒的视频，可添加结束帧并生成同步声音。",
      "fields": {
        "first_frame": {
          "label": "起始图"
        },
        "last_frame": {
          "label": "结束图"
