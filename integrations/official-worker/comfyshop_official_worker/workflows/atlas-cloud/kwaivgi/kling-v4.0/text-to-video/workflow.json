{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-kling-4-text-to-video",
  "name": "可灵 4.0 文生视频",
  "description": "从文字生成 3 至 30 秒的视频，可选原生 4K 和 10 位 HDR。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "A single drop of water falls from the tip of a leaf into a shallow dish, creating concentric ripples; warm window light, macro cinematography, photorealistic.",
      "multiline": true,
      "maxLength": 26000,
      "optional": false
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "choices": ["16:9", "9:16", "1:1", "21:9"],
      "optional": true
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 10,
      "minimum": "3",
      "maximum": "30",
      "step": "1",
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1080p",
      "choices": ["720p", "1080p", "4k", "1080p-esr", "2k-esr", "4k-esr"],
      "optional": true
    },
    {
      "name": "dynamic_range",
      "kind": "choice",
      "default": "sdr",
      "optional": true,
      "choices": ["sdr", "hdr"]
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "dynamic_range",
      "section": "default"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "kwaivgi/kling-v4.0/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "resolution": "resolution",
        "aspect_ratio": "aspect_ratio",
        "dynamic_range": "dynamic_range"
      },
      "text_max_lengths": {
        "prompt": 26000
      },
      "required_text": ["prompt"],
      "choice_constraints": {
        "resolution": {
          "parameter": "dynamic_range",
          "values": {
            "hdr": ["1080p", "4k"]
          }
        }
      }
    }
  },
  "translations": {
