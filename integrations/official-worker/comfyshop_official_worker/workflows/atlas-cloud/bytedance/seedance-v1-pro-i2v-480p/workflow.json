{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-seedance-v1-pro-i2v-480p",
  "name": "Seedance v1 Pro 480p 图生视频",
  "description": "使用起始图生成 2 至 12 秒的 480p 视频，可选结束图。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": " A girl turns toward the camera, her earrings swaying gently with the motion. The camera rotates, bathed in dreamy sunlight.",
      "multiline": true,
      "maxLength": 2000,
      "optional": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "",
      "choices": ["", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"],
      "optional": true
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "minimum": "2",
      "maximum": "12",
      "step": "1",
      "optional": false
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "last_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "last_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "last_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "last_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "bytedance/seedance-v1-pro-i2v-480p",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "aspect_ratio": "aspect_ratio",
        "duration": "duration",
        "seed": "seed"
      },
      "text_max_lengths": {
        "prompt": 2000
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "max_bytes": 10000000,
          "content_types": ["image/jpeg", "image/png"],
          "image_bounds": {
            "min_side": 300
          }
        },
        "last_image": {
          "kind": "image",
          "fields": ["last_frame"],
          "external_sources_field": "last_frame_source",
          "max_bytes": 10000000,
          "content_types": ["image/jpeg", "image/png"],
          "image_bounds": {
            "min_side": 300
          }
        }
      },
      "omit_blank_parameters": ["prompt", "aspect_ratio"]
    }
  },
