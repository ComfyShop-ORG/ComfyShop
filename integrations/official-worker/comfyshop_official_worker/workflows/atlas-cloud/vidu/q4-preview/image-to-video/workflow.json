{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-vidu-q4-preview-image",
  "name": "Vidu Q4 Preview 图生视频",
  "description": "根据起始图生成 3 至 16 秒的视频，支持最高 4K、同步音频和提示词扩写。",
  "category": "video",
  "fields": [
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "The girl slowly turns toward the camera and smiles as wind moves through her hair, soft cinematic lighting.",
      "optional": true,
      "maxLength": 20000
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "choices": ["540p", "720p", "1080p", "2k", "4k"],
      "optional": true
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "optional": true,
      "minimum": "3",
      "maximum": "16",
      "step": "1"
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true,
      "default": -1
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "enable_prompt_expansion",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "enable_prompt_expansion",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "vidu/q4-preview/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "duration": "duration",
        "generate_audio": "generate_audio",
        "seed": "seed",
        "enable_prompt_expansion": "enable_prompt_expansion"
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "max_bytes": 50000000,
          "content_types": ["image/jpeg", "image/png", "image/webp"]
        }
      },
      "text_max_lengths": {
        "prompt": 20000
      },
      "omit_blank_parameters": ["prompt"]
    }
  },
  "translations": {
    "zh": {
      "name": "Vidu Q4 Preview 图生视频",
