{
  "format": "service",
  "workerKind": "official",
  "key": "seedream-v50-pro-text-to-image",
  "name": "Seedream v5.0 Pro 文生图",
  "description": "根据提示词生成单张图片，支持 1.5K 和 2K 尺寸档位，可调整提示词优化方式。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "choices": [
        "2048*2048",
        "2368*1776",
        "1776*2368",
        "2816*1584",
        "1584*2816",
        "2496*1664",
        "1664*2496",
        "3136*1344",
        "1024*1024",
        "1536*1536",
        "1776*1328",
        "1328*1776",
        "2048*1152",
        "1152*2048"
      ],
      "default": "2048*2048"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "choices": ["jpeg", "png"],
      "default": "jpeg"
    },
    {
      "name": "thinking",
      "kind": "choice",
      "optional": true,
      "choices": ["enabled", "disabled"],
      "default": "enabled"
    },
    {
      "name": "prompt_optimization_mode",
      "kind": "choice",
      "optional": true,
      "choices": ["standard", "fast"],
      "default": "standard"
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "advanced"
    },
    {
      "fieldId": "thinking",
      "section": "advanced"
    },
    {
      "fieldId": "prompt_optimization_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "bytedance/seedream-v5.0-pro/text-to-image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "output_format": "output_format",
        "thinking": "thinking",
        "prompt_optimization_mode": "prompt_optimization_mode",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"]
    }
  },
