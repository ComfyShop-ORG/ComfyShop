{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-vidu-q3-turbo-image-to-video",
  "name": "Vidu Q3 Turbo 图生视频",
  "description": "根据起始图生成 1 至 16 秒的视频，可控制动作、音频和 FlashVSR 超分。",
  "category": "video",
  "fields": [
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "choices": ["540p", "720p", "1080p", "1080p-sr", "1440p-sr"],
      "optional": true
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "optional": true,
      "minimum": "1",
      "maximum": "16",
      "step": "1"
    },
    {
      "name": "movement_amplitude",
      "kind": "choice",
      "default": "auto",
      "choices": ["auto", "small", "medium", "large"],
      "optional": true
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "bgm",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": ""
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "movement_amplitude",
      "section": "advanced"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "bgm",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "vidu/q3-turbo/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "duration": "duration",
        "movement_amplitude": "movement_amplitude",
        "generate_audio": "generate_audio",
        "bgm": "bgm",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "min_items": 1,
          "external_sources_field": "first_frame_source",
          "external_urls_only": true
        }
      }
    }
  },
  "translations": {
