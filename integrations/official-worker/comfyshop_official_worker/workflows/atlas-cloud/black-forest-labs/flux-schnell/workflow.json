        "mask": {
          "label": "蒙版"
        },
        "strength": {
          "label": "重绘强度"
        },
        "seed": {
          "label": "随机种子"
        },
        "enable_base64_output": {
          "label": "Base64 输出"
        },
        "enable_safety_checker": {
          "label": "安全检查"
