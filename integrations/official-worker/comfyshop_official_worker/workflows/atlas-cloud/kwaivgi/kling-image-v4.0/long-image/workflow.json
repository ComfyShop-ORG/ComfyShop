{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-kwaivgi-kling-image-v4-0-long-image",
  "name": "可灵 Image 4.0 长图",
  "description": "将页面主视觉、商品展示和内容区生成一张完整长图，支持电商详情页与网页视觉设计。",
  "category": "image",
  "fields": [
    {
      "name": "skill",
      "kind": "choice",
      "default": "ecommerce",
      "choices": ["ecommerce", "webpage"]
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "reference_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "length",
      "kind": "choice",
      "default": "medium",
      "choices": ["short", "medium", "long"],
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1k",
      "choices": ["1k", "2k"],
      "optional": true
    },
    {
      "name": "reference_sources",
      "kind": "string",
      "default": "",
      "optional": true,
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "skill",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "reference_1",
      "section": "default"
    },
    {
      "fieldId": "reference_2",
      "section": "advanced"
    },
    {
      "fieldId": "reference_3",
      "section": "advanced"
    },
    {
      "fieldId": "length",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "reference_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "kwaivgi/kling-image-v4.0/long-image",
      "operation": "image",
      "parameters": {
        "skill": "skill",
        "prompt": "prompt",
        "length": "length",
        "resolution": "resolution"
      },
      "required_text": ["prompt"],
      "enabled_by": {
        "length": {
          "parameter": "skill",
          "equals": ["ecommerce"]
        }
      },
      "required_when": {
        "reference_images": {
          "skill": ["ecommerce"]
        }
      },
      "media": {
        "reference_images": {
          "kind": "image",
          "fields": ["reference_1", "reference_2", "reference_3"],
          "external_sources_field": "reference_sources",
          "array": true,
          "allow_raw_base64": true,
          "content_types": ["image/jpeg", "image/png"],
          "max_bytes": 30000000,
          "image_bounds": {
            "min_side": 300,
            "max_aspect_ratio": 2.5
          }
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "可灵 Image 4.0 长图",
      "description": "将页面主视觉、商品展示和内容区生成一张完整长图，支持电商详情页与网页视觉设计。",
      "fields": {
