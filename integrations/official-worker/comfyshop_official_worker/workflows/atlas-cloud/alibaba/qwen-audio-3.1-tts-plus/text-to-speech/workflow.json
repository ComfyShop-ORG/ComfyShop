{
  "format": "service",
  "workerKind": "official",
  "key": "alibaba-qwen-audio-31-tts-plus-text-to-speech",
  "name": "Qwen Audio 3.1 TTS Plus 文本转语音",
  "description": "用通义的预设音色合成语音，可通过指令或 SSML 控制情绪、角色和朗读风格。",
  "category": "audio",
  "fields": [
    {
      "name": "text",
      "kind": "string",
      "default": "Welcome to Atlas Cloud — One API for All Media AI.",
      "multiline": true
    },
    {
      "name": "voice",
      "kind": "choice",
      "choices": ["longanhuan_v3.1", "longanlingxin_v3.1", "xunanchuan_v3.1", "longanfengyue_v3.1"],
      "default": "longanhuan_v3.1"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "choices": ["mp3", "pcm", "wav", "opus"],
      "default": "mp3"
    },
    {
      "name": "sample_rate",
      "kind": "choice",
      "optional": true,
      "choices": [8000, 12000, 16000, 22050, 24000, 44100, 48000],
      "default": 22050
    },
    {
      "name": "speed",
      "kind": "number",
      "optional": true,
      "default": 1,
      "minimum": "0.5",
      "maximum": "2"
    },
    {
      "name": "pitch",
      "kind": "number",
      "optional": true,
      "default": 1,
      "minimum": "0.5",
      "maximum": "2"
    },
    {
      "name": "volume",
      "kind": "integer",
      "optional": true,
      "default": 50,
      "minimum": "0",
      "maximum": "100"
    },
    {
      "name": "bit_rate",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "language_hint",
      "kind": "choice",
      "optional": true,
      "choices": ["", "zh", "en", "ja", "ko", "fr", "de", "pt", "it", "vi", "id"],
      "default": ""
    },
    {
      "name": "instruction",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true
    },
    {
      "name": "enable_ssml",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true,
      "default": -1,
      "minimum": "-1",
      "maximum": "65535"
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "text",
      "section": "default"
    },
    {
      "fieldId": "voice",
      "section": "default"
    },
    {
      "fieldId": "instruction",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "advanced"
    },
    {
      "fieldId": "sample_rate",
      "section": "advanced"
    },
    {
      "fieldId": "speed",
      "section": "advanced"
    },
    {
      "fieldId": "pitch",
      "section": "advanced"
    },
    {
      "fieldId": "volume",
      "section": "advanced"
    },
    {
      "fieldId": "bit_rate",
      "section": "advanced"
    },
    {
      "fieldId": "language_hint",
      "section": "advanced"
    },
    {
      "fieldId": "enable_ssml",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "audio",
    "config": {
      "operation": "audio",
      "model": "alibaba/qwen-audio-3.1-tts-plus/text-to-speech",
      "parameters": {
        "text": "text",
        "voice": "voice",
        "output_format": "output_format",
        "sample_rate": "sample_rate",
        "speed": "speed",
        "pitch": "pitch",
        "volume": "volume",
        "bit_rate": "bit_rate",
        "instruction": "instruction",
        "enable_ssml": "enable_ssml",
        "seed": "seed"
      },
      "required_text": ["text"],
      "text_arrays": {
        "language_hints": {
          "field": "language_hint",
          "max_items": 1,
          "max_item_length": 2
        }
      },
      "enabled_by": {
        "bit_rate": {
          "parameter": "output_format",
          "equals": "opus"
        }
      },
      "audio_suffixes": {
        "pcm": ".pcm",
        "opus": ".opus"
      }
    }
  },
