{
  "format": "service",
  "workerKind": "official",
  "key": "seedream-v47-text-to-image",
  "name": "Seedream v4.7 文生图",
  "description": "根据提示词生成图片，可设置像素尺寸和提示词扩写模式。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "image_size",
      "kind": "choice",
      "choices": [
        "2048*2048",
        "2304*1728",
        "1728*2304",
        "2848*1600",
        "1600*2848",
        "2496*1664",
        "1664*2496",
        "3136*1344",
        "4096*4096",
        "4704*3520",
        "3520*4704",
        "5504*3040",
        "3040*5504",
        "4992*3328",
        "3328*4992",
        "6240*2656",
        "1024*1024",
        "1280*720",
        "720*1280",
        "1248*832",
        "832*1248",
        "1568*672"
      ],
      "default": "2048*2048",
      "optional": true
    },
    {
      "name": "prompt_expansion_mode",
      "kind": "choice",
      "choices": ["standard", "fast"],
      "default": "standard",
      "optional": true
    },
    {
      "name": "base64_output",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "image_size",
      "section": "default"
    },
    {
      "fieldId": "prompt_expansion_mode",
      "section": "advanced"
    },
    {
      "fieldId": "base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "bytedance/seedream-v4.7/text-to-image",
      "parameters": {
        "prompt": "prompt",
        "size": "image_size",
        "prompt_expansion_mode": "prompt_expansion_mode",
        "enable_base64_output": "base64_output"
      },
      "required_text": ["prompt"]
    }
  },
  "translations": {
