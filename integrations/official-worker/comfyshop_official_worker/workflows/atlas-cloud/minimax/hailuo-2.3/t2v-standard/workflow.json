{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-hailuo23-standard-text",
  "name": "Hailuo 2.3 Standard 文生视频",
  "description": "根据提示词生成 6 秒或 10 秒的视频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "",
      "maxLength": 2000
    },
    {
      "name": "duration_seconds",
      "kind": "choice",
      "choices": [6, 10],
      "default": 6,
      "optional": true
    },
    {
      "name": "expand_prompt",
      "kind": "boolean",
      "default": true,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration_seconds",
      "section": "default"
    },
    {
      "fieldId": "expand_prompt",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "minimax/hailuo-2.3/t2v-standard",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "enable_prompt_expansion": "expand_prompt"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 2000
      },
      "prediction_endpoint": "result"
    }
  },
  "translations": {
