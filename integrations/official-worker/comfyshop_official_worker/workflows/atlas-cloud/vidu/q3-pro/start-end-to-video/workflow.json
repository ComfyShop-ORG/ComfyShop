        },
        "first_frame_source": {
          "help": "填写一个公开图片 URL 或带媒体类型的 Base64 数据网址。"
        },
        "last_frame_source": {
          "help": "填写一个公开图片 URL 或带媒体类型的 Base64 数据网址。"
        }
      }
