  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "additionalOutputKinds": ["image"],
    "config": {
      "model": "bytedance/seedance-2.0/reference-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "ratio": "aspect_ratio",
        "resolution": "resolution",
        "bitrate_mode": "bitrate_mode",
        "generate_audio": "generate_audio",
        "seed": "seed",
        "watermark": "add_watermark",
        "return_last_frame": "include_last_frame"
      },
      "omit_blank_parameters": ["prompt"],
      "media": {
        "reference_images": {
          "kind": "image",
          "fields": [
            "reference_image_1",
            "reference_image_2",
            "reference_image_3",
            "reference_image_4",
            "reference_image_5",
            "reference_image_6",
            "reference_image_7",
            "reference_image_8",
            "reference_image_9"
          ],
          "array": true,
          "external_sources_field": "image_sources",
          "allow_asset_references": true,
          "allow_raw_base64": true,
          "content_types": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/bmp",
            "image/tiff",
            "image/gif",
            "image/heic",
            "image/heif"
          ],
          "max_bytes": 29999999,
          "image_bounds": {
            "min_side": 300,
            "max_side": 6000,
            "aspect_ratio_range": [0.4, 2.5]
          }
        },
        "reference_videos": {
          "kind": "video",
          "fields": ["reference_video_1", "reference_video_2", "reference_video_3"],
          "array": true,
          "external_sources_field": "video_sources",
          "allow_asset_references": true,
          "external_urls_only": true,
          "content_types": ["video/mp4", "video/quicktime"],
          "max_bytes": 50000000,
          "min_duration_ms": 2000,
          "max_duration_ms": 15000,
          "max_total_duration_ms": 15000,
          "image_bounds": {
            "min_side": 300,
            "max_side": 6000,
            "aspect_ratio_range": [0.4, 2.5],
            "min_pixels": 409600,
            "max_pixels": 2086876
          }
        },
        "reference_audios": {
          "kind": "audio",
          "fields": ["reference_audio_1", "reference_audio_2", "reference_audio_3"],
          "array": true,
          "external_sources_field": "audio_sources",
          "allow_asset_references": true,
          "allow_raw_base64": true,
          "content_types": ["audio/wav", "audio/wave", "audio/x-wav", "audio/mpeg", "audio/mp3"],
          "max_bytes": 15000000,
          "min_duration_ms": 2000,
          "max_duration_ms": 15000,
          "max_total_duration_ms": 15000
        }
      },
      "media_requires_any_of": {
        "reference_audios": ["reference_images", "reference_videos"]
      }
    }
  },
