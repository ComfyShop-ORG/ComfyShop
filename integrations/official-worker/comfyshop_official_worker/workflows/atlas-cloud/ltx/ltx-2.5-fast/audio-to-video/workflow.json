{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-ltx25fast-audio",
  "name": "LTX 2.5 Fast 音频生成视频",
  "description": "用音频生成同步视频，可配首尾帧和提示词。720p 或 1080p 最长 20 秒。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "A person speaking to camera, natural expression, cinematic lighting.",
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": ["", "720p", "1080p", "1440p", "4k"],
      "optional": true,
      "default": "1080p"
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "choices": ["16:9", "9:16"],
      "optional": true,
      "default": "16:9"
    },
    {
      "name": "fps",
      "kind": "choice",
      "choices": [24, 25, 48, 50],
      "optional": true,
      "default": 24
    },
    {
      "name": "camera_motion",
      "kind": "choice",
      "choices": [
        "",
        "dolly_in",
        "dolly_out",
        "dolly_left",
        "dolly_right",
        "jib_up",
        "jib_down",
        "static",
        "focus_shift"
      ],
      "optional": true,
      "default": ""
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "last_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "last_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "driving_audio",
      "kind": "audio",
      "optional": true
    },
    {
      "name": "driving_audio_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "driving_audio",
      "section": "default"
    },
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "last_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "fps",
      "section": "advanced"
    },
    {
      "fieldId": "camera_motion",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "last_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "driving_audio_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "ltx/ltx-2.5-fast/audio-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "aspect_ratio": "aspect_ratio",
        "fps": "fps",
        "camera_motion": "camera_motion"
      },
      "omit_blank_parameters": ["camera_motion", "prompt", "resolution"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true,
          "allow_asset_references": true
        },
        "last_image": {
          "kind": "image",
          "fields": ["last_frame"],
          "external_sources_field": "last_frame_source",
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true,
          "allow_asset_references": true
        },
        "audio": {
          "kind": "audio",
          "fields": ["driving_audio"],
          "external_sources_field": "driving_audio_source",
          "min_items": 1,
          "content_types": ["audio/mpeg", "audio/mp4", "audio/ogg", "audio/wav"],
          "max_duration_ms": 20000,
          "allow_raw_base64": true,
          "allow_asset_references": true,
          "duration_choice": {
            "parameter": "resolution",
            "maximum_ms": {
              "720p": 20000,
              "1080p": 20000,
              "1440p": 10000,
              "4k": 10000
            }
          }
        }
      },
      "required_any_of": [["prompt", "image"]],
      "media_requires_any_of": {
        "last_image": ["image"]
      }
    }
  },
