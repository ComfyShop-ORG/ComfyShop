      "fields": {
        "video": {
          "label": "原视频"
        },
        "target_resolution": {
          "label": "目标分辨率",
          "choiceLabels": {
            "1080p": "1080p",
            "2k": "2K"
          }
        }
      },
      "parameterLayout": {
        "video": {
          "help": "上传一段帧率不超过 30 fps 的视频。1080p 最多 53 秒且不超过 1590 帧，2K 最多 23 秒且不超过 690 帧。"
        },
        "target_resolution": {
          "help": "默认为 1080p。2K 对应 2560×1440 档位。"
        }
      }
    },
