{
  "format": "service",
  "workerKind": "official",
  "key": "minimax-speech-26-turbo",
  "name": "MiniMax Speech 2.6 Turbo 文本转语音",
  "description": "将文本快速合成为语音，可选择音色、情绪和输出音质。",
  "category": "audio",
  "fields": [
    {
      "name": "text",
      "kind": "string",
      "multiline": true,
      "default": "Welcome to Atlas Cloud — One API for All Media AI."
    },
    {
      "name": "voice",
      "kind": "choice",
      "choices": [
        "English_expressive_narrator",
        "English_radiant_girl",
        "English_magnetic_voiced_man",
        "English_compelling_lady1",
        "English_Aussie_Bloke",
        "English_captivating_female1",
        "English_Upbeat_Woman",
        "English_Trustworth_Man",
        "English_CalmWoman",
        "English_UpsetGirl",
        "English_Gentle-voiced_man",
        "English_Whispering_girl",
        "English_Diligent_Man",
        "English_Graceful_Lady",
        "English_ReservedYoungMan"
      ],
      "default": "English_expressive_narrator",
      "optional": true
    },
    {
      "name": "language",
      "kind": "choice",
      "choices": [
        "auto",
        "English",
        "Chinese",
        "Chinese,Yue",
        "Japanese",
        "Korean",
        "Spanish",
        "French",
        "Portuguese",
        "German",
        "Italian",
        "Arabic",
        "Russian",
        "Indonesian",
        "Thai",
        "Vietnamese"
      ],
      "default": "auto",
      "optional": true
    },
    {
      "name": "speed",
      "kind": "number",
      "minimum": "0.5",
      "maximum": "2",
      "default": 1,
      "optional": true
    },
    {
      "name": "volume",
      "kind": "number",
      "minimum": "0",
      "maximum": "10",
      "default": 1,
      "optional": true
    },
    {
      "name": "pitch",
      "kind": "integer",
      "minimum": "-12",
      "maximum": "12",
      "step": "1",
      "default": 0,
      "optional": true
    },
    {
      "name": "emotion",
      "kind": "choice",
      "choices": [
        "auto",
        "happy",
        "sad",
        "angry",
        "fearful",
        "disgusted",
        "surprised",
        "calm",
        "fluent",
        "neutral"
      ],
      "default": "auto",
      "optional": true
    },
    {
      "name": "format",
      "kind": "choice",
      "choices": ["mp3", "wav", "flac"],
      "default": "mp3",
      "optional": true
    },
    {
      "name": "sample_rate",
      "kind": "choice",
      "choices": [8000, 16000, 22050, 24000, 32000, 44100],
      "default": 32000,
      "optional": true
    },
    {
      "name": "bitrate",
      "kind": "choice",
      "choices": [32000, 64000, 128000, 256000],
      "default": 128000,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "text",
      "section": "default"
    },
    {
      "fieldId": "voice",
      "section": "default"
    },
    {
      "fieldId": "language",
      "section": "default"
    },
    {
      "fieldId": "speed",
      "section": "advanced"
    },
    {
      "fieldId": "volume",
      "section": "advanced"
    },
    {
      "fieldId": "pitch",
      "section": "advanced"
    },
    {
      "fieldId": "emotion",
      "section": "advanced"
    },
    {
      "fieldId": "format",
      "section": "advanced"
    },
    {
      "fieldId": "sample_rate",
      "section": "advanced"
    },
    {
      "fieldId": "bitrate",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "audio",
    "config": {
      "operation": "audio",
      "model": "minimax/speech-2.6-turbo",
      "parameters": {
        "text": "text",
        "voice": "voice",
        "language_boost": "language",
        "speed": "speed",
        "vol": "volume",
        "pitch": "pitch",
        "emotion": "emotion",
        "format": "format",
        "sample_rate": "sample_rate",
        "bitrate": "bitrate"
      },
      "required_text": ["text"],
      "text_max_lengths": {
        "text": 10000
      }
    }
  },
  "translations": {
