{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-vidu-q3-turbo-text-to-video",
  "name": "Vidu Q3 Turbo 文生视频",
  "description": "根据文字生成 1 至 16 秒的视频，可选通用或动画风格、音频及 FlashVSR 超分。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "style",
      "kind": "choice",
      "default": "general",
      "choices": ["general", "anime"],
      "optional": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "4:3",
      "choices": ["16:9", "9:16", "4:3", "3:4", "1:1"],
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "choices": ["540p", "720p", "1080p", "1080p-sr", "1440p-sr"],
      "optional": true
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "optional": true,
      "minimum": "1",
      "maximum": "16",
      "step": "1"
    },
    {
      "name": "movement_amplitude",
      "kind": "choice",
      "default": "auto",
      "choices": ["auto", "small", "medium", "large"],
      "optional": true
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "bgm",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "style",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "movement_amplitude",
      "section": "advanced"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "bgm",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "vidu/q3-turbo/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "style": "style",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "duration": "duration",
        "movement_amplitude": "movement_amplitude",
        "generate_audio": "generate_audio",
        "bgm": "bgm",
        "seed": "seed"
      },
      "required_text": ["prompt"]
    }
  },
