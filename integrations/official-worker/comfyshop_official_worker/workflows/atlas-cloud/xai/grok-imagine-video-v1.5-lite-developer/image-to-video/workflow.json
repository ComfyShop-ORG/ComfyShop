{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-grok-video15-lite-dev-image-to-video",
  "name": "Grok Imagine Video v1.5 Lite Developer 图生视频",
  "description": "从一张起始图和动作提示词生成 1 至 15 秒的视频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "The girl slowly turns toward the camera and smiles as wind moves through her hair, soft cinematic lighting.",
      "multiline": true
    },
    {
      "name": "duration_seconds",
      "kind": "integer",
      "default": 8,
      "minimum": "1",
      "maximum": "15",
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "choices": ["480p", "720p", "1080p"],
      "optional": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "auto",
      "choices": ["auto", "16:9", "9:16", "1:1", "4:3", "3:4", "3:2", "2:3"],
      "optional": true
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration_seconds",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "xai/grok-imagine-video-v1.5-lite-developer/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "resolution": "resolution",
        "aspect_ratio": "aspect_ratio"
      },
      "required_text": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true
        }
      }
    }
  },
