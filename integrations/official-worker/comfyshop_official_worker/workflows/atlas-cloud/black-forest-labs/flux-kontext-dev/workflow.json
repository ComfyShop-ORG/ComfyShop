{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-flux-kontext-dev",
  "name": "FLUX.1 Kontext Dev 图像编辑",
  "description": "根据提示词修改源图，可控制推理参数和出图数量。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "Change the car color to red.",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "num_images",
      "kind": "integer",
      "default": 1,
      "minimum": "1",
      "maximum": "4",
      "optional": true
    },
    {
      "optional": true,
      "name": "source_image",
      "kind": "image"
    },
    {
      "optional": true,
      "name": "num_inference_steps",
      "kind": "integer",
      "default": 28,
      "minimum": "1",
      "maximum": "50"
    },
    {
      "optional": true,
      "name": "guidance_scale",
      "kind": "number",
      "default": 2.5,
      "minimum": "1",
      "maximum": "20",
      "step": "0.1"
    },
    {
      "optional": true,
      "name": "seed",
      "kind": "integer",
      "default": -1
    },
    {
      "optional": true,
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false
    },
    {
      "name": "enable_safety_checker",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "optional": true,
      "name": "source_image_url",
      "kind": "string",
      "default": ""
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "hidden"
    },
    {
      "fieldId": "num_images",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "source_image",
      "section": "default"
    },
    {
      "fieldId": "num_inference_steps",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "guidance_scale",
      "section": "advanced",
      "control": "slider"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "enable_safety_checker",
      "section": "hidden"
    },
    {
      "fieldId": "source_image_url",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "black-forest-labs/flux-kontext-dev",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "num_images": "num_images",
        "num_inference_steps": "num_inference_steps",
        "guidance_scale": "guidance_scale",
        "seed": "seed",
        "enable_base64_output": "enable_base64_output",
        "enable_safety_checker": "enable_safety_checker"
      },
      "required_text": ["prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["source_image"],
          "external_sources_field": "source_image_url",
          "external_urls_only": true
        }
      },
      "prediction_endpoint": "result",
      "omit_blank_parameters": ["size"]
    }
  },
  "translations": {
