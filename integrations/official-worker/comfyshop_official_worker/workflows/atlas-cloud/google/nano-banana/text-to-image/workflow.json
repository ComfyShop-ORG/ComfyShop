{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-google-nano-banana-text-to-image",
  "name": "Nano Banana 文生图",
  "description": "从文字生成图片，可选择宽高比和输出格式。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "optional": true,
      "default": "",
      "choices": ["", "1:1", "3:2", "2:3", "3:4", "4:3", "4:5", "5:4", "9:16", "16:9", "21:9"]
    },
    {
      "name": "top_p",
      "kind": "number",
      "optional": true,
      "default": 0.95,
      "minimum": "0",
      "maximum": "1"
    },
    {
      "name": "temperature",
      "kind": "number",
      "optional": true,
      "default": 1,
      "minimum": "0",
      "maximum": "1"
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true,
      "default": -1
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "media_resolution",
      "kind": "choice",
      "optional": true,
      "default": "default",
      "choices": ["default", "low", "medium", "high"]
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "default",
      "choices": ["default", "png", "jpeg"]
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "top_p",
      "section": "advanced"
    },
    {
      "fieldId": "temperature",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    },
    {
      "fieldId": "media_resolution",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "google/nano-banana/text-to-image",
      "parameters": {
        "prompt": "prompt",
        "aspect_ratio": "aspect_ratio",
        "top_p": "top_p",
        "temperature": "temperature",
        "seed": "seed",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output",
        "media_resolution": "media_resolution",
        "output_format": "output_format"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["aspect_ratio"]
    }
  },
