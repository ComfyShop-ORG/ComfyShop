          "help": "填写一个可公开访问的图片 URL，作为上传图片的替代来源。"
        },
        "seed": {
          "help": "填写整数。-1 使用随机种子。"
        },
        "enable_sync_mode": {
          "help": "开启后，Atlas 在图像生成结束后直接返回结果。默认关闭。"
        },
        "enable_base64_output": {
          "help": "开启后，Atlas 返回 Base64 图像数据。默认返回图片 URL。"
        }
      }
    },
