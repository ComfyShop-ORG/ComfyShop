        "num_images": {
          "help": "每次生成 1 至 4 张，默认 1 张。"
        },
        "seed": {
          "help": "留空时随机选择，也可填写整数复用种子。"
        },
        "custom_size": {
          "help": "填写宽x高，例如 1024x768。支持至 2048×2048 像素。留空时使用尺寸预设。"
