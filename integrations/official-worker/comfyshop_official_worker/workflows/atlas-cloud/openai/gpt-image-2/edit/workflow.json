  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "openai/gpt-image-2/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "quality": "quality",
        "size": "size",
        "output_format": "output_format",
        "moderation": "moderation",
        "enable_sync_mode": "enable_sync_mode",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"],
      "parameter_overrides": {
        "size": "custom_size"
      },
      "image_size_limits": {
        "min_side": 1,
        "max_side": 3840,
        "min_pixels": 655360,
        "max_pixels": 8294400,
        "max_aspect_ratio": 3,
        "allow_auto": false,
        "separator": "x",
        "side_multiple": 16
      },
      "media": {
        "images": {
          "kind": "image",
          "fields": [
            "reference_1",
            "reference_2",
            "reference_3",
            "reference_4",
            "reference_5",
            "reference_6",
            "reference_7",
            "reference_8",
            "reference_9",
            "reference_10"
          ],
          "array": true,
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png"],
          "external_sources_field": "reference_sources"
        }
      }
    }
  },
