{
  "format": "service",
  "workerKind": "official",
  "key": "minimax-music-30",
  "name": "MiniMax Music 3.0 音乐生成",
  "description": "结合音乐描述和歌词生成歌曲。可自动编写歌词，也可生成纯音乐。",
  "category": "audio",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "optional": true,
      "multiline": true,
      "default": ""
    },
    {
      "name": "lyrics",
      "kind": "string",
      "optional": true,
      "multiline": true,
      "default": ""
    },
    {
      "name": "instrumental",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "automatic_lyrics",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "format",
      "kind": "choice",
      "optional": true,
      "choices": ["mp3", "wav", "pcm"],
      "default": "mp3"
    },
    {
      "name": "sample_rate",
      "kind": "choice",
      "optional": true,
      "choices": [16000, 24000, 32000, 44100],
      "default": 44100
    },
    {
      "name": "bitrate",
      "kind": "choice",
      "optional": true,
      "choices": [32000, 64000, 128000, 256000],
      "default": 256000
    },
    {
      "name": "sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "lyrics",
      "section": "default"
    },
    {
      "fieldId": "instrumental",
      "section": "default"
    },
    {
      "fieldId": "automatic_lyrics",
      "section": "default"
    },
    {
      "fieldId": "format",
      "section": "advanced"
    },
    {
      "fieldId": "sample_rate",
      "section": "advanced"
    },
    {
      "fieldId": "bitrate",
      "section": "advanced"
    },
    {
      "fieldId": "sync_mode",
      "section": "advanced"
    },
    {
      "fieldId": "base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "audio",
    "config": {
      "operation": "audio",
      "model": "minimax/music-3.0",
      "parameters": {
        "prompt": "prompt",
        "lyrics": "lyrics",
        "is_instrumental": "instrumental",
        "lyrics_optimizer": "automatic_lyrics",
        "format": "format",
        "sample_rate": "sample_rate",
        "bitrate": "bitrate",
        "enable_sync_mode": "sync_mode",
        "enable_base64_output": "base64_output"
      },
      "text_max_lengths": {
        "prompt": 2000,
        "lyrics": 3500
      },
      "enabled_by": {
        "lyrics": {
          "parameter": "is_instrumental",
          "equals": false
        },
        "lyrics_optimizer": {
          "parameter": "is_instrumental",
          "equals": false
        },
        "bitrate": {
          "parameter": "format",
          "equals": "mp3"
        }
      },
      "required_when": {
        "prompt": [
          {
            "is_instrumental": true
          },
          {
            "lyrics_optimizer": true
          }
        ],
        "lyrics": {
          "is_instrumental": false,
          "lyrics_optimizer": false
        }
      },
      "mutually_exclusive": [["lyrics", "lyrics_optimizer"]]
    }
  },
  "translations": {
    "zh": {
      "name": "MiniMax Music 3.0 音乐生成",
      "description": "结合音乐描述和歌词生成歌曲。可自动编写歌词，也可生成纯音乐。",
      "fields": {
        "prompt": {
          "label": "音乐描述"
        },
        "lyrics": {
          "label": "歌词"
        },
        "instrumental": {
          "label": "纯音乐"
        },
        "automatic_lyrics": {
          "label": "自动写歌词"
        },
        "format": {
          "label": "输出格式"
        },
        "sample_rate": {
          "label": "采样率"
        },
        "bitrate": {
          "label": "MP3 码率"
        },
        "sync_mode": {
          "label": "同步返回"
        },
        "base64_output": {
          "label": "Base64 返回"
        }
      },
      "parameterLayout": {
        "prompt": {
          "help": "描述风格、节奏、乐器和人声，最多 2000 字符。纯音乐和自动写歌词时必填。"
        },
        "lyrics": {
          "help": "最多 3500 字符，每行一句。用 [Verse]、[Chorus] 等标签安排段落。纯音乐或自动写歌词时留空。"
        },
        "instrumental": {
          "help": "仅生成乐器演奏。开启后填写音乐描述。默认关闭。"
        },
        "automatic_lyrics": {
          "help": "根据音乐描述写歌词。开启后清空歌词，并关闭纯音乐。默认关闭。"
        },
        "format": {
          "help": "支持 MP3、WAV 和 PCM，默认 MP3。"
        },
        "sample_rate": {
          "help": "选择成品采样率，默认 44100 Hz。"
        },
        "bitrate": {
          "help": "只用于 MP3，默认 256000 bit/s。"
        },
        "sync_mode": {
          "help": "开启后优先读取提交响应中的生成结果。默认关闭。"
        },
        "base64_output": {
          "help": "开启后工作机解码返回的音频。默认通过链接取得成品。"
        }
      }
    },
    "zh-tw": {
      "name": "MiniMax Music 3.0 音樂生成",
      "description": "結合音樂描述與歌詞產生歌曲。可自動撰寫歌詞，也可產生純音樂。",
      "fields": {
        "prompt": {
          "label": "音樂描述"
