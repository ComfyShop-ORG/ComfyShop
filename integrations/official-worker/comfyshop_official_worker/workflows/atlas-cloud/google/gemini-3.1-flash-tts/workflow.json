{
  "format": "service",
  "workerKind": "official",
  "key": "google-gemini-31-flash-tts",
  "name": "Gemini 3.1 Flash 文生语音",
  "description": "用 Google 预设音色合成语音，可在文本中指导语气、口音、节奏和情绪。",
  "category": "audio",
  "fields": [
    {
      "name": "text",
      "kind": "string",
      "default": "Welcome to Atlas Cloud — One API for All Media AI.",
      "multiline": true,
      "maxLength": 10000
    },
    {
      "name": "voice",
      "kind": "choice",
      "optional": true,
      "choices": [
        "Zephyr",
        "Puck",
        "Charon",
        "Kore",
        "Fenrir",
        "Leda",
        "Orus",
        "Aoede",
        "Callirrhoe",
        "Autonoe",
        "Enceladus",
        "Iapetus",
        "Umbriel",
        "Algieba",
        "Despina",
        "Erinome",
        "Algenib",
        "Rasalgethi",
        "Laomedeia",
        "Achernar",
        "Alnilam",
        "Schedar",
        "Gacrux",
        "Pulcherrima",
        "Achird",
        "Zubenelgenubi",
        "Vindemiatrix",
        "Sadachbia",
        "Sadaltager",
        "Sulafat"
      ],
      "default": "Kore"
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "text",
      "section": "default"
    },
    {
      "fieldId": "voice",
      "section": "default"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "audio",
    "config": {
      "operation": "audio",
      "model": "google/gemini-3.1-flash-tts",
      "parameters": {
        "text": "text",
        "voice": "voice"
      },
      "required_text": ["text"],
      "text_max_lengths": {
        "text": 10000
      }
    }
  },
