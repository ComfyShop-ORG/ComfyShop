{
  "format": "service",
  "workerKind": "official",
  "key": "gpt-image-2-edit",
  "name": "GPT Image 2 图像编辑",
  "description": "按提示词编辑最多 10 张参考图，支持自定义成品尺寸、画质和格式。",
  "category": "image_tool",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "quality",
      "kind": "choice",
      "optional": true,
      "default": "medium",
      "choices": ["low", "medium", "high"]
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "default": "1024x1024",
      "choices": [
        "1024x1024",
        "1024x768",
        "768x1024",
        "1024x1536",
        "1536x1024",
        "2048x2048",
        "2048x1152",
        "1152x2048",
        "2560x1088",
        "1088x2560",
        "2880x2160",
        "2160x2880",
        "3840x2160",
        "2160x3840"
      ]
    },
    {
      "name": "custom_size",
      "kind": "string",
      "optional": true,
      "default": "",
      "maxLength": 9
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "jpeg",
      "choices": ["jpeg", "png"]
    },
    {
      "name": "moderation",
      "kind": "choice",
      "optional": true,
      "default": "low",
      "choices": ["auto", "low"]
    },
    {
      "name": "enable_sync_mode",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
