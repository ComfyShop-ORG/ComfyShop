{
  "format": "service",
  "workerKind": "official",
  "key": "tencent-image-upscaler",
  "name": "腾讯云图片超分",
  "description": "用腾讯云 MPS 增强单张图片，可按倍数、等比适配或固定像素尺寸处理。",
  "category": "image_tool",
  "fields": [
    {
      "name": "image",
      "kind": "image"
    },
    {
      "name": "type",
      "kind": "choice",
      "optional": true,
      "choices": ["standard", "super", "ultra", "fidelity"],
      "default": "ultra"
    },
    {
      "name": "mode",
      "kind": "choice",
      "optional": true,
      "choices": ["percent", "aspect", "fixed"],
      "default": "percent"
    },
    {
      "name": "percent",
      "kind": "number",
      "optional": true,
      "default": 2,
      "minimum": "1",
      "maximum": "10",
      "step": "0.1"
    },
    {
      "name": "width",
      "kind": "integer",
      "optional": true,
      "minimum": "1"
    },
    {
      "name": "height",
      "kind": "integer",
      "optional": true,
      "minimum": "1"
    },
    {
      "name": "long_side",
      "kind": "integer",
      "optional": true,
      "minimum": "1"
    },
    {
      "name": "short_side",
      "kind": "integer",
      "optional": true,
      "minimum": "1"
    },
    {
      "name": "encode_format",
      "kind": "choice",
      "optional": true,
      "choices": ["JPEG", "PNG", "WEBP", "BMP"],
      "default": "JPEG"
    },
    {
      "name": "encode_quality",
      "kind": "integer",
      "optional": true,
      "minimum": "1",
      "maximum": "100",
      "default": 80
    },
    {
      "name": "output_dir",
      "kind": "string",
      "optional": true,
      "default": ""
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "image",
      "section": "default"
    },
    {
      "fieldId": "type",
      "section": "default"
    },
    {
      "fieldId": "mode",
      "section": "default"
    },
    {
      "fieldId": "percent",
      "section": "default"
    },
    {
      "fieldId": "width",
      "section": "advanced"
    },
    {
      "fieldId": "height",
      "section": "advanced"
    },
    {
      "fieldId": "long_side",
      "section": "advanced"
    },
    {
      "fieldId": "short_side",
      "section": "advanced"
    },
    {
      "fieldId": "encode_format",
      "section": "advanced"
    },
    {
      "fieldId": "encode_quality",
      "section": "advanced"
    },
    {
      "fieldId": "output_dir",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "tencent/image/upscaler",
      "prediction_endpoint": "result",
      "parameters": {
        "type": "type",
        "mode": "mode",
        "percent": "percent",
        "width": "width",
        "height": "height",
        "long_side": "long_side",
        "short_side": "short_side",
        "encode_format": "encode_format",
        "encode_quality": "encode_quality",
        "output_dir": "output_dir"
      },
      "media": {
        "image_url": {
          "kind": "image",
          "fields": ["image"],
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png"]
        }
      },
      "omit_blank_parameters": ["output_dir"],
      "required_when": {
        "percent": {
          "mode": ["percent"]
        }
      },
      "enabled_by": {
        "percent": {
          "parameter": "mode",
          "equals": "percent"
        },
        "width": {
          "parameter": "mode",
          "equals": ["aspect", "fixed"]
        },
        "height": {
          "parameter": "mode",
          "equals": ["aspect", "fixed"]
        },
        "long_side": {
          "parameter": "mode",
          "equals": ["aspect", "fixed"]
        },
        "short_side": {
          "parameter": "mode",
          "equals": ["aspect", "fixed"]
        },
        "encode_quality": {
          "parameter": "encode_format",
          "equals": ["JPEG", "WEBP"]
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "腾讯云图片超分",
