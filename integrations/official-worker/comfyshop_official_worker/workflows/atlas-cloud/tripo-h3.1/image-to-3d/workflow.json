{
  "format": "service",
  "workerKind": "official",
  "key": "tripo-h31-image-to-3d",
  "name": "Tripo H3.1 图生 3D",
  "description": "根据一张参考图生成带纹理的 3D 模型，可选择几何精度、材质和网格拓扑。",
  "category": "3d",
  "fields": [
    {
      "name": "reference_image",
      "kind": "image"
    },
    {
      "name": "texture",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "pbr",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "texture_quality",
      "kind": "choice",
      "choices": ["standard", "detailed"],
      "default": "standard",
      "optional": true
    },
    {
      "name": "geometry_quality",
      "kind": "choice",
      "choices": ["standard", "detailed"],
      "default": "standard",
      "optional": true
    },
    {
      "name": "texture_alignment",
      "kind": "choice",
      "choices": ["original_image", "geometry"],
      "default": "original_image",
      "optional": true
    },
    {
      "name": "orientation",
      "kind": "choice",
      "choices": ["default", "align_image"],
      "default": "default",
      "optional": true
    },
    {
      "name": "face_limit",
      "kind": "integer",
      "minimum": "1000",
      "maximum": "2000000",
      "optional": true
    },
    {
      "name": "model_seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "texture_seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "auto_size",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "quad",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "reference_image",
      "section": "default"
    },
    {
      "fieldId": "texture",
      "section": "default"
    },
    {
      "fieldId": "pbr",
      "section": "default"
    },
    {
      "fieldId": "texture_quality",
      "section": "advanced"
    },
    {
      "fieldId": "geometry_quality",
      "section": "advanced"
    },
    {
      "fieldId": "texture_alignment",
      "section": "advanced"
    },
    {
      "fieldId": "orientation",
      "section": "advanced"
    },
    {
      "fieldId": "face_limit",
      "section": "advanced"
    },
    {
      "fieldId": "model_seed",
      "section": "advanced"
    },
    {
      "fieldId": "texture_seed",
      "section": "advanced"
    },
    {
      "fieldId": "auto_size",
      "section": "advanced"
    },
    {
      "fieldId": "quad",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "3d",
    "additionalOutputKinds": ["image"],
    "config": {
      "operation": "image",
      "model": "tripo-h3.1/image-to-3d",
      "parameters": {
        "texture": "texture",
        "pbr": "pbr",
        "texture_quality": "texture_quality",
        "geometry_quality": "geometry_quality",
        "texture_alignment": "texture_alignment",
        "orientation": "orientation",
        "face_limit": "face_limit",
        "model_seed": "model_seed",
        "texture_seed": "texture_seed",
        "auto_size": "auto_size",
        "quad": "quad"
      },
      "media": {
        "image_url": {
          "kind": "image",
          "fields": ["reference_image"],
          "min_items": 1
        }
      }
    }
  },
  "translations": {
