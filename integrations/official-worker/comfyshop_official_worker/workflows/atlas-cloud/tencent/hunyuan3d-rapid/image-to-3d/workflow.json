{
  "format": "service",
  "workerKind": "official",
  "key": "tencent-hunyuan3d-rapid-image-to-3d",
  "name": "Hunyuan 3D Rapid 图生 3D",
  "description": "根据参考图生成 3D 模型，可选择输出格式和材质。",
  "category": "3d",
  "fields": [
    {
      "name": "reference_image",
      "kind": "image"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "choices": ["GLB", "OBJ", "USDZ", "FBX", "STL", "MP4"],
      "default": "GLB",
      "optional": true
    },
    {
      "name": "pbr",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "include_geometry",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "reference_image",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "pbr",
      "section": "advanced"
    },
    {
      "fieldId": "include_geometry",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "3d",
    "additionalOutputKinds": ["image", "video"],
    "config": {
      "operation": "image",
      "model": "tencent/hunyuan3d-rapid/image-to-3d",
      "parameters": {
        "format": "output_format",
        "enable_pbr": "pbr",
        "enable_geometry": "include_geometry"
      },
      "media": {
        "image": {
          "kind": "image",
          "encoding": "base64",
          "fields": ["reference_image"],
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "image_bounds": {
            "min_side": 128,
            "max_side": 5000
          },
          "max_bytes": 4500000
        }
      }
    }
  },
  "translations": {
    "zh": {
      "name": "Hunyuan 3D Rapid 图生 3D",
