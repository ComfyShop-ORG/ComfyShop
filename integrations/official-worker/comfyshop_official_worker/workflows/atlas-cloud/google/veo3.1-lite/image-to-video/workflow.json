        "resolution": {
          "help": "选择 720p 或 1080p。默认 720p，1080p 仅支持 8 秒。"
        },
        "seed": {
          "help": "输入整数。-1 由模型随机选取种子。"
        },
        "first_frame_source": {
          "help": "填写一个公开图片 URL、Base64 数据网址或一行原始 Base64，与上传二选一。"
        }
