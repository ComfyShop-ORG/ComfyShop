      "parameterLayout": {
        "prompt": {
          "help": "描述主体、场景、构图和风格。"
        },
        "size": {
          "help": "按宽*高填写像素，例如 1024*1024。"
        },
        "num_images": {
          "help": "选择 1 至 4 张。"
        },
        "source_image": {
          "help": "可上传源图，将它用作图生图或蒙版编辑的起点。"
        },
        "mask": {
          "help": "在源图上用白色标出需要生成的区域，用黑色保留其他区域。"
        },
        "strength": {
          "help": "选择 0 至 1，数值越高，对源图改变越大。"
        },
        "seed": {
          "help": "输入整数以重用种子，默认 -1 表示随机。"
        },
        "enable_base64_output": {
          "help": "返回 Base64 图像数据，工作机解码后保存成品。"
        },
        "enable_safety_checker": {
          "help": "默认开启 Atlas 安全检查。"
        },
        "source_image_url": {
          "help": "填写一个公开图片地址，与上传二选一。"
        },
        "mask_url": {
          "help": "填写一个公开蒙版图片地址，与上传二选一。"
        },
        "enable_sync_mode": {
          "help": "让 Atlas 等待图片生成后在提交响应中直接返回成品。"
        }
      }
    },
