  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "atlascloud/studio/listing-image-set",
      "operation": "image",
      "parameters": {
        "user_prompt": "user_prompt",
        "ratio": "ratio",
        "resolution": "resolution",
        "format": "format",
        "link": "link"
      },
      "media": {
        "product_image": {
          "kind": "image",
          "fields": ["product_image"],
          "external_sources_field": "product_source",
          "external_urls_only": true,
          "max_bytes": 10000000
        },
        "model_image": {
          "kind": "image",
          "fields": ["model_image"],
          "external_sources_field": "model_source",
          "external_urls_only": true,
          "max_bytes": 10000000
        }
      },
      "omit_blank_parameters": ["user_prompt", "link"],
      "public_url_parameters": ["link"],
      "required_any_of": [["link", "product_image"]],
      "choice_arrays": {
        "visual_type": {
          "encoding": "comma_separated",
          "min_items": 1,
          "options": [
            {
              "field": "main_image",
              "value": "Main Image"
            },
            {
              "field": "multi_angle",
              "value": "Multi-angle View"
