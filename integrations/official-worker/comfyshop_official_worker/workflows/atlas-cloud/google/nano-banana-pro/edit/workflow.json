{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-google-nano-banana-pro-edit",
  "name": "Nano Banana Pro 图像编辑",
  "description": "用提示词修改或融合一至十张参考图，自选分辨率和输出格式。",
