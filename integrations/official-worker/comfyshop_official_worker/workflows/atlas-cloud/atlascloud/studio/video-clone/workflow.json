{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-atlascloud-studio-video-clone",
  "name": "Atlas Cloud Studio 视频复刻",
  "description": "以参考视频的节奏、构图和运镜为模板，替换为自己的商品，并可提供模特图。",
  "category": "video",
  "fields": [
    {
      "name": "reference_video",
      "kind": "video",
      "optional": true
    },
    {
      "name": "product_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "model_image",
      "kind": "image",
      "optional": true
    },
    {
      "name": "user_prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "choices": ["480p", "720p", "720p-esr", "1080p-esr", "1440p-esr", "4k-esr"],
      "optional": true
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 8,
      "minimum": "2",
      "maximum": "30",
      "step": "1",
      "optional": true
    },
    {
      "name": "count",
      "kind": "choice",
      "default": 1,
      "choices": [1, 2, 3, 4],
      "optional": true
    },
    {
      "name": "video_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "product_source",
      "kind": "string",
      "default": "",
      "optional": true
    },
    {
      "name": "model_source",
      "kind": "string",
      "default": "",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "reference_video",
      "section": "default"
    },
    {
      "fieldId": "product_image",
      "section": "default"
    },
    {
      "fieldId": "model_image",
      "section": "default"
    },
    {
      "fieldId": "user_prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "advanced"
    },
    {
      "fieldId": "count",
      "section": "advanced"
    },
    {
      "fieldId": "video_source",
      "section": "advanced"
    },
    {
      "fieldId": "product_source",
      "section": "advanced"
    },
    {
      "fieldId": "model_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "atlascloud/studio/video-clone",
      "operation": "video",
      "parameters": {
        "user_prompt": "user_prompt",
        "resolution": "resolution",
        "duration": "duration",
        "count": "count"
      },
      "omit_blank_parameters": ["user_prompt"],
      "media": {
        "reference_video": {
          "kind": "video",
          "fields": ["reference_video"],
          "external_sources_field": "video_source",
          "external_urls_only": true,
          "min_items": 1,
          "content_types": ["video/mp4", "video/quicktime"],
          "min_duration_ms": 2000,
          "max_duration_ms": 30000
        },
        "product_image": {
          "kind": "image",
          "fields": ["product_image"],
          "external_sources_field": "product_source",
          "external_urls_only": true,
          "min_items": 1,
          "array": true
        },
        "model_image": {
          "kind": "image",
          "fields": ["model_image"],
          "external_sources_field": "model_source",
          "external_urls_only": true,
          "array": true
        }
      }
    }
  },
  "translations": {
