{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-ideo-turbo",
  "name": "Ideogram v4 Turbo 文生图",
  "description": "用提示词生成图片，支持多种横竖构图和 JPEG、PNG 输出。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 2000
    },
    {
      "name": "size_preset",
      "kind": "choice",
      "choices": [
        "square_hd",
        "square",
        "portrait_3_4",
        "portrait_9_16",
        "landscape_4_3",
        "landscape_16_9"
      ],
      "optional": true,
      "default": "landscape_16_9"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "default": "jpeg",
      "optional": true,
      "choices": ["jpeg", "png"]
    },
    {
      "name": "seed",
      "kind": "integer",
      "minimum": "0",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size_preset",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "ideogram/v4/turbo/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "image_size": "size_preset",
        "output_format": "output_format",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 2000
      }
    }
  },
  "translations": {
