{
  "format": "service",
  "workerKind": "official",
  "key": "seedream-v50-flash-text",
  "name": "Seedream v5.0 Flash 文生图",
  "description": "按提示词快速生成一张图片，支持 1.5K 和 2K 尺寸，以及 JPEG 和 PNG。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "choices": [
        "2048*2048",
        "2368*1776",
        "1776*2368",
        "2816*1584",
        "1584*2816",
        "2496*1664",
        "1664*2496",
        "3136*1344",
        "1536*1536",
        "1792*1344",
        "1344*1792",
        "2048*1152",
        "1152*2048",
        "1872*1248",
        "1248*1872",
        "2352*1008"
      ],
      "default": "2048*2048"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "choices": ["jpeg", "png"],
      "default": "jpeg"
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "advanced"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "bytedance/seedream-v5.0-flash/text-to-image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "output_format": "output_format",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"]
    }
  },
