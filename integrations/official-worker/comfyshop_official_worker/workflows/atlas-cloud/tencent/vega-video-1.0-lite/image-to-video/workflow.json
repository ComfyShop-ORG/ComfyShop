{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-vega-video-1-lite-image",
  "name": "腾讯 Vega Video 1.0 Lite 图生视频",
  "description": "用文字和起始图或结束图生成 4 至 15 秒的视频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "A cat wearing a tiny astronaut helmet floats past glowing nebulae in deep space; cinematic, volumetric lighting, 8k.",
      "multiline": true,
      "maxLength": 7000
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "minimum": "4",
      "maximum": "15",
      "step": "1",
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "480P",
      "choices": ["480P", "768P", "1080P", "2K", "4K"],
      "optional": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "choices": ["16:9", "9:16", "1:1", "4:3", "3:4", "adaptive"],
      "optional": true
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "default": true,
      "optional": true
    },
    {
      "name": "storage_mode",
      "kind": "choice",
      "default": "Temporary",
      "choices": ["Permanent", "Temporary"],
      "optional": true
    },
    {
      "name": "generate_mode",
      "kind": "choice",
      "default": "Standard",
      "choices": ["Standard", "Fast", "StandardMovie"],
      "optional": true
    },
    {
      "name": "quality_mode",
      "kind": "choice",
      "default": "Standard",
      "choices": ["Standard", "Fast", "SuperFast"],
      "optional": true
    },
    {
      "name": "enhance_prompt",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "moderation_mode",
      "kind": "choice",
      "default": "Moderation_L1",
      "choices": ["Moderation_L0", "Moderation_L1", "Moderation_L2"],
      "optional": true
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "last_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "last_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "last_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default",
      "control": "slider"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "storage_mode",
      "section": "advanced"
    },
    {
      "fieldId": "generate_mode",
      "section": "advanced"
    },
    {
      "fieldId": "quality_mode",
      "section": "advanced"
    },
    {
      "fieldId": "enhance_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "moderation_mode",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "last_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "tencent/vega-video-1.0-lite/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "resolution": "resolution",
        "aspect_ratio": "aspect_ratio",
        "generate_audio": "generate_audio",
        "storage_mode": "storage_mode",
        "generate_mode": "generate_mode",
        "quality_mode": "quality_mode",
        "enhance_prompt": "enhance_prompt",
        "moderation_mode": "moderation_mode"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 7000
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "max_bytes": 30000000,
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true
        },
        "last_image": {
          "kind": "image",
          "fields": ["last_frame"],
          "external_sources_field": "last_frame_source",
          "max_bytes": 30000000,
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true
        }
      },
      "required_any_of": [["image", "last_image"]]
    }
  },
