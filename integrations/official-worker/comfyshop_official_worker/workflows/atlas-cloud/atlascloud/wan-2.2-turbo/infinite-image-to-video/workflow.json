{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-atlascloud-wan-2-2-turbo-infinite-image-to-video",
  "name": "Atlas Cloud Wan 2.2 Turbo 无限图生视频",
  "description": "从一张起始图生成连续的视频，按顺序执行 1 至 6 段提示词，每段 5 秒。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "The kitten is wandering on the road.",
      "multiline": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "optional": true,
      "choices": ["480p", "720p", "1080p"]
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 5,
      "optional": true,
      "choices": [5]
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "hidden"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "atlascloud/wan-2.2-turbo/infinite-image-to-video",
      "operation": "video",
      "parameters": {
        "resolution": "resolution",
        "duration": "duration",
        "seed": "seed"
      },
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png", "image/bmp", "image/webp"]
        }
      },
      "text_arrays": {
        "prompt": {
          "field": "prompt",
          "min_items": 1,
          "max_items": 6
        }
      }
    }
  },
  "translations": {
