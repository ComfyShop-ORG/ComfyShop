{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-seedance-25-draft-complete",
  "name": "Seedance 2.5 草稿转正式版",
  "description": "使用七天内生成的 Seedance 2.5 草稿 ID 渲染正式视频。",
  "category": "video",
  "fields": [
    {
      "name": "draft_id",
      "kind": "string",
      "default": ""
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1080p",
      "choices": ["1080p", "4k"]
    },
    {
      "name": "video_format",
      "kind": "choice",
      "default": "mp4",
      "choices": ["mp4", "mov"],
      "optional": true
    },
    {
      "name": "add_watermark",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "include_last_frame",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "draft_id",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "video_format",
      "section": "advanced"
    },
    {
      "fieldId": "add_watermark",
      "section": "advanced"
    },
    {
      "fieldId": "include_last_frame",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "additionalOutputKinds": ["image"],
    "config": {
      "model": "bytedance/seedance-2.5/draft-complete",
      "operation": "video",
      "parameters": {
        "draft_id": "draft_id",
        "resolution": "resolution",
        "output_format": "video_format",
        "watermark": "add_watermark",
        "return_last_frame": "include_last_frame"
      },
      "required_text": ["draft_id"]
    }
  },
