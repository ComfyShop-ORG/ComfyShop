        },
        "format": {
          "help": "MP3、WAV、PCM に対応します。既定値は MP3 です。"
        },
        "sample_rate": {
          "help": "出力のサンプリング周波数を選択します。既定値は 44100 Hz です。"
        },
        "bitrate": {
          "help": "MP3 のみに適用されます。既定値は 256000 bit/s です。"
        },
        "sync_mode": {
          "help": "送信時の応答に結果が含まれる場合は直接読み取ります。既定では無効です。"
        },
        "base64_output": {
          "help": "有効にするとワーカーが返された音声をデコードします。既定ではリンクから取得します。"
        }
      }
    },
    "ko": {
      "name": "MiniMax Music 3.0 음악 생성",
      "description": "음악 설명과 가사로 노래를 만듭니다. 가사를 자동으로 쓰거나 연주곡을 만들 수 있습니다.",
      "fields": {
