{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-krea-turbo",
  "name": "Krea 2 Turbo 文生图",
  "description": "根据提示词快速生成一至四张图片，支持预设和自定义尺寸。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "size_preset",
      "kind": "choice",
      "choices": [
        "square_hd",
        "square",
        "portrait_3_4",
        "portrait_9_16",
        "landscape_4_3",
        "landscape_16_9"
      ],
      "optional": true,
      "default": "square_hd"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "default": "png",
      "optional": true,
      "choices": ["png", "jpeg"]
    },
    {
      "name": "num_images",
      "kind": "integer",
      "minimum": "1",
      "maximum": "4",
      "optional": true,
      "default": 1
    },
    {
      "name": "seed",
      "kind": "integer",
      "optional": true
    },
    {
      "name": "custom_size",
      "kind": "string",
      "optional": true,
      "default": ""
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size_preset",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "num_images",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "custom_size",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "krea-2-turbo/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "image_size": "size_preset",
        "output_format": "output_format",
        "num_images": "num_images",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "parameter_overrides": {
        "image_size": "custom_size"
      },
      "image_size_limits": {
        "parameter": "image_size",
        "min_side": 1,
        "max_side": 2048,
        "preset_sizes": [
          "square_hd",
          "square",
          "portrait_3_4",
          "portrait_9_16",
          "landscape_4_3",
          "landscape_16_9"
        ],
        "separator": "x",
        "allow_auto": false
      }
    }
  },
  "translations": {
    "zh": {
