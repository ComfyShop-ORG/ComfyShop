      "parameterLayout": {
        "prompt": {
          "help": "Describe the shape and appearance in up to 800 characters."
        },
        "generation_mode": {
          "help": "Full generates a textured model. Preview generates an untextured mesh."
        },
        "detailed_geometry": {
          "help": "Use higher-fidelity geometry for finer surface detail."
        },
        "pbr": {
          "help": "In full mode, include metallic, roughness, and normal maps."
        },
        "texture_resolution": {
          "help": "Choose a 2K, 4K, or 8K base color map. This setting applies in full mode."
        },
        "texture_prompt": {
          "help": "Describe the surface material in up to 800 characters. This takes priority over the texture image. This setting applies in full mode."
        },
        "remesh": {
          "help": "Enable remeshing to control topology and face count."
        },
        "topology": {
          "help": "Choose a triangle or quad-dominant mesh when remeshing."
        },
        "face_target": {
          "help": "Set 100 to 300000 faces while remeshing. A decimation level takes priority."
        },
        "decimation_level": {
          "help": "Adaptively simplify when remeshing. Levels 1, 2, 3, and 4 target ultra, high, medium, and low face counts."
        },
        "pose": {
          "help": "Choose an A-pose or T-pose. Leave unset to keep the original pose."
        },
        "real_world_scale": {
          "help": "Estimate the object's height and scale the model accordingly."
        },
        "origin": {
          "help": "Place the origin at the bottom or center when auto-scaling."
        },
        "transparent_preview": {
          "help": "Include an additional transparent-background preview."
        },
        "moderation": {
          "help": "Check the text and any supplied texture image before generation."
        },
        "texture_image": {
          "help": "Guide the surface with a PNG or JPEG. A texture prompt takes priority. This setting applies in full mode."
        },
        "export_glb": {
          "help": "Choose at least one 3D file format. GLB is available for online preview."
        },
        "export_obj": {
          "help": "Choose at least one 3D file format. GLB is available for online preview."
        },
        "export_fbx": {
          "help": "Choose at least one 3D file format. GLB is available for online preview."
        },
        "export_stl": {
          "help": "Choose at least one 3D file format. GLB is available for online preview."
        },
        "export_usdz": {
          "help": "Choose at least one 3D file format. GLB is available for online preview."
        },
        "export_3mf": {
          "help": "Choose at least one 3D file format. GLB is available for online preview."
        }
      }
    },
