      "parameterLayout": {
        "skill": {
          "help": "电商详情页需要 1 至 3 张商品参考图，网页视觉可选填。"
        },
        "prompt": {
          "help": "描述页面内容、结构和风格，可按素材顺序使用 @image_1、@image_2 等。"
        },
        "reference_1": {
          "help": "上限 3 张。JPEG 或 PNG，每张最多 30 MB，每边至少 300 像素，宽高比为 2:5 至 5:2。"
        },
        "reference_2": {
          "help": "上限 3 张。JPEG 或 PNG，每张最多 30 MB，每边至少 300 像素，宽高比为 2:5 至 5:2。"
        },
        "reference_3": {
          "help": "上限 3 张。JPEG 或 PNG，每张最多 30 MB，每边至少 300 像素，宽高比为 2:5 至 5:2。"
        },
        "length": {
          "help": "仅电商详情页生效。短约 2 至 5 区块，中约 6 至 10，长约 11 至 18。默认中。"
        },
        "resolution": {
          "help": "选择 1K 或 2K。默认 1K。"
        },
        "reference_sources": {
          "help": "每行填写一个公开 URL、Base64 数据网址或纯 Base64 图片。与上传合计最多 3 张。"
        }
      }
    },
