      "parameterLayout": {
        "prompt": {
          "help": "描述物体的形状和外观，最多 800 个字符。"
        },
        "generation_mode": {
          "help": "full 生成带纹理的模型。preview 生成未贴图的网格。"
        },
        "detailed_geometry": {
          "help": "启用高精度几何，保留更细的表面细节。"
        },
        "pbr": {
          "help": "在 full 模式下，额外生成金属度、粗糙度和法线贴图。"
        },
        "texture_resolution": {
          "help": "基础色贴图尺寸可选 2K、4K 或 8K。 此参数用于 full 模式。"
        },
        "texture_prompt": {
          "help": "描述表面材质，最多 800 字符。文字优先于纹理参考图。 此参数用于 full 模式。"
        },
        "remesh": {
          "help": "开启后可以指定拓扑、目标面数和减面级别。"
        },
        "topology": {
          "help": "重新拓扑时选择三角面或以四边面为主的网格。"
        },
        "face_target": {
          "help": "重新拓扑时的目标面数，100 至 300000。减面级别优先。"
        },
        "decimation_level": {
          "help": "重新拓扑时自适应减面。1、2、3、4 分别对应极高、高、中、低面数。"
        },
        "pose": {
          "help": "可将角色设为 A 姿或 T 姿。未设置时保留原姿态。"
        },
        "real_world_scale": {
          "help": "估算物体的实际高度，再按该尺寸缩放。"
        },
        "origin": {
          "help": "自动缩放时把原点放在底部或中心。"
        },
        "transparent_preview": {
          "help": "额外返回一张透明背景预览图。"
        },
        "moderation": {
          "help": "生成前检查文字和已提供的纹理图。"
        },
        "texture_image": {
          "help": "用单张 PNG 或 JPEG 引导表面纹理。提供纹理提示词时以文字为准。 此参数用于 full 模式。"
        },
        "export_glb": {
          "help": "选择要返回的 3D 文件格式，至少启用一种。GLB 支持在线预览。"
        },
        "export_obj": {
          "help": "选择要返回的 3D 文件格式，至少启用一种。GLB 支持在线预览。"
        },
        "export_fbx": {
          "help": "选择要返回的 3D 文件格式，至少启用一种。GLB 支持在线预览。"
