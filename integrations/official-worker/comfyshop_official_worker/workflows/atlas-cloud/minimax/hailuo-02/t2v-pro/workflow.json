{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-hailuo02-pro-text",
  "name": "Hailuo 02 Pro 文生视频",
  "description": "根据提示词生成固定时长的视频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "The martial artist in the image opens a stage show with a spinning jump kick, slow motion on impact, audience gasps, camera tilts up from the ground",
      "maxLength": 2000
    },
    {
      "name": "expand_prompt",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "expand_prompt",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "minimax/hailuo-02/t2v-pro",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "enable_prompt_expansion": "expand_prompt"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 2000
      },
      "prediction_endpoint": "result"
    }
  },
  "translations": {
