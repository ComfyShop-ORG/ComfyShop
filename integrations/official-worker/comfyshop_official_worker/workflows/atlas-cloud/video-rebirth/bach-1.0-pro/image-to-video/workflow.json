{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-bach-image",
  "name": "Bach 1.0 Pro 图生视频",
  "description": "提供首帧、尾帧或两张图片，生成 5 至 16 秒的视频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "Continue naturally between the endpoint frames.",
      "maxLength": 6500
    },
    {
      "name": "duration",
      "kind": "integer",
      "minimum": "5",
      "maximum": "16",
      "optional": true,
      "default": 5
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": ["1080p", "4k"],
      "optional": true,
      "default": "1080p"
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "optional": true,
      "default": true
    },
    {
      "name": "seed",
      "kind": "integer",
      "minimum": "1",
      "maximum": "100000",
      "optional": true
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "last_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "last_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "last_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "last_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "video-rebirth/bach-1.0-pro/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "resolution": "resolution",
        "generate_audio": "generate_audio",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 6500
      },
      "required_any_of": [["image", "last_image"]],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true,
          "max_bytes": 10000000
        },
        "last_image": {
          "kind": "image",
          "fields": ["last_frame"],
          "external_sources_field": "last_frame_source",
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true,
          "max_bytes": 10000000
        }
      }
    }
  },
  "translations": {
