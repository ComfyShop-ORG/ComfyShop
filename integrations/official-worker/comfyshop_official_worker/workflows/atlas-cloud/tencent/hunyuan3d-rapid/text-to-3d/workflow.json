{
  "format": "service",
  "workerKind": "official",
  "key": "tencent-hunyuan3d-rapid-text-to-3d",
  "name": "Hunyuan 3D Rapid 文生 3D",
  "description": "根据提示词生成 3D 模型，可选择输出格式和材质。",
  "category": "3d",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "output_format",
      "kind": "choice",
      "choices": ["GLB", "OBJ", "USDZ", "FBX", "STL", "MP4"],
      "default": "GLB",
      "optional": true
    },
    {
      "name": "pbr",
      "kind": "boolean",
      "default": false,
      "optional": true
    },
    {
      "name": "include_geometry",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "pbr",
      "section": "advanced"
    },
    {
      "fieldId": "include_geometry",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "3d",
    "additionalOutputKinds": ["image", "video"],
    "config": {
      "operation": "image",
      "model": "tencent/hunyuan3d-rapid/text-to-3d",
      "parameters": {
        "prompt": "prompt",
        "format": "output_format",
        "enable_pbr": "pbr",
        "enable_geometry": "include_geometry"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 1024
      }
    }
  },
  "translations": {
    "zh": {
