{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-qwen2-alter",
  "name": "Qwen Image 2.0 图片编辑",
  "description": "根据提示词编辑一至三张参考图。",
  "category": "image",
  "fields": [
    {
      "name": "reference_image_1",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_2",
      "kind": "image",
      "optional": true
    },
    {
      "name": "reference_image_3",
      "kind": "image",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "",
      "maxLength": 800
    },
    {
      "name": "size",
      "kind": "string",
      "optional": true,
      "default": ""
    },
    {
      "name": "seed",
      "kind": "integer",
      "minimum": "-1",
      "maximum": "2147483647",
      "optional": true,
      "default": -1
    },
    {
      "name": "reference_image_sources",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "reference_image_1",
      "section": "default"
    },
    {
      "fieldId": "reference_image_2",
      "section": "default"
    },
    {
      "fieldId": "reference_image_3",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "reference_image_sources",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "qwen/qwen-image-2.0/edit",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "seed": "seed"
      },
      "required_text": ["prompt"],
      "image_size_limits": {
        "min_side": 512,
        "max_side": 2048,
        "allow_auto": false
      },
      "omit_blank_parameters": ["size"],
      "prediction_endpoint": "result",
      "text_max_lengths": {
        "prompt": 800
      },
      "media": {
        "images": {
          "kind": "image",
          "array": true,
          "fields": ["reference_image_1", "reference_image_2", "reference_image_3"],
          "min_items": 1,
          "external_sources_field": "reference_image_sources",
          "content_types": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/bmp",
            "image/tiff",
            "image/gif"
          ],
          "max_bytes": 10000000
        }
      }
    }
  },
