      "parameterLayout": {
        "first_frame": {
          "help": "上传视频的起始图片。宽高各为 300–6000 像素，宽高比为 0.4–2.5，最大 30 MB。"
        },
        "last_frame": {
          "help": "可上传目标结尾的图片，尺寸和大小限制与首帧相同。"
        },
        "prompt": {
          "help": "描述主体动作和镜头运动。提示词初始为空，采用 Atlas Cloud 的默认值。"
        },
        "duration_seconds": {
          "help": "选择 4 至 30 秒。−1 由模型决定时长。"
        },
        "resolution": {
          "help": "选择 480p 或 720p。"
        },
        "generate_audio": {
          "help": "同时生成与画面同步的声音。"
        },
        "add_watermark": {
          "help": "在成品视频中加入水印。"
        },
        "include_last_frame": {
          "help": "将生成视频的最后一帧作为单独的图片交付。"
        },
        "video_format": {
          "help": "选择 MP4 或 MOV 视频容器。"
        },
        "aspect_ratio": {
          "help": "采用自适应比例，保留首帧图片的宽高比。"
        }
      }
    },
