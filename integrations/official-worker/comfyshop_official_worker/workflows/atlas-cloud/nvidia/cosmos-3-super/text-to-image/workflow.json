{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-cosmos-image",
  "name": "NVIDIA Cosmos 3 Super 文生图",
  "description": "根据提示词生成图片，可选预设尺寸或自定义宽高。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 2500
    },
    {
      "name": "size_preset",
      "kind": "choice",
      "choices": [
        "square_hd",
        "square",
        "portrait_4_3",
        "portrait_16_9",
        "landscape_4_3",
        "landscape_16_9"
      ],
      "optional": true,
      "default": "landscape_16_9"
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "jpeg",
      "choices": ["jpeg", "png"]
    },
    {
      "name": "output_width",
      "kind": "integer",
      "minimum": "1",
      "maximum": "14142",
      "optional": true
    },
    {
      "name": "output_height",
      "kind": "integer",
      "minimum": "1",
      "maximum": "14142",
      "optional": true
    },
    {
      "name": "negative_prompt",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true
    },
    {
      "name": "num_inference_steps",
      "kind": "integer",
      "minimum": "1",
      "maximum": "50",
      "optional": true,
      "default": 28
    },
    {
      "name": "guidance_scale",
      "kind": "number",
      "minimum": "1",
      "maximum": "20",
      "optional": true,
      "default": 4
    },
    {
      "name": "seed",
      "kind": "integer",
      "minimum": "0",
      "optional": true
    },
    {
      "name": "enable_safety_checker",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size_preset",
      "section": "default"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "output_width",
      "section": "advanced"
    },
    {
      "fieldId": "output_height",
      "section": "advanced"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "num_inference_steps",
      "section": "advanced"
    },
    {
      "fieldId": "guidance_scale",
      "section": "advanced"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "enable_safety_checker",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "nvidia/cosmos-3-super/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "image_size": "size_preset",
        "output_format": "output_format",
        "negative_prompt": "negative_prompt",
        "num_inference_steps": "num_inference_steps",
        "guidance_scale": "guidance_scale",
        "seed": "seed",
        "enable_safety_checker": "enable_safety_checker"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 2500
      },
      "parameter_objects": {
        "image_size": {
          "width": "output_width",
          "height": "output_height"
        }
      }
    }
  },
  "translations": {
