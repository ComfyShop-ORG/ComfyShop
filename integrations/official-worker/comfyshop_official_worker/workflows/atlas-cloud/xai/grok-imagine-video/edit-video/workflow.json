{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-grok-video-edit",
  "name": "Grok Imagine Video 视频编辑",
  "description": "按文字指示编辑一段 MP4，保留原视频长度。",
  "category": "video_tool",
  "fields": [
    {
      "name": "source_video",
      "kind": "video",
      "optional": true
    },
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "video_source",
      "kind": "string",
      "default": "",
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "source_video",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "video_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "xai/grok-imagine-video/edit-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt"
      },
      "required_text": ["prompt"],
      "media": {
        "video_url": {
          "kind": "video",
          "fields": ["source_video"],
          "external_sources_field": "video_source",
          "external_urls_only": true,
          "content_types": ["video/mp4"],
          "max_duration_ms": 8700,
          "min_items": 1
        }
      }
    }
  },
  "translations": {
