        },
        "enable_sync_mode": {
          "help": "等待 Atlas 完成后在提交响应中取结果。"
        },
        "enable_base64_output": {
          "help": "要求 Atlas 以内联 Base64 返回成品，工作机解码后保存。"
        }
      }
    },
