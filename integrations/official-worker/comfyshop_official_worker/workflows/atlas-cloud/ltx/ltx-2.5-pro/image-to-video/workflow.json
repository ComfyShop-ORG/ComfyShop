{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-ltx25pro-image",
  "name": "LTX 2.5 Pro 图生视频",
  "description": "从首帧图片生成最高 4K 的视频，可指定尾帧并生成同步音频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "The scene comes alive with gentle, natural motion and cinematic lighting.",
      "optional": true
    },
    {
      "name": "duration_seconds",
      "kind": "choice",
      "choices": [-1, 6, 8, 10],
      "optional": true,
      "default": -1
    },
    {
      "name": "resolution",
      "kind": "choice",
      "choices": ["720p", "1080p", "1440p", "4k"],
      "optional": true,
      "default": "720p"
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "choices": ["16:9", "9:16"],
      "optional": true,
      "default": "16:9"
    },
    {
      "name": "fps",
      "kind": "choice",
      "choices": [24, 48],
      "optional": true,
      "default": 24
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "optional": true,
      "default": true
    },
    {
      "name": "camera_motion",
      "kind": "choice",
      "choices": [
        "",
        "dolly_in",
        "dolly_out",
        "dolly_left",
        "dolly_right",
        "jib_up",
        "jib_down",
        "static",
        "focus_shift"
      ],
      "optional": true,
      "default": ""
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "last_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "last_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "last_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration_seconds",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "fps",
      "section": "advanced"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "camera_motion",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "last_frame_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "ltx/ltx-2.5-pro/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "resolution": "resolution",
        "aspect_ratio": "aspect_ratio",
        "fps": "fps",
        "generate_audio": "generate_audio",
        "camera_motion": "camera_motion"
      },
      "omit_blank_parameters": ["camera_motion", "prompt"],
      "media": {
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true,
          "allow_asset_references": true
        },
        "last_image": {
          "kind": "image",
          "fields": ["last_frame"],
          "external_sources_field": "last_frame_source",
          "content_types": ["image/jpeg", "image/png", "image/webp"],
          "allow_raw_base64": true,
          "allow_asset_references": true
        }
      }
    }
  },
