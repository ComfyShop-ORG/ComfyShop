{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-alibaba-wan-2-7-image-to-video",
  "name": "Wan 2.7 图生视频与续写",
  "description": "用起始图生成视频，或续写原视频。可指定结束帧。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 5000,
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1080P",
      "optional": true,
      "choices": ["720P", "1080P", "1080P-SR", "1440P-SR"]
    },
    {
      "name": "duration",
      "kind": "integer",
      "default": 5,
      "optional": true,
      "minimum": "2",
      "maximum": "15"
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true,
      "minimum": "-1",
      "maximum": "2147483647"
    },
    {
      "name": "negative_prompt",
      "optional": true,
      "kind": "string",
      "multiline": true,
      "maxLength": 500,
      "default": ""
    },
    {
      "name": "soundtrack",
      "optional": true,
      "kind": "audio"
    },
    {
      "name": "soundtrack_source",
      "optional": true,
      "kind": "string",
      "default": ""
    },
    {
      "name": "prompt_extend",
      "optional": true,
      "kind": "boolean",
      "default": true
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "last_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "last_frame_source",
      "kind": "string",
      "optional": true,
      "default": "",
      "multiline": true,
      "maxLength": 4194304
    },
    {
      "name": "video",
      "kind": "video",
      "optional": true
    },
    {
      "name": "video_source",
      "kind": "string",
      "optional": true,
      "default": ""
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "last_frame",
      "section": "default"
    },
    {
      "fieldId": "video",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "soundtrack",
      "section": "advanced"
    },
    {
      "fieldId": "soundtrack_source",
      "section": "advanced"
    },
    {
      "fieldId": "prompt_extend",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "last_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "video_source",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "alibaba/wan-2.7/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "resolution": "resolution",
        "duration": "duration",
        "seed": "seed",
        "negative_prompt": "negative_prompt",
        "prompt_extend": "prompt_extend"
      },
      "omit_blank_parameters": ["negative_prompt", "prompt"],
      "media": {
        "audio": {
          "kind": "audio",
          "fields": ["soundtrack"],
          "content_types": ["audio/wav", "audio/mpeg"],
          "max_bytes": 15000000,
          "min_duration_ms": 2000,
          "max_duration_ms": 30000,
          "external_urls_only": true,
          "external_sources_field": "soundtrack_source"
        },
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "max_bytes": 20000000,
          "content_types": ["image/jpeg", "image/png", "image/bmp", "image/webp"],
          "external_urls_only": true,
          "image_bounds": {
            "min_side": 240,
            "max_side": 8000,
            "max_aspect_ratio": 8
          },
          "reject_png_alpha": true
        },
        "last_image": {
          "kind": "image",
          "fields": ["last_frame"],
          "external_sources_field": "last_frame_source",
          "max_bytes": 20000000,
          "content_types": ["image/jpeg", "image/png", "image/bmp", "image/webp"],
          "external_urls_only": true,
          "image_bounds": {
            "min_side": 240,
            "max_side": 8000,
            "max_aspect_ratio": 8
          },
          "reject_png_alpha": true
        },
        "video": {
          "kind": "video",
          "fields": ["video"],
          "external_sources_field": "video_source",
          "external_urls_only": true,
          "content_types": ["video/mp4", "video/quicktime"],
          "min_duration_ms": 2000,
          "max_duration_ms": 10000,
          "max_bytes": 100000000
        }
      },
      "required_one_of": [["image", "video"]],
      "mutually_exclusive": [["video", "audio"]]
    }
  },
