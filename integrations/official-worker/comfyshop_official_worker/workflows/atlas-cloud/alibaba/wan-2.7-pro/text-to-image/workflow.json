        },
        "thinking_mode": {
          "help": "모델이 구도와 장면을 더 자세히 해석합니다. 기본값은 켜짐입니다."
        },
        "seed": {
          "help": "무작위 시드는 -1을 입력합니다. 고정하려면 0에서 2147483647 사이의 정수를 지정합니다."
        },
        "enable_sync_mode": {
          "help": "생성이 끝날 때까지 기다렸다가 제출 응답으로 결과를 받습니다."
