{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-grok-image-quality-text-to-image",
  "name": "Grok Imagine Image Quality 文生图",
  "description": "用文字生成一到四张图，可选 1K 或 2K 以及多种画面比例。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "A collage of London landmarks in a stenciled street-art style.",
      "multiline": true
    },
    {
      "name": "num_images",
      "kind": "choice",
      "default": 1,
      "choices": [1, 2, 3, 4],
      "optional": true
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "1:1",
      "choices": [
        "1:1",
        "3:4",
        "4:3",
        "9:16",
        "16:9",
        "2:3",
        "3:2",
        "9:19.5",
        "19.5:9",
        "9:20",
        "20:9",
        "1:2",
        "2:1"
      ],
      "optional": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1k",
      "choices": ["1k", "2k"],
      "optional": true
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "default": false,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "num_images",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "model": "xai/grok-imagine-image-quality/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "num_images": "num_images",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "enable_base64_output": "enable_base64_output"
      },
      "required_text": ["prompt"]
    }
  },
  "translations": {
