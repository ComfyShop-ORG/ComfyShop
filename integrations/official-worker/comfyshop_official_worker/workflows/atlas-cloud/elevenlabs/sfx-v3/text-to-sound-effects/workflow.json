{
  "format": "service",
  "workerKind": "official",
  "key": "elevenlabs-sfx-v3-text-to-sound-effects",
  "name": "ElevenLabs SFX v3 音效生成",
  "description": "根据文字描述生成动作音效、环境声和可循环音效。",
  "category": "audio",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "default": "Cinematic whoosh followed by a deep impact boom with a long reverb tail"
    },
    {
      "name": "duration",
      "kind": "integer",
      "optional": true,
      "minimum": "1",
      "maximum": "30",
      "step": "1",
      "default": 5
    },
    {
      "name": "format",
      "kind": "choice",
      "optional": true,
      "choices": ["mp3", "wav"],
      "default": "mp3"
    },
    {
      "name": "loop",
      "kind": "boolean",
      "optional": true,
      "default": false
    },
    {
      "name": "prompt_influence",
      "kind": "number",
      "optional": true,
      "minimum": "0",
      "maximum": "1",
      "default": 0.3
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "format",
      "section": "default"
    },
    {
      "fieldId": "loop",
      "section": "advanced"
    },
    {
      "fieldId": "prompt_influence",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "audio",
    "config": {
      "operation": "audio",
      "model": "elevenlabs/sfx-v3/text-to-sound-effects",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "output_format": "format",
        "loop": "loop",
        "prompt_influence": "prompt_influence"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 2000
      }
    }
  },
  "translations": {
