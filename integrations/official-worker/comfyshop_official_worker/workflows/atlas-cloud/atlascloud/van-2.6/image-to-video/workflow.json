{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-atlascloud-van-2-6-image-to-video",
  "name": "Atlas Cloud Van 2.6 图生视频",
  "description": "从一张起始图生成 1080p 视频，可编排单镜头或多镜头，并使用参考音频。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "1080p",
      "optional": false,
      "choices": ["1080p"]
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 5,
      "optional": true,
      "choices": [5, 10, 15]
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    },
    {
      "name": "negative_prompt",
      "optional": true,
      "kind": "string",
      "multiline": true,
      "default": ""
    },
    {
      "name": "soundtrack",
      "optional": true,
      "kind": "audio"
    },
    {
      "name": "soundtrack_source",
      "optional": true,
      "kind": "string",
      "default": ""
    },
    {
      "name": "enable_prompt_expansion",
      "optional": true,
      "kind": "boolean",
      "default": true
    },
    {
      "name": "shot_type",
      "kind": "choice",
      "optional": true,
      "default": "multi",
      "choices": ["multi", "single"]
    },
    {
      "name": "generate_audio",
      "kind": "boolean",
      "optional": true,
      "default": true
    },
    {
      "name": "first_frame",
      "kind": "image",
      "optional": true
    },
    {
      "name": "first_frame_source",
      "kind": "string",
      "optional": true,
      "default": ""
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "first_frame",
      "section": "default"
    },
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "shot_type",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    },
    {
      "fieldId": "negative_prompt",
      "section": "advanced"
    },
    {
      "fieldId": "soundtrack",
      "section": "advanced"
    },
    {
      "fieldId": "soundtrack_source",
      "section": "advanced"
    },
    {
      "fieldId": "enable_prompt_expansion",
      "section": "advanced"
    },
    {
      "fieldId": "generate_audio",
      "section": "advanced"
    },
    {
      "fieldId": "first_frame_source",
      "section": "advanced"
    },
    {
      "fieldId": "resolution",
      "section": "hidden"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "atlascloud/van-2.6/image-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "seed": "seed",
        "negative_prompt": "negative_prompt",
        "enable_prompt_expansion": "enable_prompt_expansion",
        "shot_type": "shot_type",
        "generate_audio": "generate_audio",
        "resolution": "resolution"
      },
      "required_text": ["prompt"],
      "omit_blank_parameters": ["negative_prompt"],
      "media": {
        "audio": {
          "kind": "audio",
          "fields": ["soundtrack"],
          "external_urls_only": true,
          "external_sources_field": "soundtrack_source"
        },
        "image": {
          "kind": "image",
          "fields": ["first_frame"],
          "external_sources_field": "first_frame_source",
          "min_items": 1,
          "external_urls_only": true
        }
      },
      "choice_constraints": {
        "enable_prompt_expansion": {
          "parameter": "shot_type",
          "values": {
            "multi": true
          }
        }
      }
    }
  },
