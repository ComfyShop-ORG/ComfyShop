      "parameterLayout": {
        "source_audio": {
          "help": "오디오 트랙이 포함된 오디오나 영상을 업로드하세요. MP3, WAV, M4A, FLAC, OGG, Opus, AAC, MP4, MKV 및 원시 오디오를 지원합니다."
        },
        "normalize_numbers": {
          "help": "말로 표현한 숫자, 통화, 단위를 일반적인 표기로 변환합니다. 켜면 언어를 선택해야 합니다."
        },
        "language": {
          "help": "비우면 언어가 자동으로 인식됩니다. 정규화를 켜면 선택된 언어의 표기 규칙을 적용합니다."
        },
        "key_terms": {
          "help": "한 줄에 용어 하나를 입력하세요. 최대 100개까지 가능하며 각 용어는 최대 50자입니다. 빈 줄은 건너뜁니다."
        },
        "diarize": {
          "help": "전사한 단어에 화자를 표시합니다. 기본값은 꺼짐입니다."
        },
        "keep_fillers": {
          "help": "켜면 머뭇거림과 군더더기 표현을 남깁니다. 기본값은 제거입니다."
        },
        "audio_format": {
          "help": "컨테이너 파일에는 auto를 사용하세요. 원시 PCM, G.711 μ-law, G.711 A-law의 확장자는 각각 .raw 또는 .pcm, .mulaw 또는 .ulaw, .alaw입니다."
        },
        "sample_rate": {
          "help": "원시 오디오에 필수입니다. 원본과 같은 샘플링 주파수를 Hz 단위로 선택하세요."
        },
        "multichannel": {
          "help": "채널을 최대 8개까지 개별 전사합니다. 기본값은 꺼짐입니다."
        },
        "channels": {
          "help": "원시 오디오를 채널별로 전사하려면 2~8을 선택하세요. 컨테이너 파일은 채널을 자동으로 인식합니다."
        },
        "sync_mode": {
          "help": "제출 응답에 결과가 포함되면 바로 읽습니다. 기본값은 꺼짐입니다."
        }
      }
    }
  }
}
