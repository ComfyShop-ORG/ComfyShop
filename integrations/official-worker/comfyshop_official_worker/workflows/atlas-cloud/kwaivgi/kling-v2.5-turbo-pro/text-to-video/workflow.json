{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-kwaivgi-kling-v2-5-turbo-pro-text-to-video",
  "name": "可灵 2.5 Turbo 专业版文生视频",
  "description": "将文字描述生成 5 或 10 秒的视频，可选择横屏、竖屏或方形画面。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "optional": false,
      "maxLength": 2500
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "optional": true,
      "choices": ["1:1", "9:16", "16:9"]
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 5,
      "optional": true,
      "choices": [5, 10]
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "kwaivgi/kling-v2.5-turbo-pro/text-to-video",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "aspect_ratio": "aspect_ratio"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 2500
      }
    }
  },
