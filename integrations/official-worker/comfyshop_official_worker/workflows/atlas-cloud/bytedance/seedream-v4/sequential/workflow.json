{
  "format": "service",
  "workerKind": "official",
  "key": "seedream-v4-sequential",
  "name": "Seedream v4 连续生图",
  "description": "从提示词生成一组相关图片，支持自定义宽高，最多 14 张。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true
    },
    {
      "name": "size",
      "kind": "string",
      "default": "2048*2048",
      "optional": true,
      "maxLength": 9
    },
    {
      "name": "max_images",
      "kind": "integer",
      "optional": true,
      "default": 1,
      "minimum": "1",
      "maximum": "14"
    },
    {
      "name": "enable_base64_output",
      "kind": "boolean",
      "optional": true,
      "default": false
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "max_images",
      "section": "default"
    },
    {
      "fieldId": "enable_base64_output",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "bytedance/seedream-v4/sequential",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "enable_base64_output": "enable_base64_output",
        "max_images": "max_images"
      },
      "required_text": ["prompt"],
      "image_size_limits": {
        "min_side": 1024,
        "max_side": 4096,
        "allow_auto": false
      },
      "omit_blank_parameters": ["size"]
    }
  },
  "translations": {
    "zh": {
      "name": "Seedream v4 连续生图",
      "description": "从提示词生成一组相关图片，支持自定义宽高，最多 14 张。",
      "fields": {
        "prompt": {
          "label": "提示词"
        },
        "size": {
          "label": "图片尺寸"
        },
        "max_images": {
          "label": "最多生成张数"
        },
        "enable_base64_output": {
          "label": "Base64 成品"
        }
      },
      "parameterLayout": {
        "prompt": {
          "help": "描述画面中的主体、环境与光线。"
        },
        "size": {
          "help": "输入宽*高，单位像素。宽、高均为 1024 至 4096，例如 2048*1536。"
        },
        "max_images": {
          "help": "可填 1 至 14。可在提示词里描述每张图片的内容。"
        },
        "enable_base64_output": {
          "help": "要求 Atlas 以 Base64 返回图片。工作机解码后保存图片原件。"
        }
