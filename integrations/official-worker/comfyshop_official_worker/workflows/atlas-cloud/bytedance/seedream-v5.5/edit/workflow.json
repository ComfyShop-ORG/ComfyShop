      "parameterLayout": {
        "prompt": {
          "help": "Specify the edit. Use coordinates or boxes and arrows marked on the reference to target an area. Atlas recommends up to 300 Chinese characters or 600 English words."
        },
        "reference_1": {
          "help": "Each upload is limited to 30 MB and 36 million pixels. Both sides must exceed 14 pixels and the aspect ratio must be within 1:16 to 16:1."
        },
