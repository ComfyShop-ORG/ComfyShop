          "help": "Optionally describe motion or setting in up to 2,000 characters."
        },
        "expand_prompt": {
          "help": "Let the model optimize the prompt before generation."
        },
        "first_frame_source": {
          "help": "Enter a public image URL or Base64 data URI as an alternative to uploading."
