{
  "format": "service",
  "workerKind": "official",
  "key": "byteplus-video-upscaler",
  "name": "BytePlus 视频超分",
  "description": "将已有视频增强到最高 8K，可按场景处理，调整码率、帧率或专业引擎的色深。",
  "category": "video_tool",
  "fields": [
    {
      "name": "video",
      "kind": "video"
    },
    {
      "name": "tool_version",
      "kind": "choice",
      "optional": true,
      "default": "standard",
      "choices": ["standard", "professional"]
    },
    {
      "name": "scene",
      "kind": "choice",
      "optional": true,
      "default": "common",
      "choices": ["common", "ugc", "short_series", "aigc", "old_film"]
    },
    {
      "name": "resolution",
      "kind": "choice",
      "optional": true,
      "default": "1080p",
      "choices": ["240p", "360p", "480p", "540p", "720p", "1080p", "2k", "4k", "8k", ""]
    },
    {
      "name": "resolution_limit",
      "kind": "integer",
      "optional": true,
      "minimum": "128",
      "maximum": "4320"
    },
    {
      "name": "bitrate_level",
      "kind": "choice",
      "optional": true,
      "default": "medium",
      "choices": ["low", "medium", "high"]
    },
    {
      "name": "fps",
      "kind": "integer",
      "optional": true,
      "minimum": "15",
      "maximum": "120"
    },
    {
      "name": "bit_depth",
      "kind": "choice",
      "optional": true,
      "default": 8,
      "choices": [8, 10, 12]
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "video",
      "section": "default"
    },
    {
      "fieldId": "tool_version",
      "section": "default"
    },
    {
      "fieldId": "scene",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "resolution_limit",
      "section": "advanced"
    },
    {
      "fieldId": "bitrate_level",
      "section": "advanced"
    },
    {
      "fieldId": "fps",
      "section": "advanced"
    },
    {
      "fieldId": "bit_depth",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "operation": "video",
      "model": "byteplus/video/upscaler",
      "prediction_endpoint": "result",
      "parameters": {
        "tool_version": "tool_version",
        "scene": "scene",
        "resolution": "resolution",
        "resolution_limit": "resolution_limit",
        "bitrate_level": "bitrate_level",
        "fps": "fps",
        "bit_depth": "bit_depth"
      },
      "media": {
        "video_url": {
          "kind": "video",
          "fields": ["video"],
          "min_items": 1
        }
      },
      "omit_blank_parameters": ["resolution"],
      "enabled_by": {
        "scene": {
          "parameter": "tool_version",
          "equals": "standard"
        },
        "bit_depth": {
          "parameter": "tool_version",
          "equals": "professional"
        }
      },
      "mutually_exclusive": [["resolution", "resolution_limit"]]
    }
  },
  "translations": {
