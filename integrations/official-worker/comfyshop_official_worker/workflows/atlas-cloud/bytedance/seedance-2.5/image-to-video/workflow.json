      "parameterLayout": {
        "first_frame": {
          "help": "从这张图片开始生成。首尾帧支持 JPEG、PNG、WebP、BMP、TIFF 和 GIF。"
        },
        "last_frame": {
          "help": "指定最终画面，可留空。"
        },
        "prompt": {
          "help": "描述起始图中的动作、镜头和画面变化，可留空。"
        },
        "duration_seconds": {
          "help": "选择 4 至 30 秒，选 -1 由模型决定时长。"
        },
        "aspect_ratio": {
          "help": "沿用起始图的宽高比。"
        },
        "resolution": {
          "help": "选择原生分辨率、SR 超分辨率或 ESR 增强。开启草稿时生成 480p。"
        },
        "generate_audio": {
          "help": "生成与画面同步的语音、音效或音乐。"
        },
        "add_watermark": {
          "help": "为输出视频添加水印。"
        },
        "include_last_frame": {
          "help": "将输出视频的最后一帧另存为图片。"
        },
        "first_frame_source": {
          "help": "填写一个公开图片 URL、Base64 或 asset:// 素材库引用，与上传二选一。"
        },
        "last_frame_source": {
          "help": "填写一个公开图片 URL、Base64 或 asset:// 素材库引用，与上传二选一。"
        },
        "video_format": {
          "help": "选择 MP4 或 MOV。MOV 使用 YUV 4:4:4 以保留色彩细节。"
        },
        "draft": {
          "help": "生成 480p 预览和草稿 ID。可在七天内用草稿 ID 渲染正式版。"
        }
      }
    },
