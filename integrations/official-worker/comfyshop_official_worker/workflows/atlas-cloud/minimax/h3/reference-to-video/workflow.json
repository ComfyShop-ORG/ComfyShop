  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "operation": "video",
      "model": "minimax/h3/reference-to-video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration_seconds",
        "resolution": "resolution",
        "ratio": "aspect_ratio",
        "prompt_expansion": "expand_prompt"
      },
      "required_text": ["prompt"],
      "media": {
        "refers": {
          "groups": [
            {
              "kind": "image",
              "fields": [
                "image_1",
                "image_2",
                "image_3",
                "image_4",
                "image_5",
                "image_6",
                "image_7",
                "image_8",
                "image_9"
              ],
              "content_types": [
                "image/png",
                "image/jpeg",
                "image/webp",
                "image/heic",
                "image/heif"
              ],
              "external_sources_field": "image_sources",
              "max_bytes": 30000000,
              "image_bounds": {
                "min_side": 256,
                "max_side": 5760,
                "aspect_ratio_range": [0.4, 2.5]
              }
            },
            {
              "kind": "video",
              "fields": ["video_1", "video_2", "video_3"],
              "content_types": ["video/mp4", "video/quicktime"],
              "external_sources_field": "video_sources",
              "max_bytes": 50000000,
              "image_bounds": {
                "min_side": 256,
                "max_side": 5760,
                "aspect_ratio_range": [0.4, 2.5]
              },
              "min_duration_ms": 2000,
              "max_duration_ms": 15000,
              "max_total_duration_ms": 15000
            },
            {
              "kind": "audio",
              "fields": ["audio_1", "audio_2", "audio_3"],
              "content_types": [
                "audio/wav",
                "audio/wave",
                "audio/x-wav",
                "audio/mpeg",
                "audio/mp3"
              ],
              "external_sources_field": "audio_sources",
              "max_bytes": 15000000,
              "min_duration_ms": 2000,
              "max_duration_ms": 15000,
              "max_total_duration_ms": 15000
            }
          ],
          "requires_any_kind": ["image", "video"],
          "max_items": 12,
          "external_https_only": true
        }
      }
    }
  },
