{
  "format": "service",
  "workerKind": "official",
  "key": "gpt-image-26-flare-text",
  "name": "GPT Image 2.6 Flare 文生图",
  "description": "快速从提示词生成静态图、GIF 动画或可编辑 SVG 矢量文件。",
  "category": "image",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "multiline": true,
      "maxLength": 32000,
      "default": "A neon-lit ramen stall on a rainy Tokyo street, cinematic wide shot."
    },
    {
      "name": "quality",
      "kind": "choice",
      "optional": true,
      "default": "medium",
      "choices": ["auto", "low", "medium", "high", "xhigh", "max"]
    },
    {
      "name": "complexity",
      "kind": "choice",
      "optional": true,
      "default": "high",
      "choices": ["low", "medium", "high"]
    },
    {
      "name": "size",
      "kind": "choice",
      "optional": true,
      "default": "",
      "choices": [
        "",
        "auto",
        "1024x1024",
        "1024x768",
        "768x1024",
        "1024x1280",
        "1024x1536",
        "1536x1024",
        "2048x2048",
        "2048x1152",
        "1152x2048",
        "2560x1088",
        "1088x2560",
        "2880x2160",
        "2160x2880",
        "3840x2160",
        "2160x3840"
      ]
    },
    {
      "name": "custom_size",
      "kind": "string",
      "optional": true,
      "default": "",
      "maxLength": 9
    },
    {
      "name": "background",
      "kind": "choice",
      "optional": true,
      "default": "auto",
      "choices": ["auto", "opaque", "transparent"]
    },
    {
      "name": "output_format",
      "kind": "choice",
      "optional": true,
      "default": "png",
      "choices": ["png", "jpeg", "webp", "gif", "svg"]
    },
    {
      "name": "frame_count",
      "kind": "integer",
      "optional": true,
      "default": 9,
      "minimum": "2",
      "maximum": "64"
    },
    {
      "name": "frame_duration_ms",
      "kind": "integer",
      "optional": true,
      "default": 200,
      "minimum": "20",
      "maximum": "2000"
    },
    {
      "name": "svg_model",
      "kind": "choice",
      "optional": true,
      "default": "gpt-5.4-mini",
      "choices": [
        "gpt-6-astra",
        "gpt-6-luna",
        "gpt-6.1-terra",
        "gpt-6-sol",
        "gpt-5.5",
        "gpt-5.4",
        "gpt-5.4-mini"
      ]
    },
    {
      "name": "moderation",
      "kind": "choice",
      "optional": true,
      "default": "auto",
      "choices": ["auto", "low"]
    },
    {
      "name": "n",
      "kind": "integer",
      "optional": true,
      "default": 1,
      "minimum": "1",
      "maximum": "10"
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "quality",
      "section": "default"
    },
    {
      "fieldId": "complexity",
      "section": "advanced"
    },
    {
      "fieldId": "size",
      "section": "default"
    },
    {
      "fieldId": "custom_size",
      "section": "advanced"
    },
    {
      "fieldId": "background",
      "section": "advanced"
    },
    {
      "fieldId": "output_format",
      "section": "default"
    },
    {
      "fieldId": "frame_count",
      "section": "advanced"
    },
    {
      "fieldId": "frame_duration_ms",
      "section": "advanced"
    },
    {
      "fieldId": "svg_model",
      "section": "advanced"
    },
    {
      "fieldId": "moderation",
      "section": "advanced"
    },
    {
      "fieldId": "n",
      "section": "default"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "additionalOutputKinds": ["text"],
    "config": {
      "model": "openai/gpt-image-2.6-flare/text-to-image",
      "operation": "image",
      "parameters": {
        "prompt": "prompt",
        "quality": "quality",
        "complexity": "complexity",
        "size": "size",
        "background": "background",
        "output_format": "output_format",
        "frame_count": "frame_count",
        "frame_duration_ms": "frame_duration_ms",
        "svg_model": "svg_model",
        "moderation": "moderation",
        "n": "n"
      },
      "required_text": ["prompt"],
      "text_max_lengths": {
        "prompt": 32000
      },
      "parameter_overrides": {
        "size": "custom_size"
      },
      "omit_blank_parameters": ["size"],
      "image_size_limits": {
        "min_side": 256,
        "max_side": 3840,
        "min_pixels": 65536,
        "max_pixels": 8294400,
        "max_aspect_ratio": 3,
        "separator": "x",
        "side_multiple": 16
      },
      "choice_constraints": {
        "output_format": {
          "parameter": "background",
          "values": {
            "transparent": ["png", "webp", "svg"]
          }
        }
      },
      "choice_bounds": {
        "n": {
          "parameter": "output_format",
          "ranges": {
            "svg": [1, 1]
          }
        }
      },
      "enabled_by": {
        "frame_count": {
          "parameter": "output_format",
          "equals": ["gif"]
        },
        "frame_duration_ms": {
          "parameter": "output_format",
          "equals": ["gif"]
        },
        "svg_model": {
          "parameter": "output_format",
          "equals": ["svg"]
        }
      }
    }
  },
