# 团队版 Compose 示例。把副本和实际密钥放在仓库外，用 --env-file 指定。
# 仅在创建 PostgreSQL 数据卷时用于初始化。建议用 openssl rand -hex 24 生成。
COMFYSHOP_POSTGRES_PASSWORD=

# 团队版默认绑定宿主机所有 IPv4 网卡。仅供宿主机访问时设为 127.0.0.1。
# 容器端口固定为 8688。
COMFYSHOP_TEAM_BIND=0.0.0.0
COMFYSHOP_TEAM_PORT=9688

# 输入素材的空间默认配额，默认 10 GiB。团队可按固定 ID 指定上限，单位为字节。
# COMFYSHOP_ASSET_QUOTA_BYTES=10737418240
# COMFYSHOP_TEAM_ASSET_QUOTA_BYTES='{"11111111-1111-4111-8111-111111111111":21474836480}'

# 运行时语言回退，默认为 zh。修改后重新创建 app 容器。
# COMFYSHOP_DEFAULT_LANGUAGE=zh
# 页头语言菜单按以下顺序展示简体中文和英文。省略时显示全部语言。
# COMFYSHOP_MENU_LANGUAGES=zh,en

# 三类工作机的 Loguru 日志级别，默认 INFO。
COMFYSHOP_WORKER_LOG_LEVEL=INFO

# 可选的官方工作机使用 official profile，取值见 .env.example。
# COMFYSHOP_OFFICIAL_OWNER=ComfyShop
# COMFYSHOP_WORKER_SERVICE_TOKENS__OFFICIAL=
# Compose 的官方工作机内网报价地址，设为空关闭入口。
# COMFYSHOP_OFFICIAL_QUOTE_URL=http://official-worker:8690/quote

# 启用 comfyui profile 时使用团队版独立的私有目录，存放 worker.json 和运行状态。
# COMFYSHOP_COMFYUI_WORKER_DIR=/absolute/private/comfyshop-team/comfyui-worker
# COMFYSHOP_COMFYUI_WORKER_UID=10001
# COMFYSHOP_COMFYUI_WORKER_GID=10001

# 个人和团队的 RunningHub 连接。API 保存 Fernet 密钥，独立工作机和 API 共用另一个随机服务令牌。
COMFYSHOP_CONNECTION_ENCRYPTION_KEY=
COMFYSHOP_WORKER_SERVICE_TOKENS__RUNNINGHUB=

# 保留 local 时，原文件和缓存均写入应用数据卷。
COMFYSHOP_STORAGE_BACKEND=local

# 应用卷缓存与 S3 派生前缀各自使用此容量和有效期，默认 512 MiB、生成后 7 天。
# COMFYSHOP_DERIVATIVE_CACHE_MAX_BYTES=536870912
# COMFYSHOP_DERIVATIVE_CACHE_TTL_SECONDS=604800

# 使用本地 RustFS 时改为 s3，启用 Compose 的 rustfs profile，并取消以下配置的注释。
# 使用外部 S3 时同样选择 s3，填写服务商的存储桶和区域，直接启动应用。
# AWS S3 可省略 endpoint，访问密钥也可一并省略以使用 SDK 凭据链。
# COMFYSHOP_S3_ENDPOINT_URL=http://rustfs:9000
# COMFYSHOP_S3_BUCKET=comfyshop-media
# COMFYSHOP_S3_REGION=us-east-1
# COMFYSHOP_S3_ADDRESSING_STYLE=path
# COMFYSHOP_S3_ACCESS_KEY_ID=
# COMFYSHOP_S3_SECRET_ACCESS_KEY=

# 启用 HTTPS 后填写外部地址并设置 Cookie 为 secure。配置 SMTP 时平台地址必填。
# COMFYSHOP_PUBLIC_URL=https://comfyshop.example.com
# COMFYSHOP_COOKIE_SECURE=true
# COMFYSHOP_ALLOWED_HOSTS='["comfyshop.example.com","127.0.0.1"]'
# COMFYSHOP_SMTP_HOST=smtp.example.com
# COMFYSHOP_SMTP_PORT=587
# COMFYSHOP_SMTP_USERNAME=
# COMFYSHOP_SMTP_PASSWORD=
# COMFYSHOP_SMTP_FROM='ComfyShop <no-reply@example.com>'
# COMFYSHOP_SMTP_SECURITY=starttls

# 工作流、资产库和封面使用同一单文件素材上限，默认 256 MiB。
# COMFYSHOP_MAX_ASSET_BYTES=268435456
# 平台接受的单个成品上限，默认 1 GiB。
# COMFYSHOP_MAX_ARTIFACT_BYTES=1073741824
