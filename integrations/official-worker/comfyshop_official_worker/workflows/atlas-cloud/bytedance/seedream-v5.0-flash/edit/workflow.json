      "fieldId": "reference_sources",
      "section": "advanced"
    },
    {
      "fieldId": "background",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "image",
    "config": {
      "operation": "image",
      "model": "bytedance/seedream-v5.0-flash/edit",
      "parameters": {
        "prompt": "prompt",
        "size": "size",
        "output_format": "output_format",
        "enable_base64_output": "enable_base64_output",
        "background": "background"
      },
      "required_text": ["prompt"],
      "media": {
        "images": {
          "kind": "image",
          "fields": [
            "reference_1",
            "reference_2",
            "reference_3",
            "reference_4",
            "reference_5",
            "reference_6",
            "reference_7",
            "reference_8",
            "reference_9",
            "reference_10"
          ],
          "array": true,
          "min_items": 1,
          "content_types": [
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/bmp",
            "image/tiff",
            "image/gif",
            "image/heic",
            "image/heif"
          ],
          "external_sources_field": "reference_sources",
          "alpha_for_background_parameter": "background"
        }
      },
      "choice_constraints": {
        "output_format": {
          "parameter": "background",
          "values": {
            "transparent": "png"
          }
        }
      },
      "required_when": {
        "output_format": {
          "background": ["transparent"]
        }
      }
    }
  },
