        "guidance_scale": {
          "help": "填写引导强度，默认 1。"
        },
        "output_format": {
          "help": "选择 PNG、JPEG 或 WebP，默认 PNG。"
        },
        "enable_sync_mode": {
          "help": "等待成品上传后由提交请求直接返回结果。"
        },
        "enable_base64_output": {
          "help": "以 Base64 返回图片，工作机解码后保存。"
        }
