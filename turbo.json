{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "@comfyshop/tokens#build": { "cache": false, "outputs": ["dist/**"] },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/api/src/comfyshop_api/core/languages.json"],
      "outputs": ["dist/**"]
    },
    "dev": { "cache": false, "persistent": true }
  }
}
