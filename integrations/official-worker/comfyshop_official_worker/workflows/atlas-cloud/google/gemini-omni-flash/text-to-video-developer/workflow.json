{
  "format": "service",
  "workerKind": "official",
  "key": "atlas-google-gemini-omni-flash-text-to-video-developer",
  "name": "Gemini Omni Flash Developer 文生视频",
  "description": "从文字生成带音频的视频，可选时长、宽高比和最高 4K 分辨率。",
  "category": "video",
  "fields": [
    {
      "name": "prompt",
      "kind": "string",
      "default": "",
      "multiline": true,
      "maxLength": 20000
    },
    {
      "name": "duration",
      "kind": "choice",
      "default": 8,
      "optional": true,
      "choices": [4, 6, 8, 10]
    },
    {
      "name": "aspect_ratio",
      "kind": "choice",
      "default": "16:9",
      "optional": true,
      "choices": ["16:9", "9:16"]
    },
    {
      "name": "resolution",
      "kind": "choice",
      "default": "720p",
      "optional": true,
      "choices": ["720p", "1080p", "4k"]
    },
    {
      "name": "seed",
      "kind": "integer",
      "default": -1,
      "optional": true
    }
  ],
  "parameterLayout": [
    {
      "fieldId": "prompt",
      "section": "default"
    },
    {
      "fieldId": "duration",
      "section": "default"
    },
    {
      "fieldId": "aspect_ratio",
      "section": "default"
    },
    {
      "fieldId": "resolution",
      "section": "default"
    },
    {
      "fieldId": "seed",
      "section": "advanced"
    }
  ],
  "execution": {
    "adapter": "atlas-cloud",
    "outputKind": "video",
    "config": {
      "model": "google/gemini-omni-flash/text-to-video-developer",
      "operation": "video",
      "parameters": {
        "prompt": "prompt",
        "duration": "duration",
        "aspect_ratio": "aspect_ratio",
        "resolution": "resolution",
        "seed": "seed"
      },
      "required_text": ["prompt"]
    }
  },
